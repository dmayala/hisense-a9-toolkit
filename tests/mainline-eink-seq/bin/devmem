#!/bin/sh
# devmem ADDR [32 [VALUE]] on the fake TLMM files (reads are kept cheap: the
# sequencer's sampler calls this every few ms)
a=$(printf '0x%08x' $(( $1 )))
f=$SIM_ROOT/tlmm/$a
[ -f $f ] || { echo "devmem: bad address $a" >&2; exit 1; }
if [ -z "$3" ]; then
	# devmem-flaky: some PG reads fail while the video runs
	[ -e $SIM_ROOT/sim/flaky ] && [ -e $SIM_ROOT/sim/video ] && [ $a = 0x00552004 ] && [ $((RANDOM % 3)) = 0 ] && exit 1
	read -r v < $f; printf '0x%08X\n' $v; exit 0
fi
. "$SIM_LIB"
v=$(( $3 )); c=$(cat $R/tlmm/$(printf '0x%08x' $(( $1 - 4 ))) 2>/dev/null || echo 0)
# an output pad follows its output bit
[ $(( (c >> 9) & 1 )) = 1 ] && v=$(( (v & ~1) | ((v >> 1) & 1) ))
echo $v > $f; echo "$a $3" >> $S/devmem.writes
[ "$(cat $S/stuck)" = 1 ] && echo 0 > $S/stuck   # the force write does reach the pad
regen_gpio
