# MPSS is managed by the integrated Wi-Fi session controller.
# Registration alone does not open LOC; Android start/stop controls the client.
service vendor.gnss-a9 /vendor/bin/hw/android.hardware.gnss-service.a9
    class hal
    user root
    group root
    capabilities KILL SETUID SETGID SETPCAP
    seclabel u:r:hal_gnss_default:s0
