; A9 properties are non-secret readiness/configuration values read by the
; installed HALs/framework. Writers remain the named startup/helper domains.
(typeattribute a9ml_prop_reader)
(typeattributeset a9ml_prop_reader (hal_radio_default hal_usb_gadget_default hal_health_default hal_thermal_default hal_bluetooth_default hal_gnss_default hal_vibrator_default hal_graphics_composer_default hal_graphics_allocator_default system_server_202504 surfaceflinger_202504 zygote_202504 shell_202504 mediaswcodec_202504))
(allow a9ml_prop_reader a9ml_prop (file (read open getattr map)))
; Observed ioctl requests from f (not all ioctl command numbers).
(allowx a9_wifi_radio a9_wifi_ram_file (ioctl file (0x5401 0x5413)))
(allowx a9_wifi_radio self (ioctl unix_dgram_socket (0x8933)))
(allowx hal_graphics_allocator_default graphics_device_202504 (ioctl chr_file (0x642d 0x64b2)))
(allowx hal_graphics_composer_default graphics_device_202504 (ioctl chr_file (0x642e 0x643a 0x64af 0x64bc)))
(allowx mediaswcodec_202504 graphics_device_202504 (ioctl chr_file (0x6400)))
(allowx platform_app_202504 graphics_device_202504 (ioctl chr_file (0x6400 0x642e 0x64b4)))
(allowx priv_app_202504 graphics_device_202504 (ioctl chr_file (0x6400 0x642e 0x64b4)))
(allowx system_server_202504 graphics_device_202504 (ioctl chr_file (0x6400 0x642e 0x64b4)))
; Current E Ink setup still adjusts attributes' DAC owner and enumerates comm
; files before selecting kernel workers. This grants metadata reads, not
; cross-domain process ptrace or scheduling of application threads.
(allow a9ml_eink a9ml_sysfs_eink (file (setattr)))
(allow a9ml_eink domain (dir (search getattr)))
(allow a9ml_eink domain (file (read open getattr)))
(allow a9ml_script_domain logdr_socket_202504 (sock_file (write)))
; Existing development HTTP/DNS checks and USB network console retain the
; platform's ordinary network permissions; firmware/sensor helpers do not.
(typeattributeset netdomain (a9ml_rootsh a9ml_usb))
; f logged toolbox entrypoint denials for the old housekeeping/root domain.
; Those init exec_background commands now select a9ml_rootsh explicitly.
(allow a9ml_rootsh toolbox_exec_202504 (file (entrypoint)))
(allow a9ml_rootsh system_file_202504 (file (entrypoint)))
