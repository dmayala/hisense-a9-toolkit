# A9 thermal (opt-in: A9_THERMAL=1 kernel/build.sh, together with A9_ANDROID=1).
# 2026-10-15, sensors worktree, runs/sensors.md section 3. NOT booted.
#
# A critical trip (110 C on every CPU zone) does NOTHING in the Android
# kernel today (MEASURED from linux-7.2.10 source + build-7.2.10-android/.config):
# thermal_zone_device_critical -> __hw_protection_trigger(ms_until_forced =
# CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS = 0) -> hw_failure_emergency_schedule
# returns at once for delay <= 0 -> orderly_poweroff(true) -> run_cmd ->
# call_usermodehelper_exec returns 0 because CONFIG_STATIC_USERMODEHELPER_PATH=""
# (umh.c: "allows us to ... disable all call_usermodehelper() calls"), so the
# "forcing the issue" kernel_power_off() branch never runs. Only the
# "HARDWARE PROTECTION shutdown" line is printed. (The A6L found the same on
# its r5 kernel, docs/android-thermal-cooling-20260929.md.)
# With a positive delay the backup work forces kernel_power_off() after it.
# 100 ms: Android's own thermal shutdown (thermal HAL SHUTDOWN thresholds
# below 110 C) is the clean path; this is the last resort.
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=100
# Review 24 (2026-10-16): the power-off must not follow ONE bad sample. Upstream
# tsens accepts two matching UNVALIDATED samples (VALID bit clear), e.g.
# 0x44c = 110 C, and the core acts on any successful sample. These two need
# kernel/patches/0043-0044 (applied to every build, default off; build.sh refuses otherwise):
# critical crossings need 3 consecutive samples >= the trip (250 ms apart), and
# tsens returns -EAGAIN instead of an unvalidated sample.
CONFIG_THERMAL_CRITICAL_CONFIRM_SAMPLES=3
CONFIG_QCOM_TSENS_REQUIRE_VALID=y
# the quiet_therm skin zone (a9-thermal.dtsi): polled IIO thermal sensor,
# built in because the vendor module closure only carries E Ink modules
CONFIG_GENERIC_ADC_THERMAL=y
