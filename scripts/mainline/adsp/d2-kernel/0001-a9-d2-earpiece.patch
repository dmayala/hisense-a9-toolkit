+static int wcd937x_d2_swr_put(struct snd_kcontrol *k, struct snd_ctl_elem_value *v)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(k);
+	struct wcd937x_priv *d = snd_soc_component_get_drvdata(c);
+	if (atomic_read(&d->d2_stopped) || atomic_read(&d->d2_fault))
+		return -ESHUTDOWN;
+	return wcd937x_set_swr_port(k, v);
+}
+
+static int wcd937x_d2_gain_get(struct snd_kcontrol *k, struct snd_ctl_elem_value *v)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(k);
+	struct wcd937x_priv *d = snd_soc_component_get_drvdata(c);
+	unsigned int val;
+	int ret = wcd937x_d2_read(d, WCD937X_ANA_EAR_COMPANDER_CTL, &val);
+	if (ret)
+		return ret;
+	if ((val & 0x7c) != (16 << 2)) {
+		wcd937x_d2_contain(d, 7);
+		return -EIO;
+	}
+	v->value.integer.value[0] = 16;
+	return 0;
+}
+
+static int wcd937x_d2_gain_put(struct snd_kcontrol *k, struct snd_ctl_elem_value *v)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(k);
+	int ret;
+	if (v->value.integer.value[0] != 16)
+		return -EPERM;
+	ret = wcd937x_d2_write_verify(c, WCD937X_ANA_EAR_COMPANDER_CTL, 0x7c, 16 << 2);
+	return ret ? ret : 1;
+}
+
+static int wcd937x_d2_mode_put(struct snd_kcontrol *k, struct snd_ctl_elem_value *v)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(k);
+	struct wcd937x_priv *d = snd_soc_component_get_drvdata(c);
+	if (atomic_read(&d->d2_stopped) || atomic_read(&d->d2_fault))
+		return -ESHUTDOWN;
+	if (v->value.enumerated.item[0] != CLS_AB)
+		return -EPERM; /* matches stock mixer_paths_qrd default */
+	return wcd937x_rx_hph_mode_put(k, v);
+}
+
+static int wcd937x_d2_mux_get(struct snd_kcontrol *k, struct snd_ctl_elem_value *v)
+{
+	struct snd_soc_component *c = snd_soc_dapm_kcontrol_to_component(k);
+	struct wcd937x_priv *d = snd_soc_component_get_drvdata(c);
+	unsigned int val;
+	int ret = wcd937x_d2_read(d, WCD937X_DIGITAL_CDC_EAR_PATH_CTL, &val);
+	if (ret)
+		return ret;
+	if (val & BIT(0)) {
+		wcd937x_d2_contain(d, 7);
+		return -EIO;
+	}
+	v->value.enumerated.item[0] = 0;
+	return 0;
+}
+
+static int wcd937x_d2_mux_put(struct snd_kcontrol *k, struct snd_ctl_elem_value *v)
+{
+	struct snd_soc_component *c = snd_soc_dapm_kcontrol_to_component(k);
+	struct wcd937x_priv *d = snd_soc_component_get_drvdata(c);
+	unsigned int pa;
+	int ret;
+	if (v->value.enumerated.item[0] != 0)
+		return -EPERM; /* RX1 only, no active rerouting. */
+	ret = wcd937x_d2_read(d, WCD937X_ANA_EAR, &pa);
+	if (ret)
+		return ret;
+	if (pa & BIT(7)) {
+		wcd937x_d2_contain(d, 7);
+		return -EBUSY;
+	}
+	/* Write/read physical RX1 before updating the NOPM DAPM graph. */
+	ret = wcd937x_d2_write_verify(c, WCD937X_DIGITAL_CDC_EAR_PATH_CTL, BIT(0), 0);
+	if (ret)
+		return ret;
+	ret = snd_soc_dapm_put_enum_double(k, v);
+	if (ret < 0)
+		wcd937x_d2_contain(d, 7);
+	return atomic_read(&d->d2_stopped) ? -ESHUTDOWN : ret;
+}
+
+static int wcd937x_d2_switch_put(struct snd_kcontrol *k, struct snd_ctl_elem_value *v)
+{
+	struct snd_soc_component *c = snd_soc_dapm_kcontrol_to_component(k);
+	struct wcd937x_priv *d = snd_soc_component_get_drvdata(c);
+	int ret;
+	if (atomic_read(&d->d2_stopped))
+		return -ESHUTDOWN;
+	if (v->value.integer.value[0] != 0 && v->value.integer.value[0] != 1)
+		return -EINVAL;
+	/* NOPM switch updates connectivity only; PA callback owns all PA I/O. */
+	ret = snd_soc_dapm_put_volsw(k, v);
+	if (ret < 0)
+		wcd937x_d2_contain(d, 7);
+	return atomic_read(&d->d2_stopped) ? -ESHUTDOWN : ret;
+}
