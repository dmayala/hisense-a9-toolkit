@@ -0,0 +1,219 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Hisense A9 D2 containment; included by wcd937x.c only. No rearm API. */
+static void wcd937x_d2_contain(struct wcd937x_priv *d, int fault)
+{
+	if (fault)
+		atomic_cmpxchg(&d->d2_fault, 0, fault);
+	atomic_set(&d->d2_stopped, 1);
+	/* Assert TLMM92 first: no dependence on a functioning SoundWire bus. */
+	gpiod_set_value_cansleep(d->reset_gpio, 1);
+	d->d2_bound = false;
+}
+
+static void wcd937x_d2_release(void *arg)
+{
+	struct wcd937x_priv *d = arg;
+	wcd937x_d2_contain(d, 0);
+	cancel_delayed_work_sync(&d->d2_deadline);
+}
+
+static int wcd937x_d2_check_route(struct wcd937x_priv *d)
+{
+	unsigned int val;
+	int ret;
+	ret = regmap_read_bypassed(d->regmap, WCD937X_ANA_EAR_COMPANDER_CTL, &val);
+	if (ret || (val & 0x7c) != (16 << 2))
+		return ret ? ret : -EIO;
+	ret = regmap_read_bypassed(d->regmap, WCD937X_DIGITAL_CDC_EAR_PATH_CTL, &val);
+	if (ret || (val & BIT(0)))
+		return ret ? ret : -EIO;
+	ret = regmap_read_bypassed(d->regmap, WCD937X_ANA_HPH, &val);
+	if (ret || (val & 0xc0))
+		return ret ? ret : -EIO;
+	ret = regmap_read_bypassed(d->regmap, WCD937X_AUX_AUXPA, &val);
+	return ret ? ret : ((val & BIT(7)) ? -EIO : 0);
+}
+
+static int wcd937x_update_bits(struct snd_soc_component *c, unsigned int reg,
+			       unsigned int mask, unsigned int val)
+{
+	struct wcd937x_priv *d = snd_soc_component_get_drvdata(c);
+	int ret;
+	if (d->a9_d2 && atomic_read(&d->d2_stopped))
+		return -ESHUTDOWN;
+	ret = snd_soc_component_update_bits(c, reg, mask, val);
+	if (ret < 0 && d->a9_d2)
+		wcd937x_d2_contain(d, 7);
+	return ret;
+}
+
+/* Avoid the unsigned snd_soc_component_read ABI for all A9 physical reads. */
+static int wcd937x_d2_read(struct wcd937x_priv *d, unsigned int reg, unsigned int *val)
+{
+	int ret;
+	if (atomic_read(&d->d2_stopped))
+		return -ESHUTDOWN;
+	ret = pm_runtime_resume_and_get(d->d2_dev);
+	if (ret < 0) {
+		wcd937x_d2_contain(d, 7);
+		return ret;
+	}
+	ret = atomic_read(&d->d2_stopped) ? -ESHUTDOWN :
+		regmap_read_bypassed(d->regmap, reg, val);
+	pm_runtime_put(d->d2_dev);
+	if (ret)
+		wcd937x_d2_contain(d, 7);
+	return ret;
+}
+
+static int wcd937x_d2_write_verify(struct snd_soc_component *c, unsigned int reg,
+				 unsigned int mask, unsigned int val)
+{
+	struct wcd937x_priv *d = snd_soc_component_get_drvdata(c);
+	unsigned int physical;
+	int ret;
+	if (atomic_read(&d->d2_stopped))
+		return -ESHUTDOWN;
+	/* Mixer controls execute before PCM PM; hold suppliers for write+proof. */
+	ret = pm_runtime_resume_and_get(d->d2_dev);
+	if (ret < 0) {
+		wcd937x_d2_contain(d, 7);
+		return ret;
+	}
+	ret = wcd937x_update_bits(c, reg, mask, val);
+	if (ret < 0)
+		goto out;
+	ret = wcd937x_d2_read(d, reg, &physical);
+	if (!ret && (physical & mask) != (val & mask)) {
+		wcd937x_d2_contain(d, 7);
+		ret = -EIO;
+	}
+out:
+	pm_runtime_put(d->d2_dev);
+	return ret;
+}
+
+static void wcd937x_d2_timeout(struct work_struct *work)
+{
+	struct wcd937x_priv *d = container_of(to_delayed_work(work),
+					   struct wcd937x_priv, d2_deadline);
+	wcd937x_d2_contain(d, 6);
+}
+
+static irqreturn_t wcd937x_d2_fault_irq(int irq, void *data)
+{
+	struct wcd937x_priv *d = data;
+	wcd937x_d2_contain(d, 1);
+	return IRQ_HANDLED;
+}
+
+static ssize_t d2_fault_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct wcd937x_priv *d = dev_get_drvdata(dev);
+	return sysfs_emit(buf, "%d\n", atomic_read(&d->d2_fault));
+}
+static DEVICE_ATTR_RO(d2_fault);
+
+static ssize_t d2_ready_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct wcd937x_priv *d = dev_get_drvdata(dev);
+	return sysfs_emit(buf, "%d\n", READ_ONCE(d->d2_bound) &&
+		!atomic_read(&d->d2_stopped) && !atomic_read(&d->d2_fault));
+}
+static DEVICE_ATTR_RO(d2_ready);
+
+static ssize_t d2_stop_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct wcd937x_priv *d = dev_get_drvdata(dev);
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	wcd937x_d2_contain(d, 0);
+	cancel_delayed_work_sync(&d->d2_deadline);
+	return count;
+}
+static DEVICE_ATTR_WO(d2_stop);
+
+static ssize_t d2_state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct wcd937x_priv *d = dev_get_drvdata(dev);
+	unsigned int ear, hph, aux;
+	int ret;
+	const char *state = "UNKNOWN";
+
+	if (atomic_read(&d->d2_stopped))
+		return sysfs_emit(buf, "%s\n",
+			gpiod_get_value_cansleep(d->reset_gpio) == 1 ? "RESET" : "UNKNOWN");
+	if (!READ_ONCE(d->d2_bound))
+		return sysfs_emit(buf, "%s\n",
+			gpiod_get_value_cansleep(d->reset_gpio) == 1 ? "RESET" : "UNKNOWN");
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		goto fault;
+	/* Bypassed reads are physical CSR reads, never regcache assertions. */
+	ret = regmap_read_bypassed(d->regmap, WCD937X_ANA_EAR, &ear);
+	if (!ret)
+		ret = regmap_read_bypassed(d->regmap, WCD937X_ANA_HPH, &hph);
+	if (!ret)
+		ret = regmap_read_bypassed(d->regmap, WCD937X_AUX_AUXPA, &aux);
+	pm_runtime_put(dev);
+	if (ret)
+		goto fault;
+	if ((hph & 0xc0) || (aux & BIT(7)))
+		goto fault;
+	state = (ear & BIT(7)) ? "EAR" : "SAFE";
+	if (atomic_read(&d->d2_stopped))
+		state = gpiod_get_value_cansleep(d->reset_gpio) == 1 ? "RESET" : "UNKNOWN";
+	return sysfs_emit(buf, "%s\n", state);
+fault:
+	wcd937x_d2_contain(d, 7);
+	return sysfs_emit(buf, "UNKNOWN\n");
+}
+static DEVICE_ATTR_RO(d2_state);
+
+static struct attribute *wcd937x_d2_attrs[] = {
+	&dev_attr_d2_fault.attr, &dev_attr_d2_ready.attr,
+	&dev_attr_d2_state.attr, &dev_attr_d2_stop.attr, NULL,
+};
+static const struct attribute_group wcd937x_d2_group = { .attrs = wcd937x_d2_attrs };
+
+static int wcd937x_d2_setup(struct snd_soc_component *component)
+{
+	struct wcd937x_priv *d = snd_soc_component_get_drvdata(component);
+	static const unsigned int faults[] = { WCD937X_IRQ_EAR_SCD_INT,
+		WCD937X_IRQ_LDORT_SCD_INT };
+	unsigned int val;
+	int ret, i, irq;
+
+	ret = pm_runtime_resume_and_get(component->dev);
+	if (ret < 0)
+		return ret;
+	ret = regmap_update_bits(d->regmap, WCD937X_ANA_EAR_COMPANDER_CTL, 0x7c, 16 << 2);
+	if (!ret)
+		ret = regmap_update_bits(d->regmap, WCD937X_ANA_EAR, BIT(7), 0);
+	if (!ret)
+		ret = regmap_update_bits(d->regmap, WCD937X_ANA_HPH, 0xc0, 0);
+	if (!ret)
+		ret = regmap_update_bits(d->regmap, WCD937X_AUX_AUXPA, BIT(7), 0);
+	if (!ret)
+		ret = regmap_update_bits(d->regmap, WCD937X_DIGITAL_CDC_EAR_PATH_CTL, BIT(0), 0);
+	if (!ret)
+		ret = regmap_read_bypassed(d->regmap, WCD937X_ANA_EAR_COMPANDER_CTL, &val);
+	if (!ret && (val & 0x7c) != (16 << 2))
+		ret = -EIO;
+	pm_runtime_put(component->dev);
+	if (ret)
+		return ret;
+	/* Existing HPHL/AUX handlers are replaced for the D2 profile below. */
+	for (i = 0; i < ARRAY_SIZE(faults); i++) {
+		irq = regmap_irq_get_virq(d->irq_chip, faults[i]);
+		if (irq <= 0)
+			return irq ? irq : -EINVAL;
+		ret = devm_request_threaded_irq(component->dev, irq, NULL,
+			wcd937x_d2_fault_irq, IRQF_ONESHOT, "a9-d2-fault", d);
+		if (ret)
+			return ret;
+	}
+	WRITE_ONCE(d->d2_bound, true);
+	return 0;
+}
