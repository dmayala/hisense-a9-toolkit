 // Copyright (c) 2017-2018, Linaro Limited
 
 #include <linux/slab.h>
+#include <linux/mutex.h>
 #include <sound/soc.h>
 #include <linux/kernel.h>
 #include <linux/delay.h>
@@ -17,7 +18,47 @@
 	int clsh_users;
 	int codec_version;
 	struct snd_soc_component *comp;
+	/* Opt-in A9 hook; ordinary profiles keep the original I/O behavior. */
+	int (*a9_update)(struct snd_soc_component *, unsigned int, unsigned int, unsigned int);
+	int a9_error;
+	struct mutex a9_io_lock;
 };
+
+/* The callback must assert reset/latch containment on a negative return.
+ * Serialize A9 writes so no classH write follows its first failure. */
+static int wcd_clsh_update_bits(struct wcd_clsh_ctrl *ctrl,
+		struct snd_soc_component *comp, unsigned int reg,
+		unsigned int mask, unsigned int val)
+{
+	int ret;
+
+	if (!ctrl->a9_update)
+		return snd_soc_component_update_bits(comp, reg, mask, val);
+	mutex_lock(&ctrl->a9_io_lock);
+	if (ctrl->a9_error) {
+		ret = ctrl->a9_error;
+	} else {
+		ret = ctrl->a9_update(comp, reg, mask, val);
+		if (ret < 0)
+			ctrl->a9_error = ret;
+	}
+	mutex_unlock(&ctrl->a9_io_lock);
+	return ret;
+}
+
+int wcd_clsh_ctrl_set_a9_update(struct wcd_clsh_ctrl *ctrl,
+		int (*update)(struct snd_soc_component *, unsigned int,
+			      unsigned int, unsigned int))
+{
+	/* One installation before component controls or DAPM become visible.
+	 * No removal/rearm path is provided after a failed transaction. */
+	if (!update || ctrl->codec_version != WCD937X ||
+	    ctrl->state != WCD_CLSH_STATE_IDLE || ctrl->a9_update || ctrl->a9_error)
+		return -EINVAL;
+	ctrl->a9_update = update;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(wcd_clsh_ctrl_set_a9_update);
 
