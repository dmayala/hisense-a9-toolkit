+/* NOPM widget: the core must never issue an unchecked PA register write. */
+static int wcd937x_a9_d2_ear_pa(struct snd_soc_dapm_widget *w,
+			      struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
+	struct wcd937x_priv *d = snd_soc_component_get_drvdata(c);
+	unsigned int pa;
+	int ret;
+
+	if (atomic_read(&d->d2_stopped))
+		return -ESHUTDOWN;
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		if (!d->d2_bound || atomic_read(&d->d2_fault) ||
+		    !atomic_read(&d->d2_attempt) ||
+		    atomic_cmpxchg(&d->d2_pa_once, 0, 1)) {
+			ret = -EPERM;
+			goto fault;
+		}
+		ret = wcd937x_d2_check_route(d);
+		if (ret)
+			goto fault;
+		/* Deadline begins before preparation; it is independent of userspace. */
+		schedule_delayed_work(&d->d2_deadline, msecs_to_jiffies(1500));
+		ret = wcd937x_codec_enable_ear_pa(w, kcontrol, event);
+		if (ret < 0)
+			goto fault;
+		ret = wcd937x_d2_write_verify(c, WCD937X_ANA_EAR, BIT(7), BIT(7));
+		if (ret)
+			goto fault;
+		atomic_set(&d->d2_pa_phase, 1);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		if (atomic_cmpxchg(&d->d2_pa_phase, 1, 2) != 1) {
+			ret = -EPERM;
+			goto fault;
+		}
+		ret = wcd937x_d2_read(d, WCD937X_ANA_EAR, &pa);
+		if (ret || !(pa & BIT(7))) {
+			ret = ret ? ret : -EIO;
+			goto fault;
+		}
+		ret = wcd937x_codec_enable_ear_pa(w, kcontrol, event);
+		if (ret < 0)
+			goto fault;
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		if (atomic_cmpxchg(&d->d2_pa_phase, 2, 3) != 2) {
+			ret = -EPERM;
+			goto fault;
+		}
+		/* Prove physical PA off before disabling its watchdog or supplies. */
+		ret = wcd937x_d2_write_verify(c, WCD937X_ANA_EAR, BIT(7), 0);
+		if (ret)
+			goto fault;
+		ret = wcd937x_codec_enable_ear_pa(w, kcontrol, event);
+		if (ret < 0)
+			goto fault;
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		if (atomic_cmpxchg(&d->d2_pa_phase, 3, 4) != 3) {
+			ret = -EPERM;
+			goto fault;
+		}
+		ret = wcd937x_d2_read(d, WCD937X_ANA_EAR, &pa);
+		if (ret || (pa & BIT(7))) {
+			ret = ret ? ret : -EIO;
+			goto fault;
+		}
+		ret = wcd937x_codec_enable_ear_pa(w, kcontrol, event);
+		if (ret < 0)
+			goto fault;
+		ret = wcd937x_d2_read(d, WCD937X_ANA_EAR, &pa);
+		if (ret || (pa & BIT(7))) {
+			ret = ret ? ret : -EIO;
+			goto fault;
+		}
+		/* Only proven-off completion may remove the independent deadline. */
+		cancel_delayed_work_sync(&d->d2_deadline);
+		break;
+	default:
+		ret = -EINVAL;
+		goto fault;
+	}
+	return atomic_read(&d->d2_stopped) ? -ESHUTDOWN : 0;
+fault:
+	wcd937x_d2_contain(d, 7);
+	return ret;
 }
 
