# Opt-in A9 APR/ASoC infrastructure. Merge after the base config.
# Modular providers are loaded explicitly after firmware/vendor availability.
# Do not add these to unconditional initramfs modules.load.
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_PCM=m
CONFIG_SND_SOC=m
CONFIG_QCOM_APR=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
CONFIG_SND_SOC_SM8250=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_WCD937X_SDW=m
CONFIG_SM_LPASSCC_6115=m
CONFIG_PINCTRL_SM6115_LPASS_LPI=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=m
# QRTR/PDR/PD mapper are shared with branch wifi; do not add a second daemon.
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QCOM_PDR_HELPERS=m
CONFIG_QCOM_PD_MAPPER=m
