@@ -1325,0 +1338,28 @@
+/* Stock restores the interrupted transaction before considering a new send.
+ * Keep the existing pending-list ownership and disconnect barrier. Compare the
+ * complete request so a different call on a reused FD cannot consume a reply.
+ */
+static struct fastrpc_invoke_ctx *fastrpc_context_restore(
+		struct fastrpc_user *fl, u32 handle, u32 sc,
+		struct fastrpc_invoke_args *args)
+{
+	struct fastrpc_invoke_ctx *ctx, *found = NULL;
+
+	spin_lock(&fl->lock);
+	list_for_each_entry(ctx, &fl->pending, node) {
+		if (!ctx->a9_interrupted || ctx->pid != current->pid)
+			continue;
+		if (ctx->msg.handle != handle || ctx->sc != sc ||
+		    (ctx->nscalars && memcmp(ctx->args, args,
+			array_size(ctx->nscalars, sizeof(*args))))) {
+			found = ERR_PTR(-EINVAL);
+			break;
+		}
+		ctx->a9_interrupted = false;
+		found = ctx;
+		break;
+	}
+	spin_unlock(&fl->lock);
+	return found;
+}
+
@@ -1348,0 +1389,12 @@
+	}
+
+	if (!kernel) {
+		ctx = fastrpc_context_restore(fl, handle, sc, args);
+		if (IS_ERR(ctx)) {
+			mutex_unlock(&fl->cctx->a9_invoke_lock);
+			return PTR_ERR(ctx);
+		}
+		if (ctx) {
+			mutex_unlock(&fl->cctx->a9_invoke_lock);
+			goto wait_for_response;
+		}
