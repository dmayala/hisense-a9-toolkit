+/* A9 S1: private sidecar gate, immutable for this module lifetime.
+ * Loading with the default registers neither driver and claims no context bank.
+ * Only the reviewed, explicit one-attempt loader may supply =1. */
+static bool a9_sensor_fastrpc;
+module_param(a9_sensor_fastrpc, bool, 0444);
+MODULE_PARM_DESC(a9_sensor_fastrpc,
+                 "A9 S1 admitted ADSP sensor FastRPC driver registration (default off)");
+
+/* Count channels whose DMA/CB teardown has not actually completed. */
+static atomic_t a9_sensor_draining = ATOMIC_INIT(0);
+
+static int a9_sensor_drain_get(char *buffer, const struct kernel_param *kp)
+{
+	return scnprintf(buffer, PAGE_SIZE, "%c\n",
+			 atomic_read(&a9_sensor_draining) ? 'Y' : 'N');
+}
+
+static const struct kernel_param_ops a9_sensor_drain_ops = {
+	.get = a9_sensor_drain_get,
+};
+module_param_cb(a9_sensor_drain_pending, &a9_sensor_drain_ops, NULL, 0444);
+MODULE_PARM_DESC(a9_sensor_drain_pending,
+                 "A9 S1 DMA/CB teardown pending; OFFLINE proof requires N");
 
