+
+/* A9 S1: callback removal never waits for a remote RPC or userspace join.
+ * Keep CB devices/IOMMU mappings registered until all admitted bounce buffers
+ * have really completed dma_free_coherent(). A lost remote response may retain
+ * a buffer/context until reboot; retaining its CB is safer than unmapping live
+ * DMA allocations. Recovery is disabled and this tuple permits one attempt.
+ */
+static void fastrpc_a9_depopulate(struct work_struct *work)
+{
+	struct fastrpc_channel_ctx *cctx = container_of(work,
+		struct fastrpc_channel_ctx, a9_depopulate_work);
+
+	of_platform_depopulate(cctx->a9_channel_dev);
+	put_device(cctx->a9_channel_dev);
+	/* N is exposed only after the last real CB teardown has returned. */
+	atomic_dec(&a9_sensor_draining);
+	fastrpc_channel_ctx_put(cctx);
+}
+
+static void fastrpc_a9_maybe_depopulate(struct fastrpc_channel_ctx *cctx)
+{
+	unsigned long flags;
+	bool queue = false;
+
+	spin_lock_irqsave(&cctx->lock, flags);
+	if (cctx->a9_removed && !atomic_read(&cctx->a9_dma_buffers) &&
+	    !cctx->a9_depopulate_queued) {
+		cctx->a9_depopulate_queued = true;
+		fastrpc_channel_ctx_get(cctx);
+		queue = true;
+	}
+	spin_unlock_irqrestore(&cctx->lock, flags);
+	if (queue)
+		schedule_work(&cctx->a9_depopulate_work);
 }
 
