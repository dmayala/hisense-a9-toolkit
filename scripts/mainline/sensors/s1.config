# Full D1 replacement: the only functional change is modular upstream FastRPC.
# FastRPC is private-sidecar only, never installed in modules.load or init.
# The separately audited module gate defaults off, registers no driver and is
# immutable after loading. No gyro/hall/AP I2C driver is enabled.
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_PDR_HELPERS=m
CONFIG_QCOM_PDR_MSG=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
# CONFIG_REMOTEPROC_CDEV is not set
# CONFIG_QCOM_Q6V5_ADSP is not set
# CONFIG_QCOM_Q6V5_MSS is not set
# CONFIG_QCOM_Q6V5_WCSS is not set
# CONFIG_QCOM_WCNSS_PIL is not set
# CONFIG_QCOM_WCNSS_CTRL is not set
CONFIG_QCOM_FASTRPC=m
# CONFIG_PINCTRL_LPASS_LPI is not set
CONFIG_QCOM_APR=m
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SOUNDWIRE=m
# CONFIG_SOUNDWIRE_QCOM is not set
CONFIG_SND_SOC_SM8250=m
# CONFIG_SND_SOC_LPASS_RX_MACRO is not set
# CONFIG_SND_SOC_LPASS_TX_MACRO is not set
# CONFIG_SND_SOC_LPASS_VA_MACRO is not set
# CONFIG_SND_SOC_LPASS_WSA_MACRO is not set
# CONFIG_SND_SOC_WCD937X_SDW is not set
# CONFIG_SND_SOC_WSA881X is not set
# CONFIG_SND_SOC_WSA883X is not set
# CONFIG_SM_LPASSCC_6115 is not set
# CONFIG_SND_USB_AUDIO is not set
