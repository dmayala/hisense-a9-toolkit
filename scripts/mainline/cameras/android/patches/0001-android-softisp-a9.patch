+/*
+ * A6L: add the cameras found at start-up in HAL configuration order: cameras
+ * with an "order" entry first (ascending), then the others in enumeration
+ * order. An "aux" camera is only exposed after a non-aux camera with the same
+ * facing, so it can never be the default (first) camera of that facing, nor
+ * the torch owner (the provider gives the torch to the first BACK camera).
+ */
+void CameraHalManager::addPendingCameras()
+{
+	std::vector<std::shared_ptr<Camera>> pending;
+
+	{
+		MutexLocker locker(mutex_);
+		pending = std::move(pendingCameras_);
+		pendingCameras_.clear();
+		startDone_ = true;
+	}
+
+	auto rank = [this](const std::shared_ptr<Camera> &cam) {
+		const CameraConfigData *cfg = halConfig_.cameraConfigData(cam->id());
+		return cfg && cfg->order >= 0 ? cfg->order : std::numeric_limits<int>::max();
+	};
+	std::stable_sort(pending.begin(), pending.end(),
+			 [&](const std::shared_ptr<Camera> &a, const std::shared_ptr<Camera> &b) {
+				 return rank(a) < rank(b);
+			 });
+
+	std::set<int> mainFacings;
+	for (const std::shared_ptr<Camera> &cam : pending) {
+		const CameraConfigData *cfg = halConfig_.cameraConfigData(cam->id());
+		if (cfg && cfg->aux && !mainFacings.count(cfg->facing)) {
+			LOG(HAL, Warning)
+				<< "Auxiliary camera " << cam->id()
+				<< " not exposed: no main camera with the same facing";
+			continue;
+		}
+		if (cfg && !cfg->aux)
+			mainFacings.insert(cfg->facing);
+
+		cameraAdded(cam);
+	}
+}
