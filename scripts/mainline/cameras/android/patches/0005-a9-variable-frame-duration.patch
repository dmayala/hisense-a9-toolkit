@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <stdint.h>
+namespace libcamera {
+/* Separate ioctls: VBLANK changes the kernel's EXPOSURE range. On failure
+ * never issue the operation that depends on the failed range change. */
+template<typename Blank, typename Exposure>
+int a9ApplyFrameTiming(int32_t &current, int32_t desired, Blank blank, Exposure exposure)
+{
+	if (desired > current) {
+		int ret = blank(desired);
+		if (ret) return ret;
+		current = desired;
+	}
+	int ret = exposure();
+	if (ret) return ret;
+	if (desired < current) {
+		ret = blank(desired);
+		if (ret) return ret;
+		current = desired;
+	}
+	return 0;
+}
+} /* namespace libcamera */
