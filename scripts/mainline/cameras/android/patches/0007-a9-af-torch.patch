diff --git a/src/android/camera_torch.h b/src/android/camera_torch.h
new file mode 100644
--- /dev/null
+++ b/src/android/camera_torch.h
@@ -0,0 +1,179 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <hardware/camera_common.h>
+#include <system/camera_metadata.h>
+#include <cerrno>
+#include <chrono>
+#include <condition_variable>
+#include <fcntl.h>
+#include <functional>
+#include <linux/videodev2.h>
+#include <mutex>
+#include <string>
+#include <sys/ioctl.h>
+#include <thread>
+#include <unistd.h>
+#include <libcamera/camera.h>
+#include <libcamera/property_ids.h>
+
+/* One graph-discovered V4L2 device for both Android torch interfaces. The
+ * kernel owns fault/close/deadline shutdown; this thread reports auto-off. */
+class A9Torch {
+public:
+	A9Torch() : worker_([this] { watch(); }) {}
+	~A9Torch()
+	{
+		{ std::lock_guard<std::mutex> lock(mutex_); quitting_ = true; }
+		wake_.notify_all();
+		worker_.join();
+		off();
+		if (fd_ >= 0) ::close(fd_);
+	}
+	static bool hasDevice(const libcamera::Camera *camera)
+	{
+		return camera->properties().get(libcamera::properties::draft::A9TorchDevice).has_value();
+	}
+	static bool available(const libcamera::Camera *camera)
+	{
+		auto path = camera->properties().get(libcamera::properties::draft::A9TorchDevice);
+		if (!path) return false;
+		int fd = ::open(std::string(*path).c_str(), O_RDWR | O_CLOEXEC);
+		if (fd < 0) return false;
+		v4l2_queryctrl info{}; info.id = V4L2_CID_FLASH_LED_MODE;
+		bool ok = ioctl(fd, VIDIOC_QUERYCTRL, &info) == 0 && info.maximum == V4L2_FLASH_LED_MODE_TORCH;
+		::close(fd);
+		return ok;
+	}
+	void setCallback(std::function<void(int)> callback)
+	{
+		std::lock_guard<std::mutex> lock(mutex_); callback_ = std::move(callback);
+	}
+	int acquireCamera(const libcamera::Camera *camera)
+	{
+		std::function<void(int)> notify;
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			if (cameraOpen_) return -EBUSY;
+			if (hasDevice(camera)) {
+				int ret = init(camera);
+				if (ret) return ret;
+				ret = mode(false);
+				if (ret < 0) return ret;
+				notify = callback_;
+			}
+			cameraOpen_ = true;
+		}
+		if (notify) notify(TORCH_MODE_STATUS_NOT_AVAILABLE);
+		return 0;
+	}
+	void releaseCamera()
+	{
+		off();
+		std::function<void(int)> notify;
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			cameraOpen_ = false; notify = callback_;
+		}
+		if (notify) notify(TORCH_MODE_STATUS_AVAILABLE_OFF);
+	}
+	int setModule(const libcamera::Camera *camera, bool on, std::function<void(int)> callback)
+	{
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			if (cameraOpen_) return -EBUSY;
+			int ret = init(camera);
+			if (ret) return ret;
+			ret = mode(on);
+			if (ret < 0) return ret;
+			callback_ = callback;
+			moduleOn_ = on;
+		}
+		callback(on ? TORCH_MODE_STATUS_AVAILABLE_ON : TORCH_MODE_STATUS_AVAILABLE_OFF);
+		wake_.notify_all();
+		return 0;
+	}
+	int setCapture(uint8_t value)
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		if (value != ANDROID_FLASH_MODE_OFF && value != ANDROID_FLASH_MODE_TORCH) {
+			mode(false); return -EINVAL; /* no synchronized flash */
+		}
+		if (value == ANDROID_FLASH_MODE_OFF) {
+			if (fd_ < 0) return 0;
+			return mode(false);
+		}
+		if (!cameraOpen_ || fd_ < 0) return -ENOSYS;
+		return mode(true);
+	}
+	void off()
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		if (fd_ >= 0) mode(false);
+		moduleOn_ = false;
+	}
+	class RequestGuard {
+	public:
+		explicit RequestGuard(A9Torch &torch) : torch_(torch) {}
+		~RequestGuard() { if (!queued_) torch_.off(); }
+		void queued() { queued_ = true; }
+	private:
+		A9Torch &torch_;
+		bool queued_ = false;
+	};
+private:
+	int init(const libcamera::Camera *camera)
+	{
+		if (fd_ >= 0) return 0;
+		auto path = camera->properties().get(libcamera::properties::draft::A9TorchDevice);
+		if (!path) return -ENOSYS;
+		fd_ = ::open(std::string(*path).c_str(), O_RDWR | O_CLOEXEC);
+		return fd_ < 0 ? -errno : 0;
+	}
+	int readMode()
+	{
+		v4l2_control ctrl{}; ctrl.id = V4L2_CID_FLASH_LED_MODE;
+		if (ioctl(fd_, VIDIOC_G_CTRL, &ctrl) < 0) return -errno;
+		return ctrl.value == V4L2_FLASH_LED_MODE_TORCH ? 1 : 0;
+	}
+	int mode(bool on)
+	{
+		if (fd_ < 0) return on ? -ENODEV : 0;
+		v4l2_control ctrl{}; ctrl.id = V4L2_CID_FLASH_LED_MODE;
+		ctrl.value = on ? V4L2_FLASH_LED_MODE_TORCH : V4L2_FLASH_LED_MODE_NONE;
+		if (ioctl(fd_, VIDIOC_S_CTRL, &ctrl) < 0) {
+			int ret = -errno;
+			ctrl.value = V4L2_FLASH_LED_MODE_NONE;
+			ioctl(fd_, VIDIOC_S_CTRL, &ctrl);
+			::close(fd_); fd_ = -1;
+			return ret;
+		}
+		int state = readMode();
+		if (state < 0 || state != on) {
+			::close(fd_); fd_ = -1;
+			return state < 0 ? state : -EIO;
+		}
+		return state;
+	}
+	void watch()
+	{
+		std::unique_lock<std::mutex> lock(mutex_);
+		while (!quitting_) {
+			wake_.wait_for(lock, std::chrono::milliseconds(100));
+			if (quitting_) break;
+			if (!moduleOn_ || fd_ < 0) continue;
+			int state = readMode();
+			if (state > 0) continue;
+			mode(false); moduleOn_ = false;
+			auto callback = callback_;
+			lock.unlock();
+			if (callback) callback(TORCH_MODE_STATUS_AVAILABLE_OFF);
+			lock.lock();
+		}
+	}
+	std::mutex mutex_;
+	std::condition_variable wake_;
+	int fd_ = -1;
+	bool cameraOpen_ = false, moduleOn_ = false, quitting_ = false;
+	std::function<void(int)> callback_;
+	std::thread worker_;
+};
