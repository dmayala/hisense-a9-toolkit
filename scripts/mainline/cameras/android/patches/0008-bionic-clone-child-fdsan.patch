diff --git a/include/libcamera/internal/a9_bionic_child.h b/include/libcamera/internal/a9_bionic_child.h
new file mode 100644
--- /dev/null
+++ b/include/libcamera/internal/a9_bionic_child.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#ifdef __BIONIC__
+#include <android/fdsan.h>
+#endif
+
+namespace libcamera {
+/* clone3 bypasses bionic fork()'s child hook. Match its pre-exec fdsan
+ * reset before closing inherited FDs. Only the single-threaded child calls
+ * this: the provider's checks and the new exec worker's defaults stay intact.
+ * User/net namespaces, pidfd and the inherited-FD allowlist are unchanged. */
+inline void a9BionicPreExecChild()
+{
+#ifdef __BIONIC__
+	android_fdsan_set_error_level(ANDROID_FDSAN_ERROR_LEVEL_DISABLED);
+#endif
+}
+} /* namespace libcamera */
