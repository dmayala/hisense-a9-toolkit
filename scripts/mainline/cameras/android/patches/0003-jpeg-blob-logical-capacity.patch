--- /dev/null
+++ b/src/android/jpeg/jpeg_blob.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <cerrno>
+#include <cstring>
+#include <hardware/camera3.h>
+#include <libcamera/base/span.h>
+
+/* The camera3 ABI trailer may be unaligned (BLOB width is a byte count). */
+inline int writeJpegBlob(libcamera::Span<uint8_t> destination,
+			size_t capacity, int jpegSize)
+{
+	if (capacity > destination.size() || capacity < sizeof(camera3_jpeg_blob_t) + 4 ||
+	    jpegSize < 4)
+		return -EINVAL;
+	if (static_cast<size_t>(jpegSize) > capacity - sizeof(camera3_jpeg_blob_t))
+		return -ENOSPC;
+	if (destination[0] != 0xff || destination[1] != 0xd8 ||
+	    destination[jpegSize - 2] != 0xff || destination[jpegSize - 1] != 0xd9)
+		return -EINVAL;
+
+	camera3_jpeg_blob_t blob{};
+	blob.jpeg_blob_id = CAMERA3_JPEG_BLOB_ID;
+	blob.jpeg_size = jpegSize;
+	memcpy(destination.data() + capacity - sizeof(blob), &blob, sizeof(blob));
+	return 0;
+}
