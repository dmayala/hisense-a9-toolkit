+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <hardware/gralloc.h>
+#include <hardware/camera3.h>
+#include <system/graphics.h>
+#include <libcamera/formats.h>
+
+/* Keep in sync with the vkms minigbm IMPL_DEF camera-display resolver.
+ * CPU-only / encoder / explicit YUV streams keep their normal format.
+ * The pipeline still supplies internal NV12; this is the Android destination.
+ */
+inline libcamera::PixelFormat a9CameraOutputFormat(int format, uint32_t usage,
+                                                libcamera::PixelFormat fallback)
+{
+	if (format == HAL_PIXEL_FORMAT_IMPLEMENTATION_DEFINED &&
+	    (usage & GRALLOC_USAGE_HW_CAMERA_WRITE) &&
+	    (usage & (GRALLOC_USAGE_HW_TEXTURE | GRALLOC_USAGE_HW_COMPOSER |
+	              GRALLOC_USAGE_HW_RENDER)) &&
+	    !(usage & GRALLOC_USAGE_HW_VIDEO_ENCODER))
+		return libcamera::formats::ABGR8888;
+	return fallback;
+}
+
+/* Publish the concrete format to camera3/HIDL: Mesa's fallback importer
+ * cannot inspect even RGB-backed AHBs still labelled IMPLEMENTATION_DEFINED.
+ * The HAL must retain the destination format after this permitted override. */
+inline void a9OverrideCameraPreviewFormat(camera3_stream_t &stream,
+                                         libcamera::PixelFormat destination)
+{
+	if (stream.format == HAL_PIXEL_FORMAT_IMPLEMENTATION_DEFINED &&
+	    destination == libcamera::formats::ABGR8888)
+		stream.format = HAL_PIXEL_FORMAT_RGBA_8888;
+}
