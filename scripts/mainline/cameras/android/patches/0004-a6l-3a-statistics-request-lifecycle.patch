+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <linux/videodev2.h>
+#include <libcamera/controls.h>
+
+namespace libcamera {
+struct A6lSensorExposureGain { int32_t exposure, gain; };
+inline std::optional<A6lSensorExposureGain> a6lSensorExposureGain(const ControlList &controls)
+{
+	if (!controls.contains(V4L2_CID_EXPOSURE) || !controls.contains(V4L2_CID_ANALOGUE_GAIN))
+		return std::nullopt;
+	const ControlValue &exposure = controls.get(V4L2_CID_EXPOSURE);
+	const ControlValue &gain = controls.get(V4L2_CID_ANALOGUE_GAIN);
+	if (exposure.type() != ControlTypeInteger32 || exposure.isArray() ||
+	    gain.type() != ControlTypeInteger32 || gain.isArray())
+		return std::nullopt;
+	return A6lSensorExposureGain{ exposure.get<int32_t>(), gain.get<int32_t>() };
+}
