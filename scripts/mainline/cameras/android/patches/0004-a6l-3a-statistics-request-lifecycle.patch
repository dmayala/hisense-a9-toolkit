+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Opt-in bounded A6L camera diagnostics; never changes image controls. */
+#pragma once
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <stdint.h>
+namespace libcamera {
+inline bool a6lQualityDebug(uint32_t frame)
+{
+	static const bool enabled = [] {
+		const char *value = std::getenv("LIBCAMERA_A6L_QUALITY_DIAGNOSTICS");
+		return value && std::strcmp(value, "1") == 0;
+	}();
+	return enabled && frame < 240;
+}
+inline uint64_t a6lQualityMonotonicNs()
+{
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count();
+}
