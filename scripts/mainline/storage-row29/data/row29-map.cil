; ROW29 R2: source-derived mapper policy; no permissive domain or new formatter.
; Physical parent is READ ONLY. Writes use only the helper-created mapper nodes;
; policy cannot constrain dm table sectors: the fixed C/GPT checks do that.
(type a9ml_row29_map) (roletype r a9ml_row29_map)
(type a9ml_row29_map_exec) (roletype object_r a9ml_row29_map_exec)
(type a9ml_row29_block) (roletype object_r a9ml_row29_block)
(typeattributeset domain (a9ml_row29_map))
(typeattributeset file_type (a9ml_row29_map_exec))
(typeattributeset exec_type (a9ml_row29_map_exec))
(typeattributeset vendor_file_type (a9ml_row29_map_exec))
(typeattributeset dev_type (a9ml_row29_block))
(typetransition init_202504 a9ml_row29_map_exec process a9ml_row29_map)
(allow init_202504 a9ml_row29_map (process (transition siginh rlimitinh)))
(allow init_202504 a9ml_row29_map_exec (file (read open getattr map execute)))
(allow a9ml_row29_map a9ml_row29_map_exec (file (entrypoint read open getattr map execute)))
(allow a9ml_row29_map init_202504 (process (sigchld)))
(allow a9ml_row29_map self (process (signal setrlimit)))
(allow a9ml_row29_map self (dir (read open search getattr)))
(allow a9ml_row29_map self (lnk_file (read getattr)))
(allow a9ml_row29_map self (capability (sys_admin mknod chown fowner dac_override dac_read_search)))
(allow a9ml_row29_map vendor_file_202504 (dir (search getattr)))
(allow a9ml_row29_map kmsg_device_202504 (chr_file (write append open getattr)))
(allow a9ml_row29_map proc_202504 (dir (read open search getattr)))
(allow a9ml_row29_map proc_202504 (lnk_file (read getattr)))
(allow a9ml_row29_map proc_202504 (file (read open getattr)))
(allow a9ml_row29_map proc_cmdline_202504 (file (read open getattr)))
(allow a9ml_row29_map proc_mounts_202504 (file (read open getattr)))
(allow a9ml_row29_map sysfs_type (dir (read open search getattr)))
(allow a9ml_row29_map sysfs_type (lnk_file (read getattr)))
(allow a9ml_row29_map sysfs_type (file (read open getattr)))
(allow a9ml_row29_map rootfs_202504 (dir (search getattr)))
(allow a9ml_row29_map device_202504 (dir (read open search getattr write add_name remove_name create)))
(allow a9ml_row29_map block_device_202504 (dir (read open search getattr write add_name remove_name create)))
(allow a9ml_row29_map block_device_202504 (lnk_file (read getattr)))
(allow a9ml_row29_map block_device_202504 (blk_file (read open getattr ioctl)))
(allowx a9ml_row29_map block_device_202504 (ioctl blk_file (0x1268 0x1272)))
; Private tmpfs node directory. Nodes receive their real classes/types on create.
(allow a9ml_row29_map tmpfs_202504 (dir (read open search getattr write add_name remove_name create rmdir mounton setattr)))
(allow a9ml_row29_map tmpfs_202504 (filesystem (mount unmount getattr)))
; Transition results must be concrete types, not the versioned attributes.
(typetransition a9ml_row29_map tmpfs_202504 chr_file dm_device)
(typetransition a9ml_row29_map tmpfs_202504 blk_file a9ml_row29_block)
(typetransition a9ml_row29_map block_device_202504 blk_file a9ml_row29_block)
(typetransition a9ml_row29_map device_202504 blk_file a9ml_row29_block)
(allow a9ml_row29_map dm_device_202504 (chr_file (create open read write getattr ioctl unlink)))
; GET/CREATE/REMOVE/SUSPEND/STATUS/LOAD/TABLE_STATUS only; no remove-all ioctl.
(allowx a9ml_row29_map dm_device_202504 (ioctl chr_file (0xfd03 0xfd04 0xfd06 0xfd07 0xfd09 0xfd0c)))
(allow a9ml_row29_map a9ml_row29_block (blk_file (create open read write getattr ioctl unlink relabelfrom)))
(allowx a9ml_row29_map a9ml_row29_block (ioctl blk_file (0x1268 0x1272)))
(allow a9ml_row29_block tmpfs_202504 (filesystem (associate)))
; Published node follows Android's ordinary dm_device label, including ueventd
; nodes that already exist. No broad write permission for physical block_device.
(allow a9ml_row29_map dm_device_202504 (blk_file (read open getattr relabelto)))
(allow a9ml_row29_map dm_device_202504 (lnk_file (read getattr)))
; Existing f2fs uses xattrs/labeledfs. Root can initially be unlabeled from mkfs;
; set only root owner/mode/context, then remove only the prior regular hold file.
(allow a9ml_row29_map labeledfs_202504 (filesystem (mount unmount getattr)))
(allow a9ml_row29_map unlabeled_202504 (dir (read open search getattr setattr relabelfrom)))
(allow a9ml_row29_map system_data_root_file_202504 (dir (read open search getattr setattr relabelfrom relabelto write)))
(allow a9ml_row29_map system_data_file_202504 (dir (read open search getattr)))
(allow a9ml_row29_map shell_data_file_202504 (dir (read open search getattr write remove_name)))
(allow a9ml_row29_map shell_data_file_202504 (file (getattr unlink)))
