--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -2216,6 +2216,23 @@
 	WARN_ON(res->result == QSEECOM_RESULT_BLOCKED_ON_LISTENER);
 
 	return 0;
+}
+
+/* Raw transport entry for the Android character-device frontend. It preserves
+ * QSEE status/type/data so that the frontend can dispatch and resume listeners.
+ * The frontend serializes entire transactions, including callback waits.
+ */
+int qcom_scm_qseecom_android_call(const struct qcom_scm_desc *desc,
+				struct qcom_scm_res *res)
+{
+	int ret;
+
+	if (!__scm)
+		return -EPROBE_DEFER;
+	mutex_lock(&qcom_scm_qseecom_call_lock);
+	ret = qcom_scm_call(__scm->dev, desc, res);
+	mutex_unlock(&qcom_scm_qseecom_call_lock);
+	return ret;
 }
 
