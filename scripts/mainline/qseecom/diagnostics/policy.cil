; Independent read-only kernel status -> main logcat bridge. No QSEE/RPMB access.
(type a9_rpmb_diag)
(roletype object_r a9_rpmb_diag)
(typeattributeset domain (a9_rpmb_diag))
(type a9_rpmb_diag_exec)
(roletype object_r a9_rpmb_diag_exec)
(typeattributeset file_type (a9_rpmb_diag_exec))
(typeattributeset exec_type (a9_rpmb_diag_exec))
(typeattributeset vendor_file_type (a9_rpmb_diag_exec))
(allow init_202504 a9_rpmb_diag_exec (file (read getattr map execute open)))
(allow init_202504 a9_rpmb_diag (process (transition siginh rlimitinh)))
(dontaudit init_202504 a9_rpmb_diag (process (noatsecure)))
(allow a9_rpmb_diag a9_rpmb_diag_exec (file (read getattr map execute open entrypoint)))
(typetransition init_202504 a9_rpmb_diag_exec process a9_rpmb_diag)
(allow a9_rpmb_diag self (capability2 (syslog)))
(allow a9_rpmb_diag kernel_202504 (system (syslog_read)))
(allow a9_rpmb_diag device_202504 (dir (search getattr)))
(allow a9_rpmb_diag kmsg_device_202504 (chr_file (read open getattr)))
(allow a9_rpmb_diag self (unix_dgram_socket (create connect write getattr getopt setopt)))
(allow a9_rpmb_diag socket_device_202504 (dir (search getattr)))
(allow a9_rpmb_diag logdw_socket_202504 (sock_file (write)))
(allow a9_rpmb_diag logd_202504 (unix_dgram_socket (sendto)))
