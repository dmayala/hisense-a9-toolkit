# Opt-in Android Wi-Fi draft. Merged LAST, only with A9_WIFI=1.
# Firmware and isolated RAM storage must be prepared before explicit MPSS start.
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_NAMESPACES=y
CONFIG_TMPFS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QCOM_RMTFS_MEM=m
# A9_WIFI_PD_MAPPER=userspace adds an explicit generated override disabling this.
CONFIG_QCOM_PD_MAPPER=m
