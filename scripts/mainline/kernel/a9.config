# a9.config -- Hisense A9 (HLTE556N) diskless mainline fragment, merged on top of
# arm64 defconfig by build.sh. 2026-10-14. Goal: console + USB gadget + pstore,
# nothing that touches storage or drives the E Ink panel by default.
CONFIG_LOCALVERSION="-a9"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARCH_QCOM=y
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BITMAIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_LAN969X is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MMP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_PENSANDO is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# no virtualization / big subsystems we do not need on a diskless debug boot
# CONFIG_KVM is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_SOUND is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_CAN is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INFINIBAND is not set
# CONFIG_NET_VENDOR_MELLANOX is not set

# SoC core, built in (no modules needed to reach a shell)
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
# RPM MSG RAM sleep counters must work without a userspace module loader.
CONFIG_QCOM_STATS=y
CONFIG_DEBUG_FS=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMPD=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_SM_GCC_6115=y
CONFIG_PINCTRL_SM6115=y
CONFIG_INTERCONNECT_QCOM_SM6115=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_REBOOT_MODE=y
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_ARM_SMMU=y
# Stock qtee_shmbridge_init enables SHM bridge; QSEECom shares its DMA buffers.
# CONFIG_QCOM_TZMEM_MODE_GENERIC is not set
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
# no PSCI cpuidle driver: it switches PSCI to OS-initiated mode even with
# cpuidle.off=1 (cpuidle-psci-domain.c)
# CONFIG_ARM_PSCI_CPUIDLE is not set
CONFIG_QCOM_SPMI_ADC5=y
# PMI632 telemetry for Android healthd (sol-pmic, patches 0007-0009): built in,
# OBSERVE mode (no charger/QG writes; firmware keeps charging), exactly one
# write: FV 0x1070 := 0x55 (4.450 V, as stock Linux) only if it reads 0x5a/0x55,
# readback-verified, never retried. pmi632_a9.fv_stock=0 = zero charger writes.
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_PMI632_A9=y
CONFIG_CHARGER_PMI632_A9_TELEMETRY_ONLY=y
CONFIG_CHARGER_PMI632_A9_OBSERVE=y
CONFIG_CHARGER_PMI632_A9_FV_STOCK=y

# USB device mode: dwc3 + QUSB2, configfs gadget with ACM (shell) and NCM (net)
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_SERIAL=y
# test only (QEMU smoke test of the gadget script); never loaded on the phone
CONFIG_USB_DUMMY_HCD=m

# logs: pstore/ramoops on the stock ramoops region (DT). Kept only across a WARM
# reset (reboot=warm); the A9 normally resets with PS_HOLD = hard reset and
# loses DDR. The reliable channel is the PON reboot-reason beacon (qcom-pon
# patch 0004, qcom_pon.beacon=2 on the command line).
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# plain records: the stock 4.19 kernel must be able to read them (no deflate)
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y

# initramfs only: the image never mounts storage. UFS/SDHCI stay disabled in the DT.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# belt and braces: no storage host drivers at all
# CONFIG_SCSI_UFS_QCOM is not set
# CONFIG_MMC_SDHCI_MSM is not set

# E Ink stack: MODULES, loaded only by the initramfs when a9.eink=1 (see README).
CONFIG_DRM=m
CONFIG_DRM_MSM=m
# display clock controller: needed by MDSS, loaded with msm (a9-eink load core)
CONFIG_SM_DISPCC_6115=m
CONFIG_DRM_TOSHIBA_TC358767=m
CONFIG_DRM_PANEL_HISENSE_HLTE556N_EINK=m
# a9_eink: the E Ink display (824x1648) with the in-kernel software TCON
# (scripts/mainline/eink, patches 0010-0013). Sends nothing unless
# a9_eink.enable=1 at runtime; needs the waveform firmware, which is vendor
# data and NOT in this image (docs/mainline-eink-driver.md).
CONFIG_DRM_A9_EINK=m
# FP9929A is built in ON PURPOSE: in the default boot it only runs the stock
# power-DOWN sequence if the bootloader left the rails up, and refuses power-up.
CONFIG_REGULATOR_FP9929A=y
CONFIG_HWMON=y
# no fbdev emulation: nothing may modeset the E Ink pipeline except the TCON
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
