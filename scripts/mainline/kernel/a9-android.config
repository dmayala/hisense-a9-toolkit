# a9-android.config -- OPT-IN fragment (build.sh applies it only with A9_ANDROID=1),
# merged AFTER arm64 defconfig + a9.config. 2026-10-14. Goal: let the mainline
# 7.2.10 kernel run the LineageOS 23.2 (Android 16 QPR2) GSI with a new vendor.
# Status: config-only, compile-tested, NOT boot-tested.
#
# The diskless debug image (no A9_ANDROID) is unaffected. This fragment is config
# only: it builds storage and filesystem DRIVERS, but nothing is probed unless the
# Android DTS enables the UFS nodes, and nothing is mounted unless an fstab says so.
#
# Sources: android-base.config / android-base-conditional.xml (android16-6.12, as
# carried in the GSI's compatibility_matrix.202504.xml <kernel version="6.12.0">),
# NetBpfLoad (lineage-23.2) gates, GSI init.rc / cgroups.json.
# Requirements that mainline 7.2 cannot meet are listed at the bottom.

# ------------------------------------------------------------------- binder
# servicemanager / hwservicemanager / vndservicemanager (all critical). init.rc
# mounts binderfs at /dev/binderfs and symlinks the three devices from it.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# ASHMEM was removed upstream (5.18). Android 16 uses memfd (libcutils ashmem
# over memfd); needs MEMFD_CREATE (selected by SHMEM/TMPFS).
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
# ... but A16 libcutils still opens /dev/ashmem unless the kernel answers
# ASHMEM_GET_SIZE on a memfd (ACK-only shim): system_server died 27x with
# "Failed to create ashmem" (2026-10-15). Patch 0020 carries the ACK legacy
# C driver as drivers/misc/ashmem.
CONFIG_ASHMEM=y

# ------------------------------------------------------------------ SELinux
# second-stage init loads the split policy into selinuxfs; without SELinux init
# aborts in SelinuxSetup. logd reads AVC denials from the audit netlink socket.
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
# keeps "enforcing=0" possible on the command line for bring-up
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
# the defconfig LSM order does contain selinux, but pin it (apparmor/smack/tomoyo
# would otherwise compete for the exclusive slot if a defconfig ever enables them)
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,bpf"
# key retention (fscrypt v1 legacy keyrings, keystore paths)
CONFIG_KEYS=y

# ------------------------------------------------- first-stage mount (super)
# first-stage init maps system/vendor/product/system_ext out of super with
# dm-linear BEFORE any module could be loaded from them: dm built in.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_UEVENT=y
# apexd: dm-verity for APEX payloads (and avb hashtree if ever enabled)
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
# Virtual A/B snapshots (snapuserd); dm-user is ACK-only (see bottom)
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_CRYPT=y
# APEX payloads are loop-mounted
CONFIG_BLK_DEV_LOOP=y
# The block device that holds super: UFS (LUN0) with ICE. a9.config turns
# SCSI_UFS_QCOM off for the diskless image; this fragment turns it back on.
# The DT still decides: ufs_mem_hc / ufs_mem_phy stay disabled in the debug DTS.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_QCOM_INLINE_CRYPTO_ENGINE=y
CONFIG_BLK_INLINE_ENCRYPTION=y

# -------------------------------------------------------------- filesystems
# GSI system is ext4; vendor may be erofs; userdata on the A9 is f2fs with
# inlinecrypt (driver only -- never mount the daily-driver userdata from here).
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_POSIX_ACL=y
# vold: FBE (fscrypt v2 + inline crypto), fs-verity for APKs (verity_tool, PackageManager)
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_FS_VERITY=y
# /storage/emulated (MediaProvider) is FUSE; init.rc mounts fusectl
CONFIG_FUSE_FS=y
# overlayfs: phh/TrebleDroid GSI scripts and adb remount
CONFIG_OVERLAY_FS=y
# vold quota for /data (installd storage stats)
CONFIG_QUOTA=y
CONFIG_QUOTACTL=y
CONFIG_QFMT_V2=y
# boot ramdisk / recovery
CONFIG_RD_LZ4=y
# /data on RAM for bring-up without touching userdata
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# ------------------------------------------------------------- lmkd / memory
# lmkd (critical) uses PSI monitors; ART concurrent-compacting GC uses userfaultfd
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_USERFAULTFD=y
CONFIG_KFENCE=y

# -------------------------------------------------------------------- cgroups
# /system/etc/cgroups.json: v1 cpu (/dev/cpuctl), cpuset (/dev/cpuset), blkio,
# plus v2 at /sys/fs/cgroup (freezer, memory). Since 6.12 a v1 cpuset mount
# needs CPUSETS_V1; memcg v1 for the memory.* files lmkd/ActivityManager touch.
CONFIG_CGROUPS=y
CONFIG_CPUSETS=y
CONFIG_CPUSETS_V1=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
# CONFIG_RT_GROUP_SCHED is not set
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_BLK_CGROUP=y
CONFIG_MEMCG=y
CONFIG_MEMCG_V1=y
CONFIG_CGROUP_BPF=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# ---------------------------------------------------------------------- BPF
# netbpfload (Tethering APEX, reboot_on_failure): writes
# /proc/sys/net/core/bpf_jit_enable + bpf_jit_kallsyms (exit 24/25 if missing),
# kernel >= 5.10 and 64-bit (7.2 passes; "not LTS" is only a warning).
# netd / system_server: cgroup_skb, cgroup_sock, sched_cls, xt_bpf programs.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
# netbpfload writes unprivileged_bpf_disabled=0; from the default 2 that works
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
# tracepoint programs (memevents, gpu_mem, timeInState) + tracefs (init.rc, perfetto)
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_BPF_EVENTS=y
CONFIG_TRACE_GPU_MEM=y

# -------------------------------------------------------------- USB / adb
# adbd uses FunctionFS through the configfs gadget (ACM/NCM stay from a9.config)
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_CONFIGFS_FS=y

# ------------------------------------------------- graphics / buffers (gralloc)
# minigbm / codec2 allocate from dma-heaps (no ION upstream); fences via sync_file.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_UDMABUF=y
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y
# SurfaceFlinger needs a KMS device before /vendor modules: DRM core + VKMS built
# in (software composition). DRM_MSM / tc358767 / E Ink panel stay modules
# exactly as in a9.config, so the E Ink gates are unchanged.
CONFIG_DRM=y
CONFIG_DRM_VKMS=y

# ------------------------------------------------------- input / HID / misc
# uinput (adb input, Bluetooth HID), uhid/hidraw (matrix, BT HID host)
CONFIG_INPUT_EVDEV=y
# touch: Atmel maXTouch mXT336U on i2c2 (4a88000). Built in, not in the vendor
# module set; runs from the controller's stored config (maxtouch.cfg is asked
# for once with request_firmware_nowait, absent = config kept). i2c2's SE is
# GSI-only (FIFO_IF_DISABLE), so the GPI DMA engine must be there at probe:
# built in, as I2C_QCOM_GENI is (android DT enables gpi_dma0 and i2c2 dmas).
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_INPUT_UINPUT=y
CONFIG_UHID=y
CONFIG_HIDRAW=y
CONFIG_HID_GENERIC=y
# gamepads (VINTF matrix: Bluetooth/USB controllers work out of the box)
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
# system_suspend writes /sys/power/wake_lock; suspend is off by default via HAL
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
# AlarmManager: CLOCK_*_ALARM needs an RTC with alarm support (PM6125 RTC)
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ=y
# tun: VpnService, clatd; veth/dummy/ifb: netd, tethering offload tests
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_IFB=y
# misc syscalls bionic/init/libprocessgroup expect
CONFIG_ADVISE_SYSCALLS=y
CONFIG_AIO=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_MEMBARRIER=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_POSIX_MQUEUE=y
CONFIG_TASKSTATS=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_PROFILING=y
CONFIG_SCHEDSTATS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# pstore: logcat/pmsg survive warm resets (a9.config already sets PSTORE_PMSG)
CONFIG_PSTORE=y
CONFIG_PSTORE_PMSG=y

# ------------------------------------------------------------ networking (netd)
# netd programs iptables/ip6tables (LEGACY x_tables flavour) at start; missing
# tables = no app networking. 7.2 hides the whole legacy family behind the
# *_LEGACY symbols: without them every IP_NF_* line below is silently dropped.
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_IPV6_MIP6=y
CONFIG_IPV6_VTI=y
CONFIG_NET_IPVTI=y
CONFIG_NET_IPGRE_DEMUX=y
# SOCK_DESTROY: netd kills sockets of networks that go away
CONFIG_INET_DIAG_DESTROY=y
CONFIG_INET_UDP_DIAG=y
# IPsec (IKEv2 VPN, IWLAN): xfrm
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_INET6_IPCOMP=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_INTERFACE=y
CONFIG_XFRM_MIGRATE=y
CONFIG_XFRM_STATISTICS=y
CONFIG_NET_KEY=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_SECMARK=y
CONFIG_NF_CONNTRACK_AMANDA=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_H323=y
CONFIG_NF_CONNTRACK_IRC=y
CONFIG_NF_CONNTRACK_NETBIOS_NS=y
CONFIG_NF_CONNTRACK_PPTP=y
CONFIG_NF_CONNTRACK_SANE=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_CT_PROTO_SCTP=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_HELPER=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_U32=y
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_SECMARK=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_MATCH_ECN=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP_NF_MATCH_TTL=y
CONFIG_IP_NF_ARPTABLES=y
CONFIG_IP_NF_ARPFILTER=y
CONFIG_IP_NF_ARP_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y
# matrix: no ip6 NAT
# CONFIG_IP6_NF_NAT is not set
# traffic control (netd bandwidth / tethering offload, clatd)
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_U32=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_MIRRED=y

# ------------------------------------------------------------------ crypto
# matrix base list; IPsec (gcm/chachapoly/xcbc/cmac), fscrypt (cts/xts/hctr2/adiantum)
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_XCBC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_HCTR2=y
CONFIG_CRYPTO_ADIANTUM=y

# ---------------------------------------------- hardening (VINTF matrix only)
# Checked by the VINTF kernel matrix (non-fatal at boot), cheap to satisfy.
CONFIG_EXPERT=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_VMAP_STACK=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_ARM64_SW_TTBR0_PAN=y
# 32-bit compat: Android 16 arm64 GSI is 64-bit only, but the matrix wants these
CONFIG_COMPAT=y
CONFIG_ARMV8_DEPRECATED=y
CONFIG_SWP_EMULATION=y
CONFIG_CP15_BARRIER_EMULATION=y
CONFIG_SETEND_EMULATION=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
# matrix wants these OFF
# CONFIG_DEVMEM is not set
# CONFIG_FHANDLE is not set
# CONFIG_FW_CACHE is not set
# CONFIG_SYSVIPC is not set
# CONFIG_USELIB is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_MODULE_FORCE_UNLOAD is not set
# CONFIG_PM_AUTOSLEEP is not set
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# ------------------------------------------------- size diet (ABL window)
# Everything above grows the Image past the ABL load window (MEASURED: image_size
# 37,814,272 > 36,024,320 without this block; 30,015,488 with it, Image.gz
# 11,769,978, 2026-10-14). Drop what arm64 defconfig builds
# in for other machines: no ACPI (matrix: OF=y suffices), no PCIe/SATA/MTD/Xen on
# SM6115, and the clock/pinctrl/interconnect drivers of every other Qualcomm SoC
# (GCCs that other SoCs' =m clock drivers select become =m: not in the Image).
# CONFIG_ACPI is not set
# CONFIG_PCI is not set
# CONFIG_ATA is not set
# CONFIG_MTD is not set
# CONFIG_XEN is not set
# CONFIG_PINCTRL_MAX77620 is not set
# CONFIG_PINCTRL_SINGLE is not set
