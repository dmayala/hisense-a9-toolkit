 		min(READ_ONCE(pg_settle_ms), A9_PG_SETTLE_MAX_MS), READ_ONCE(pg_settle_budget),
 		d->settle_n, d->settle_ok, d->settle_timeout, d->settle_skip,
 		d->settle_hist[0], d->settle_hist[1], d->settle_hist[2], d->settle_hist[3],
-		d->settle_hist[4], d->settle_max_us);
+		d->settle_hist[4], d->settle_max_us,
+		READ_ONCE(pg_settle_total_max), d->settle_cap_skip, d->settle_reread_high);
 	n += sysfs_emit_at(buf, n, "pd_total %llu pd_missed %llu pd_skipped_fault %llu pd_seen_seq %llu"
 		" (newest first)\n",
 		d->pd_total, d->pd_missed, d->pd_skipped_fault, d->pd_seen_seq);
@@ -1340,7 +1353,7 @@ static void a9_diag_pd_push(struct a9_eink *a9, const struct fp9929a_pd_trace *t
  * pipeline is still on (an aborted or faulted waveform has already powered
  * down: nothing to read).
  */
-static void a9_diag_wf_end(struct a9_eink *a9)
+static s64 a9_diag_wf_end(struct a9_eink *a9)
 {
 	struct fp9929a_status st;
 	unsigned long flags;
@@ -1353,7 +1366,7 @@ static void a9_diag_wf_end(struct a9_eink *a9)
 		spin_lock_irqsave(&a9->diag.lock, flags);
 		a9->diag.end_skipped++;
 		spin_unlock_irqrestore(&a9->diag.lock, flags);
-		return;
+		return 0;
 	}
 	ret = a9_hv_sample(a9, &st);
 	up_ms = ktime_to_ms(ktime_get());
@@ -1390,6 +1403,8 @@ static void a9_diag_wf_end(struct a9_eink *a9)
 			a9->session.id, up_ms, first);
 	if (!ret)
 		a9_diag_pd_push(a9, &st.pdtrace);
+	/* M4: the time of a plain low reading, the settle clock origin (0 = none) */
+	return low && st.pg_at_us > 0 ? st.pg_at_us : 0;
 }
 
 /*
@@ -1414,13 +1429,21 @@ static void a9_diag_wf_end(struct a9_eink *a9)
 static enum a9_settle a9_pg_settle(struct a9_eink *a9, int ret, const struct fp9929a_status *st)
 {
 	unsigned int win = min(READ_ONCE(pg_settle_ms), A9_PG_SETTLE_MAX_MS);
-	ktime_t t0 = ktime_get(), tg = 0;
+	ktime_t now = ktime_get(), t0, tg = 0;
+	s64 first_us = a9->settle_first_us;
 	struct fp9929a_status s2;
 	unsigned long flags;
 	unsigned int good = 0, b;
 	enum a9_settle res = A9_SETTLE_TIMEOUT;
 	u64 us;
 
+	/* M4 (review 89 F2): the window and the reported duration count from the
+	 * FIRST low reading (the wf-end path hands over the 0052 read's time; any
+	 * other caller's first low reading is this sample), not from entry here. */
+	a9->settle_first_us = 0;
+	if (!first_us)
+		first_us = st->pg_at_us;
+	t0 = first_us > 0 && first_us <= ktime_to_us(now) ? us_to_ktime(first_us) : now;
 	if (!win || ret || !st->on || !st->pg_valid || st->pg_good || st->forced_off || st->emergency)
 		return A9_SETTLE_NO;
 	if (!a9->wf_end || ktime_ms_delta(t0, a9->wf_end) > win)
@@ -1435,6 +1458,12 @@ static enum a9_settle a9_pg_settle(struct a9_eink *a9, int ret, const struct fp9
 		spin_unlock_irqrestore(&a9->diag.lock, flags);
 		return A9_SETTLE_NO;
 	}
+	if (a9->settle_total >= READ_ONCE(pg_settle_total_max)) {	/* M4 D1: per-boot cap */
+		spin_lock_irqsave(&a9->diag.lock, flags);
+		a9->diag.settle_cap_skip++;
+		spin_unlock_irqrestore(&a9->diag.lock, flags);
+		return A9_SETTLE_NO;
+	}
 	for (;;) {
 		int r2;
 
@@ -1472,9 +1501,12 @@ static enum a9_settle a9_pg_settle(struct a9_eink *a9, int ret, const struct fp9
 	spin_unlock_irqrestore(&a9->diag.lock, flags);
 	if (res == A9_SETTLE_OK) {
 		a9->settle_used++;
+		a9->settle_total++;
 		dev_warn_ratelimited(a9->dev, "pg-settle: PG low after a waveform came back in %llu us"
-			" (recovered dip %u of %u this session; not a fault)\n",
-			us, a9->settle_used, READ_ONCE(pg_settle_budget));
+			" from the first low reading (recovered dip %u of %u this session, %u of %u this boot;"
