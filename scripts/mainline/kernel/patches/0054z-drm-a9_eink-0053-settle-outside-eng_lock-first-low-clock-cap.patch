 /*
- * Patch 0053: the waveform-end read. Only when pg_settle_ms is set and only for
- * a plain PG low (read errors, forced/emergency and everything else keep the
- * 0052 behaviour: recorded by the diag read, decided by the next sample).
- * Returns true when the pipeline was latched and powered down.
+ * Patch 0053: the waveform-end read, split by M4 (review 89 section 2) so that
+ * no settle, latch or power-off runs under eng_lock (fix-0040 / review 22).
+ *
+ * a9_pg_wf_end_low(), under eng_lock: only when pg_settle_ms is set, one read;
+ * true for a plain PG low (read errors, forced/emergency and everything else
+ * keep the 0052 behaviour: recorded, decided by the next sample). first_us is
+ * the 0052 read's low time (0 if that read was not low): a low there that is
+ * high again here is counted (reread_high) and not settled.
  */
-static bool a9_pg_wf_end(struct a9_eink *a9)
+static bool a9_pg_wf_end_low(struct a9_eink *a9, s64 first_us, struct fp9929a_status *st)
 {
-	struct fp9929a_status st;
+	unsigned long flags;
 	int ret;
 
 	if (!READ_ONCE(pg_settle_ms) || !READ_ONCE(a9->tx.on))
 		return false;
-	ret = a9_hv_sample(a9, &st);
-	if (ret || !st.on || !st.pg_valid || st.pg_good)
+	ret = a9_hv_sample(a9, st);
+	if (ret || !st->on || !st->pg_valid || st->pg_good) {
+		if (first_us && a9_hv_good(ret, st)) {
+			spin_lock_irqsave(&a9->diag.lock, flags);
+			a9->diag.settle_reread_high++;
+			spin_unlock_irqrestore(&a9->diag.lock, flags);
+		}
 		return false;
-	return a9_check_rail_sample(a9, true, ret, &st) != 0;
+	}
+	a9->settle_first_us = first_us;	/* consumed by a9_pg_settle */
+	return true;
+}
+
+/*
+ * After the update's mutex_unlock(&a9->eng_lock): settle the low sampled
+ * above, or latch from it exactly as any other rail sample (ordered
+ * power-off, report). Returns true when latched.
+ */
+static bool a9_pg_wf_end(struct a9_eink *a9, const struct fp9929a_status *st)
+{
+	return a9_check_rail_sample(a9, true, 0, st) != 0;
 }
 
