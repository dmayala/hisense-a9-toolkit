 	bool *init_pending = dry ? &a9->dry_init_pending : &a9->init_pending;
 	bool *force_clear = dry ? &a9->dry_force_clear : &a9->force_clear;
 	struct sha256_ctx sc;
-	struct fp9929a_status st;
-	bool was_on;
+	struct fp9929a_status st, pg_st;
+	bool was_on, pg_low = false;
 	ktime_t t0 = ktime_get();
 	unsigned int zt = READ_ONCE(zero_test);
 	bool prepared = false, init_white = false;
@@ -2092,6 +2145,7 @@ static void __a9_update(struct a9_eink *a9, const struct a9_job *job)
 	if (!dry) {
 		/* render-ahead: init flash (if pending) + update, in one sequence */
 		bool init_shown = false;
+		s64 pg_first;
 
 		if (hash)
 			sha256_init(&sc);
@@ -2099,9 +2153,9 @@ static void __a9_update(struct a9_eink *a9, const struct a9_job *job)
 		ret = a9_run_ring(a9, init_white, bin, hash ? &sc : NULL, &init_shown);
 		a9->wf_end = ktime_get();	/* rail-fault diagnosis (0039) */
 		a9->wf_ret = ret;
-		a9_diag_wf_end(a9);	/* 0052: one recorded, never-acted-on PG read */
-		if (!ret && a9_pg_wf_end(a9))	/* 0053: opt-in settle; latched = abort */
-			ret = -EIO;
+		pg_first = a9_diag_wf_end(a9);	/* 0052: one recorded, never-acted-on PG read */
+		/* 0053 (M4): sample only under eng_lock; settle/latch after the unlock */
+		pg_low = !ret && a9_pg_wf_end_low(a9, pg_first, &pg_st);
 		if (init_shown)
 			*init_pending = false;
 		if (ret)
@@ -2158,6 +2212,12 @@ static void __a9_update(struct a9_eink *a9, const struct a9_job *job)
 		a9e_inc_invalidate(&a9->e);
 	}
 	mutex_unlock(&a9->eng_lock);
+	/* 0053 (M4): the waveform completed and its history is committed; a low
+	 * sampled at its end is settled or latched here, outside eng_lock. A latch
+	 * counts as an abort (session stops) and owes a full Clear (a9_rail_fault
+	 * sets force_clear after the success path cleared it above). */
+	if (pg_low && a9_pg_wf_end(a9, &pg_st))
+		a9->aborts++;
 	return;
 
 abort:
