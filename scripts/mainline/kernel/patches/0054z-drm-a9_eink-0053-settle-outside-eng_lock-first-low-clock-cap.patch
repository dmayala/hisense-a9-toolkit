 MODULE_PARM_DESC(pg_settle_budget, "Recovered PG dips allowed per HV session before the next low latches at once (default 3; 0 = never settle)");
 
+/*
+ * M4 (review 89 D1): cumulative cap on recovered dips per boot. Once used up,
+ * every later low latches at once, as with pg_settle_ms 0 (counted in
+ * diag_settle cap_skip). Default 30: above the next-R0 session stop at 25
+ * recovered dips per boot (S4), so the script stops first and this is the
+ * backstop; about 1.5x the 20-dip evidence goal. Not a daily-use tuning.
+ */
+static unsigned int pg_settle_total_max = 30;
+module_param(pg_settle_total_max, uint, 0644);
+MODULE_PARM_DESC(pg_settle_total_max, "Recovered PG dips allowed per boot (all HV sessions) before every later low latches at once (default 30; 0 = never settle)");
+
 static unsigned int hv_max_ms = 60000;
 module_param(hv_max_ms, uint, 0644);
 MODULE_PARM_DESC(hv_max_ms, "Power down between updates after this much continuous HV-on time; stock has no cap, 33 s seen (default 60000)");
