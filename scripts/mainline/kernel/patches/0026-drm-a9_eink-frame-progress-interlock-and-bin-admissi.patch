+ * zero commit at power-down, drops the FP9929A rails from hardirq context
+ * (fp9929a_emergency_off), sets enable = 0 and latches a fault: updates are
+ * refused until 1 is written to a9_eink.clear_fault (and fp9929a.clear_fault
+ * for the PMIC). Real updates also run only inside the temperature-bin
+ * window a9_eink.bin_min..bin_max (default 0..13), checked before power-up
+ * and again, with the fresh samples, before the first frame.
  *
  * Userspace control ABI (docs/mainline-eink-compat.md): the connector's
  * "eink" sysfs group: mode (513/515/518/521, default 518), black_threshold,
@@ -421,11 +429,11 @@ static ssize_t status_show(struct device *kdev, struct device_attribute *attr, c
 	struct a9x_transport *t = &a9->tx;
 
 	return sysfs_emit(buf,
-		"enable %d waveform %d transport %d hv_on %d\n"
+		"enable %d waveform %d transport %d hv_on %d stall_fault %d\n"
 		"updates %llu aborts %llu frames %llu late %llu vbl_skips %llu commit_fail %llu max_gap_us %u\n"
 		"last mode %#x pre %#x clear %d type %u bin %d t1 %d t2 %d frames %u steps %u dry %d aborted %d"
 		" rect %d,%d-%d,%d begin_us %u total_us %u\n",
-		enable, a9->wf_loaded, a9x_attached(t), t->on,
+		enable, a9->wf_loaded, a9x_attached(t), t->on, atomic_read(&a9x_stall_fault),
 		a9->updates, a9->aborts, t->frames, t->late, t->vbl_skips, t->commits_failed,
 		t->max_gap_us, a9->last.mode, a9->last.pre, a9->last.clear, a9->last.type,
 		a9->last.bin, a9->last.t1, a9->last.t2, a9->last.frames, a9->last.steps,
@@ -537,6 +545,12 @@ static bool a9_hv_maybe_on(struct a9_eink *a9)
 	return fp9929a_get_status(a9->pmic_np, &st) || st.on;
 }
 
+/* transport fault (hardirq, from the interlock): stop the worker's waveform */
+static void a9_tx_fault(struct a9x_transport *t)
+{
+	WRITE_ONCE(enable, false);
+}
+
 /* ---- pipeline power ------------------------------------------------------------- */
 static void a9_force_hv_off(struct a9_eink *a9, const char *why)
 {
@@ -569,6 +583,9 @@ static int a9_power_on(struct a9_eink *a9)
 {
 	int ret;
 
+	if (atomic_read(&a9x_stall_fault))
+		return -EIO;	/* frame-progress fault latched: a9_eink.clear_fault */
+
 	if (a9->hv_fault) {
 		a9_power_off(a9);
 		if (a9->hv_fault)
@@ -643,8 +660,14 @@ static void a9_update(struct a9_eink *a9, const struct a9_job *job)
 	bool *force_clear = dry ? &a9->dry_force_clear : &a9->force_clear;
 	struct sha256_ctx sc;
 	ktime_t t0 = ktime_get();
-	int t1, t2, bin, ret, steps;
+	unsigned int zt = READ_ONCE(zero_test);
+	int t1, t2, bin, ret, steps, lo, hi;
 
+	if (atomic_read(&a9x_stall_fault)) {
+		dev_err_ratelimited(a9->dev, "update refused: frame-progress fault latched (write 1 to a9_eink.clear_fault)\n");
+		a9->aborts++;
+		return;
+	}
 	/* attaching only looks the msm card up and allocates buffers: also done in
 	 * a dry run, so the transport side can be checked without any commit */
 	if (!a9x_attached(&a9->tx)) {
@@ -652,6 +675,23 @@ static void a9_update(struct a9_eink *a9, const struct a9_job *job)
 		if (ret && ret != -EAGAIN)
 			dev_warn_ratelimited(a9->dev, "transport attach: %d\n", ret);
 	}
+	if (!dry && !zt) {
+		/*
+		 * Bin admission before any power-up: t1 is the PREVIOUS power-up's
+		 * TMST sample (temp_fallback if none), t2 the fresh thermistor.
+		 * The fresh TMST is checked again after power-up, before a frame.
+		 */
+		a9_temps(a9, &t1, &t2);
+		mutex_lock(&a9->eng_lock);
+		bin = a9t_temp_bin(&a9->e.st, t1, t2);
+		mutex_unlock(&a9->eng_lock);
+		if (!a9_bin_admitted(bin, &lo, &hi)) {
+			dev_err(a9->dev, "bin %d outside [%d,%d] before power-up (t1 %d from the previous power-up, t2 %d): update refused\n",
+				bin, lo, hi, t1, t2);
+			a9->aborts++;
+			return;
+		}
+	}
 	if (!dry) {
 		ret = a9_power_on(a9);
 		if (ret) {
@@ -671,8 +711,8 @@ static void a9_update(struct a9_eink *a9, const struct a9_job *job)
 		return;
 	}
 
-	if (!dry && READ_ONCE(zero_test)) {
-		unsigned int i, n = min(READ_ONCE(zero_test), 850U);	/* <= 10 s at 85 Hz */
+	if (!dry && zt) {
+		unsigned int i, n = min(zt, 850U);	/* <= 10 s at 85 Hz */
 
 		memset(a9->frame, 0, A9T_FRAME_BYTES);
 		for (i = 0; i < n; i++) {
@@ -713,6 +753,24 @@ static void a9_update(struct a9_eink *a9, const struct a9_job *job)
 		a9->dry_save_have_pre = a9->e.have_pre;
 	}
 	bin = a9t_temp_bin(&a9->e.st, t1, t2);
+	/* bin admission with this power-up's samples, before any frame */
+	if (!a9_bin_admitted(bin, &lo, &hi)) {
+		if (dry) {
+			dev_info(a9->dev, "dry run: bin %d outside [%d,%d]: a real update would be refused\n",
+				 bin, lo, hi);
+		} else {
+			a9->last.bin = bin;
+			a9->last.t1 = t1;
+			a9->last.t2 = t2;
+			a9->last.frames = 0;
+			a9->last.aborted = 1;
+			mutex_unlock(&a9->eng_lock);
+			dev_err(a9->dev, "bin %d outside [%d,%d]: update refused\n", bin, lo, hi);
+			a9->aborts++;
+			a9_power_off(a9);
+			return;
+		}
+	}
 	if (*init_pending) {
 		a9e_begin_init(&a9->e, bin);
 		ret = a9_run_frames(a9, dry, NULL);
@@ -1064,6 +1122,8 @@ static int a9_probe(struct platform_device *pdev)
 	a9->tx.wq = &a9->wq;
 	a9->tx.fourcc = strcmp(f, "XB24") ? DRM_FORMAT_XRGB8888 : DRM_FORMAT_XBGR8888;
 	mutex_init(&a9->tx.lock);
+	a9->tx.fault = a9_tx_fault;
+	a9x_init(&a9->tx);
 
 	a9->tables = a9_vzalloc(dev, sizeof(*a9->tables));
 	a9->shadow = a9_vzalloc(dev, A9T_N);
@@ -1137,6 +1197,7 @@ static void a9_teardown(struct a9_eink *a9)
 		a9->thread = NULL;
 	}
 	a9x_detach(&a9->tx);
+	a9x_fini(&a9->tx);
 }
 
 static void a9_remove(struct platform_device *pdev)
diff --git a/drivers/gpu/drm/a9_eink/a9_eink_guard.c b/drivers/gpu/drm/a9_eink/a9_eink_guard.c
new file mode 100644
index 000000000..a2fd1e2a6
--- /dev/null
+++ b/drivers/gpu/drm/a9_eink/a9_eink_guard.c
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * a9_eink guards that do not need the DRM side: the frame-progress fault
+ * latch with its clear_fault parameter, and the temperature-bin admission
+ * window (bin_min/bin_max). Separate so the host test harness
+ * (tests/mainline-a9eink-stall in the A9 repo) compiles exactly this code.
+ */
+#include <linux/atomic.h>
+#include <linux/kernel.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
+#include <linux/printk.h>
+
+#include "a9_eink.h"
+
+atomic_t a9x_stall_fault = ATOMIC_INIT(0);
+
+static int a9_clear_fault_set(const char *val, const struct kernel_param *kp)
+{
+	bool clear;
+	int ret = kstrtobool(val, &clear);
+
+	if (ret)
+		return ret;
+	if (clear && atomic_xchg(&a9x_stall_fault, 0))
+		pr_info("a9_eink: frame-progress fault cleared (clear_fault)\n");
+	return 0;
+}
+
+static const struct kernel_param_ops a9_clear_fault_ops = {
+	.set = a9_clear_fault_set,
+};
+module_param_cb(clear_fault, &a9_clear_fault_ops, NULL, 0200);
+MODULE_PARM_DESC(clear_fault,
+		 "Write 1 to clear a latched frame-progress fault (write-only); the FP9929A's own fp9929a.clear_fault is separate");
+
+/*
+ * Temperature-bin admission (review 7 finding 2): a real waveform update runs
+ * only if its bin is in [bin_min, bin_max]; checked before power-up (previous
+ * FP9929A sample + fresh thermistor) and again after it (fresh samples),
+ * before any frame. 0..13, bin_min <= bin_max (a write that would invert the
+ * window is refused: narrow by raising bin_min last, widen by bin_max first).
+ */
+static int bin_min;
+static int bin_max = A9T_BINS - 1;
+static DEFINE_MUTEX(a9_bin_lock);
+
+static int a9_bin_set(const char *val, const struct kernel_param *kp)
+{
+	int v, ret = kstrtoint(val, 0, &v);
+
+	if (ret)
+		return ret;
+	if (v < 0 || v > A9T_BINS - 1)
+		return -EINVAL;
+	mutex_lock(&a9_bin_lock);
+	if (kp->arg == &bin_min ? v > READ_ONCE(bin_max) : v < READ_ONCE(bin_min))
+		ret = -EINVAL;
+	else
+		WRITE_ONCE(*(int *)kp->arg, v);
+	mutex_unlock(&a9_bin_lock);
+	return ret;
+}
+
+static const struct kernel_param_ops a9_bin_ops = {
+	.set = a9_bin_set,
+	.get = param_get_int,
+};
+module_param_cb(bin_min, &a9_bin_ops, &bin_min, 0644);
+MODULE_PARM_DESC(bin_min, "Lowest temperature bin a real update may run at (0..13, default 0)");
+module_param_cb(bin_max, &a9_bin_ops, &bin_max, 0644);
+MODULE_PARM_DESC(bin_max, "Highest temperature bin a real update may run at (0..13, default 13)");
+
+bool a9_bin_admitted(int bin, int *lo, int *hi)
+{
+	*lo = READ_ONCE(bin_min);
+	*hi = READ_ONCE(bin_max);
+	return bin >= *lo && bin <= *hi;
+}
diff --git a/drivers/gpu/drm/a9_eink/a9_eink_transport.c b/drivers/gpu/drm/a9_eink/a9_eink_transport.c
index cda450c24..f436203c0 100644
--- a/drivers/gpu/drm/a9_eink/a9_eink_transport.c
+++ b/drivers/gpu/drm/a9_eink/a9_eink_transport.c
@@ -17,10 +17,24 @@
  * a9_eink card is given to the composer). If it does, our commits fail with
  * -EBUSY and the update is aborted; power-off then falls back to forcing the
  * FP9929A down (a9_eink_drv.c).
+ *
+ * Frame-progress interlock (review 7 finding 3): while a drive (non-null)
+ * frame may be on the glass and no newer commit has started, an hrtimer runs
+ * with a deadline of A9X_STALL_FRAMES frame periods. It is (re)armed BEFORE
+ * every commit of a drive frame and cancelled only after a successful commit
+ * of an all-zero one. If the worker stops computing, a commit blocks in
+ * drm_client_modeset_commit() (holding t->lock and DRM locks), or a frame is
+ * late, it expires in hardirq context and, without any lock, drops the
+ * FP9929A rails (fp9929a_emergency_off: VCOM-EN at once, PWRUP 50 ms later),
+ * latches a9x_stall_fault and stops the worker (enable := 0). A blank frame
+ * cannot be guaranteed when the commit path is what hangs, so HV removal is
+ * the action; blanking stays the normal (process-context) path.
  */
 #include <linux/delay.h>
 #include <linux/device.h>
+#include <linux/hrtimer.h>
 #include <linux/of.h>
+#include <linux/regulator/fp9929a.h>
 
 #include <drm/drm_atomic.h>
 #include <drm/drm_bridge.h>
@@ -38,7 +52,78 @@
 #define TX_H A9T_TH
 
 static int a9x_power_off_locked(struct a9x_transport *t);
-static int a9x_commit_locked(struct a9x_transport *t, int idx);
+static int a9x_commit_locked(struct a9x_transport *t, int idx, bool null);
+
+static u32 a9x_period_us(struct a9x_transport *t)
+{
+	return t->period_us ? t->period_us : A9X_PERIOD_DEFAULT_US;
+}
+
+static u32 a9x_stall_ms(struct a9x_transport *t)
+{
+	return DIV_ROUND_UP(A9X_STALL_FRAMES * a9x_period_us(t), 1000);
+}
+
+/* hardirq (HRTIMER_MODE_REL_HARD): no locks, no sleeping */
+static enum hrtimer_restart a9x_stall_fn(struct hrtimer *h)
+{
+	struct a9x_transport *t = container_of(h, struct a9x_transport, stall);
+
+	if (!READ_ONCE(t->on))
+		return HRTIMER_NORESTART;
+	fp9929a_emergency_off(t->stall_why);
+	atomic_set(&a9x_stall_fault, 1);
+	WRITE_ONCE(t->stalls, t->stalls + 1);
+	if (t->fault)
+		t->fault(t);
+	dev_crit(t->dev, "%s: FP9929A emergency off, fault latched (a9_eink.clear_fault)\n",
+		 t->stall_why);
+	return HRTIMER_NORESTART;
+}
+
+/* t->lock held: a drive frame is about to be committed */
+static void a9x_stall_arm(struct a9x_transport *t)
+{
+	t->stall_armed = true;
+	hrtimer_start(&t->stall, ns_to_ktime((u64)A9X_STALL_FRAMES * a9x_period_us(t) * 1000),
+		      HRTIMER_MODE_REL_HARD);
+}
+
+/*
+ * t->lock held: an all-zero frame is established. Never waits for a running
+ * callback (it is then firing: the fault is latched either way).
+ */
