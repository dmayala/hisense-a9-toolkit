diff --git a/drivers/gpu/drm/a9_eink/a9_eink_drv.c b/drivers/gpu/drm/a9_eink/a9_eink_drv.c
index 9102319fb..7197589cf 100644
--- a/drivers/gpu/drm/a9_eink/a9_eink_drv.c
+++ b/drivers/gpu/drm/a9_eink/a9_eink_drv.c
@@ -70,6 +70,7 @@
 
 #include <drm/drm_atomic.h>
 #include <drm/drm_atomic_helper.h>
+#include <drm/drm_atomic_uapi.h>
 #include <drm/drm_damage_helper.h>
 #include <drm/drm_drv.h>
 #include <drm/drm_fourcc.h>
@@ -267,7 +268,8 @@ static int a9_crtc_atomic_check(struct drm_crtc *crtc, struct drm_atomic_commit
 	struct drm_crtc_state *cs = drm_atomic_get_new_crtc_state(state, crtc);
 	int ret;
 
-	if (!cs->enable)
+	/* enabled-but-inactive is this CRTC's resting state (fixed mode, below) */
+	if (!cs->active)
 		return 0;
 	ret = drm_atomic_helper_check_crtc_primary_plane(cs);
 	if (ret)
@@ -286,8 +288,55 @@ static const struct drm_crtc_helper_funcs a9_crtc_helper_funcs = {
 	DRM_CRTC_HELPER_VBLANK_FUNCS,
 };
 
+/*
+ * Fixed single-mode CRTC (patch 0032, mainline Android run 6): the composer
+ * (android16-qpr2 drm_hwcomposer) believes the one mode is already set and
+ * commits ACTIVE=1 + FB without MODE_ID or a connector link, which the DRM
+ * core refuses ("active without enabled"). So this CRTC is ENABLED with
+ * a9_mode and linked to its one connector from reset on, and a commit that
+ * would disable it (MODE_ID 0 / connector CRTC_ID 0) is turned into
+ * "inactive, mode and link kept" (a9_mode_config_check). Enabled/active of
+ * THIS virtual card has no power meaning: HV comes up only when the worker
+ * runs a real update (changed pixels, a9_eink.enable and both power gates
+ * open, the same caps, interlock and bin window as before).
+ */
+/*
+ * The fixed mode as a userspace MODE_ID would give it (drm_mode_convert_umode
+ * runs drm_mode_set_crtcinfo): with the derived crtc_* timings, which the
+ * virtual vblank timer and the timestamping constants use (review 12: a raw
+ * DRM_MODE_INIT copy has crtc_clock 0, so the timer would never run).
+ */
+static void a9_fixed_mode(struct drm_display_mode *m)
+{
+	drm_mode_copy(m, &a9_mode);
+	drm_mode_set_crtcinfo(m, 0);
+}
+
+/* cs := enabled with the prepared fixed mode (mode and adjusted_mode), inactive */
+static int a9_set_fixed_mode(struct drm_crtc_state *cs)
+{
+	struct drm_display_mode m;
+	int ret;
+
+	a9_fixed_mode(&m);
+	ret = drm_atomic_set_mode_for_crtc(cs, &m);
+	if (ret)
+		return ret;
+	drm_mode_copy(&cs->adjusted_mode, &m);
+	cs->enable = true;
+	cs->active = false;
+	return 0;
+}
+
+static void a9_crtc_reset(struct drm_crtc *crtc)
+{
+	drm_atomic_helper_crtc_reset(crtc);
+	if (crtc->state)
+		a9_set_fixed_mode(crtc->state);	/* -ENOMEM: stays disabled */
+}
+
 static const struct drm_crtc_funcs a9_crtc_funcs = {
-	.reset = drm_atomic_helper_crtc_reset,
+	.reset = a9_crtc_reset,
 	.destroy = drm_crtc_cleanup,
 	.set_config = drm_atomic_helper_set_config,
 	.page_flip = drm_atomic_helper_page_flip,
@@ -331,9 +380,74 @@ static const struct drm_connector_funcs a9_connector_funcs = {
 	.early_unregister = a9_connector_early_unregister,
 };
 
+/*
+ * Keep the fixed mode and the connector link through every form of "off":
+ * MODE_ID 0 (CRTC disabled) and a connector-only detach (connector CRTC_ID
+ * 0, review 12) both become "inactive, mode and link kept". ACTIVE=0 alone
+ * needs nothing. Runs after the core's own checks (a MODE_ID 0 with ACTIVE
+ * still 1 is refused there, as for any driver). Errors (-EDEADLK included)
+ * are returned for the caller's backoff, as atomic checks do.
+ */
+static int a9_keep_fixed_mode(struct a9_eink *a9, struct drm_atomic_commit *state)
+{
+	struct drm_crtc_state *cs = drm_atomic_get_new_crtc_state(state, &a9->crtc);
+	struct drm_connector_state *conn = drm_atomic_get_new_connector_state(state, &a9->connector);
+	bool detached = conn && conn->crtc != &a9->crtc;
+	int ret;
+
+	/* driver removal: let drm_atomic_helper_shutdown unlink everything, so
+	 * the connector reference of the linked state is released */
+	if (READ_ONCE(a9->kms_teardown))
+		return 0;
+	if (!detached && (!cs || cs->enable))
+		return 0;
+	if (!cs) {
+		cs = drm_atomic_get_crtc_state(state, &a9->crtc);
+		if (IS_ERR(cs))
+			return PTR_ERR(cs);
+	}
+	ret = a9_set_fixed_mode(cs);
+	if (ret)
+		return ret;
+	if (!conn) {
+		conn = drm_atomic_get_connector_state(state, &a9->connector);
+		if (IS_ERR(conn))
+			return PTR_ERR(conn);
+	}
+	/* takes the connector reference a linked state owns, sets connector_mask */
+	return drm_atomic_set_crtc_for_connector(conn, &a9->crtc);
+}
+
+static int a9_mode_config_check(struct drm_device *dev, struct drm_atomic_commit *state)
+{
+	int ret = a9_keep_fixed_mode(to_a9(dev), state);
+
+	return ret ? ret : drm_atomic_helper_check(dev, state);
+}
+
+/* after drm_mode_config_reset(): the connector's reset state routed to the CRTC */
+static void a9_fixed_route(struct a9_eink *a9)
+{
+	struct drm_connector_state *conn = a9->connector.state;
+	struct drm_crtc_state *cs = a9->crtc.state;
+
+	if (!conn || !cs || conn->crtc)
+		return;
+	/*
+	 * A linked connector state owns a connector reference (released by
+	 * __drm_atomic_helper_connector_destroy_state, review 12): take it,
+	 * as drm_atomic_set_crtc_for_connector() would.
+	 */
+	drm_connector_get(&a9->connector);
+	conn->crtc = &a9->crtc;
+	conn->best_encoder = &a9->encoder;
+	cs->connector_mask = drm_connector_mask(&a9->connector);
+	cs->encoder_mask = drm_encoder_mask(&a9->encoder);
+}
+
 static const struct drm_mode_config_funcs a9_mode_config_funcs = {
 	.fb_create = drm_gem_fb_create_with_dirty,
-	.atomic_check = drm_atomic_helper_check,
+	.atomic_check = a9_mode_config_check,
 	.atomic_commit = drm_atomic_helper_commit,
 };
 
@@ -1226,6 +1340,35 @@ static int a9_pipe_init(struct a9_eink *a9)
 	return drm_connector_attach_encoder(&a9->connector, &a9->encoder);
 }
 
+/* KMS objects and their initial (fixed-mode) state; shared with the KUnit test */
+static int a9_kms_init(struct a9_eink *a9)
+{
+	struct drm_device *drm = &a9->drm;
+	int ret;
+
+	drm->mode_config.funcs = &a9_mode_config_funcs;
+	/*
+	 * Any framebuffer size may be created (the composer imports small layer
+	 * buffers, run 6: "bad framebuffer height 49"); the primary plane's
+	 * check (no positioning, no scaling) still requires a full 824x1648
+	 * source on the only plane.
+	 */
+	drm->mode_config.min_width = 1;
+	drm->mode_config.max_width = 4096;
+	drm->mode_config.min_height = 1;
+	drm->mode_config.max_height = 4096;
+	drm->mode_config.preferred_depth = 24;
+	ret = a9_pipe_init(a9);
+	if (ret)
+		return ret;
+	ret = drm_vblank_init(drm, 1);
+	if (ret)
+		return ret;
+	drm_mode_config_reset(drm);
+	a9_fixed_route(a9);
+	return 0;
+}
+
 static int a9_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -1312,19 +1455,9 @@ static int a9_probe(struct platform_device *pdev)
 	ret = drmm_mode_config_init(drm);
 	if (ret)
 		return ret;
-	drm->mode_config.funcs = &a9_mode_config_funcs;
-	drm->mode_config.min_width = A9E_FB_W;
-	drm->mode_config.max_width = A9E_FB_W;
-	drm->mode_config.min_height = A9E_FB_H;
-	drm->mode_config.max_height = A9E_FB_H;
-	drm->mode_config.preferred_depth = 24;
-	ret = a9_pipe_init(a9);
-	if (ret)
-		return dev_err_probe(dev, ret, "pipeline init\n");
-	ret = drm_vblank_init(drm, 1);
+	ret = a9_kms_init(a9);
 	if (ret)
-		return ret;
-	drm_mode_config_reset(drm);
+		return dev_err_probe(dev, ret, "KMS init\n");
 
 	a9->thread = kthread_run(a9_thread, a9, "a9_eink");
 	if (IS_ERR(a9->thread)) {
@@ -1370,6 +1503,7 @@ static void a9_remove(struct platform_device *pdev)
 	drm_dev_unplug(&a9->drm);
 	a9_teardown(a9);
 	debugfs_remove_recursive(a9->dbg);
+	WRITE_ONCE(a9->kms_teardown, true);
 	drm_atomic_helper_shutdown(&a9->drm);
 }
 
@@ -1398,6 +1532,10 @@ static struct platform_driver a9_driver = {
 };
 module_platform_driver(a9_driver);
 
+#if IS_ENABLED(CONFIG_DRM_A9_EINK_KUNIT_TEST)
+#include "a9_eink_kms_test.c"
+#endif
+
 MODULE_FIRMWARE(A9_FW_NAME);
 MODULE_FIRMWARE(A9_CT_NAME);
 MODULE_DESCRIPTION("Hisense A9 E Ink display with in-kernel software TCON");
diff --git a/drivers/gpu/drm/a9_eink/a9_eink_kms_test.c b/drivers/gpu/drm/a9_eink/a9_eink_kms_test.c
new file mode 100644
index 000000000..dbccb4f1d
--- /dev/null
+++ b/drivers/gpu/drm/a9_eink/a9_eink_kms_test.c
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests of the a9_eink KMS state (patches 0032 + review 12), #included
+ * from a9_eink_drv.c so they run the driver's own a9_kms_init(), checks and
+ * commit helpers on a KUnit DRM device. The worker thread is not started and
+ * the msm transport is never attached: a commit may set a9->kick (queued
+ * work), nothing here reaches the transport or any power path.
+ */
+#include <kunit/test.h>
+#include <drm/drm_kunit_helpers.h>
+#include <drm/drm_modeset_helper.h>
+
+static const struct drm_framebuffer_funcs a9t_fb_funcs = {
+	.destroy = drm_gem_fb_destroy,
+};
+
+static void a9t_fb_put(void *fb)
+{
+	drm_framebuffer_put(fb);
+}
+
+static void a9t_kvfree(void *p)
+{
+	kvfree(p);
+}
+
+/* a shmem-backed XRGB8888 framebuffer (what the plane update vmaps) */
+static struct drm_framebuffer *a9t_fb(struct kunit *test, struct a9_eink *a9, u32 w, u32 h)
+{
+	struct drm_mode_fb_cmd2 cmd = { .width = w, .height = h,
+					.pixel_format = DRM_FORMAT_XRGB8888,
+					.pitches = { w * 4 } };
+	struct drm_gem_shmem_object *obj;
+	struct drm_framebuffer *fb;
+
+	obj = drm_gem_shmem_create(&a9->drm, PAGE_ALIGN((size_t)w * 4 * h));
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, obj);
+	fb = kzalloc(sizeof(*fb), GFP_KERNEL);	/* freed by drm_gem_fb_destroy */
+	KUNIT_ASSERT_NOT_NULL(test, fb);
+	fb->obj[0] = &obj->base;
+	drm_helper_mode_fill_fb_struct(&a9->drm, fb, drm_format_info(DRM_FORMAT_XRGB8888), &cmd);
+	KUNIT_ASSERT_EQ(test, drm_framebuffer_init(&a9->drm, fb, &a9t_fb_funcs), 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, a9t_fb_put, fb), 0);
+	return fb;
+}
+
+/* as a9_remove: a real disable before the device goes (releases the
+ * connector, vblank and shadow-plane references; any leak WARNs) */
+static void a9t_shutdown(void *p)
+{
+	struct a9_eink *a9 = p;
+
+	WRITE_ONCE(a9->kms_teardown, true);
+	drm_atomic_helper_shutdown(&a9->drm);
+}
+
+static struct a9_eink *a9t_dev(struct kunit *test)
+{
+	struct device *dev = drm_kunit_helper_alloc_device(test);
+	struct a9_eink *a9;
+
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	a9 = drm_kunit_helper_alloc_drm_device_with_driver(test, dev, struct a9_eink, drm,
+							   &a9_drm_driver);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, a9);
+	a9->dev = dev;
+	mutex_init(&a9->shadow_lock);
+	init_waitqueue_head(&a9->wq);
+	a9->shadow = kvzalloc(A9T_N, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, a9->shadow);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, a9t_kvfree, a9->shadow), 0);
+	memset(a9->shadow, 0xff, A9T_N);
+	KUNIT_ASSERT_EQ(test, a9_kms_init(a9), 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, a9t_shutdown, a9), 0);
+	return a9;
+}
+
+enum a9t_op {
+	A9T_ACTIVE_FB,		/* drm_hwcomposer: ACTIVE=1 + plane FB/CRTC, no MODE_ID, no connector */
+	A9T_ACTIVE_OFF,		/* ACTIVE=0 only */
+	A9T_MODE_OFF,		/* MODE_ID=0 + ACTIVE=0 + connector CRTC_ID=0 + plane off */
+	A9T_CONN_OFF,		/* connector CRTC_ID=0 only */
+};
+
+/* build, check and (commit != 0) commit one transaction; returns the result */
+static int a9t_do(struct kunit *test, struct a9_eink *a9, enum a9t_op op,
+		  struct drm_framebuffer *fb, bool commit)
+{
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_atomic_commit *st;
+	struct drm_crtc_state *cs;
+	struct drm_plane_state *ps;
+	struct drm_connector_state *conn;
+	int ret;
+
+	drm_modeset_acquire_init(&ctx, 0);
+	st = drm_kunit_helper_atomic_state_alloc(test, &a9->drm, &ctx);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, st);
+	switch (op) {
+	case A9T_ACTIVE_FB:
+		cs = drm_atomic_get_crtc_state(st, &a9->crtc);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, cs);
+		cs->active = true;
+		ps = drm_atomic_get_plane_state(st, &a9->plane);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ps);
+		KUNIT_ASSERT_EQ(test, drm_atomic_set_crtc_for_plane(ps, &a9->crtc), 0);
+		drm_atomic_set_fb_for_plane(ps, fb);
+		ps->crtc_x = 0;
+		ps->crtc_y = 0;
+		ps->crtc_w = A9E_FB_W;
+		ps->crtc_h = A9E_FB_H;
+		ps->src_x = 0;
+		ps->src_y = 0;
+		ps->src_w = (u32)fb->width << 16;
+		ps->src_h = (u32)fb->height << 16;
+		break;
+	case A9T_ACTIVE_OFF:
+		cs = drm_atomic_get_crtc_state(st, &a9->crtc);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, cs);
+		cs->active = false;
+		break;
+	case A9T_MODE_OFF:
+		cs = drm_atomic_get_crtc_state(st, &a9->crtc);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, cs);
+		KUNIT_ASSERT_EQ(test, drm_atomic_set_mode_for_crtc(cs, NULL), 0);
+		cs->active = false;
+		conn = drm_atomic_get_connector_state(st, &a9->connector);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, conn);
+		KUNIT_ASSERT_EQ(test, drm_atomic_set_crtc_for_connector(conn, NULL), 0);
+		ps = drm_atomic_get_plane_state(st, &a9->plane);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ps);
+		KUNIT_ASSERT_EQ(test, drm_atomic_set_crtc_for_plane(ps, NULL), 0);
+		drm_atomic_set_fb_for_plane(ps, NULL);
+		break;
+	case A9T_CONN_OFF:
+		conn = drm_atomic_get_connector_state(st, &a9->connector);
+		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, conn);
+		KUNIT_ASSERT_EQ(test, drm_atomic_set_crtc_for_connector(conn, NULL), 0);
+		break;
+	}
+	ret = commit ? drm_atomic_commit(st) : drm_atomic_check_only(st);
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+	return ret;
+}
+
+/* the committed state: enabled, fixed mode with derived timings, connector routed */
+static void a9t_expect_fixed(struct kunit *test, struct a9_eink *a9, bool active)
+{
+	struct drm_crtc_state *cs = a9->crtc.state;
+
+	KUNIT_EXPECT_TRUE(test, cs->enable);
+	KUNIT_EXPECT_EQ(test, cs->active, active);
+	KUNIT_EXPECT_TRUE(test, drm_mode_equal(&cs->mode, &a9_mode));
+	KUNIT_EXPECT_NOT_NULL(test, cs->mode_blob);
+	KUNIT_EXPECT_EQ(test, cs->mode.crtc_clock, a9_mode.clock);
+	KUNIT_EXPECT_EQ(test, cs->mode.crtc_vtotal, a9_mode.vtotal);
+	KUNIT_EXPECT_EQ(test, cs->adjusted_mode.crtc_clock, a9_mode.clock);
+	KUNIT_EXPECT_EQ(test, cs->adjusted_mode.crtc_htotal, a9_mode.htotal);
+	KUNIT_EXPECT_PTR_EQ(test, a9->connector.state->crtc, &a9->crtc);
+	KUNIT_EXPECT_EQ(test, cs->connector_mask, drm_connector_mask(&a9->connector));
+}
+
+/* after an ACTIVE commit: the virtual vblank runs at ~60 Hz (nonzero frame duration) */
+static void a9t_expect_vblank(struct kunit *test, struct a9_eink *a9, s64 commit_ms)
+{
+	struct drm_vblank_crtc *vb = drm_crtc_vblank_crtc(&a9->crtc);
+
+	KUNIT_EXPECT_EQ(test, a9->crtc.mode.crtc_clock, a9_mode.clock);
+	KUNIT_EXPECT_GE(test, vb->framedur_ns, 16000000);
+	KUNIT_EXPECT_LE(test, vb->framedur_ns, 17500000);
+	/* the commit waited for flip_done, sent by the vblank timer: not the 10 s timeout */
+	KUNIT_EXPECT_LT(test, commit_ms, 1000);
+}
+
+static s64 a9t_commit_ms(struct kunit *test, struct a9_eink *a9, enum a9t_op op,
+			 struct drm_framebuffer *fb, int *ret)
+{
+	ktime_t t0 = ktime_get();
+
+	*ret = a9t_do(test, a9, op, fb, true);
+	return ktime_ms_delta(ktime_get(), t0);
+}
+
+static void a9t_initial_state(struct kunit *test)
+{
+	struct a9_eink *a9 = a9t_dev(test);
+
+	a9t_expect_fixed(test, a9, false);
+	/* before any transaction: the object's own reference + the one the
+	 * linked reset state owns (later, uncommitted test states hold more until
+	 * the test ends; the teardown's leak WARNs check the balance) */
+	KUNIT_EXPECT_EQ(test, kref_read(&a9->connector.base.refcount), 2);
+	KUNIT_EXPECT_EQ(test, a9->drm.mode_config.min_height, 1);
+	KUNIT_EXPECT_EQ(test, a9->drm.mode_config.max_width, 4096);
+}
+
+static void a9t_active_only_check(struct kunit *test)
+{
+	struct a9_eink *a9 = a9t_dev(test);
+
+	KUNIT_EXPECT_EQ(test, a9t_do(test, a9, A9T_ACTIVE_FB, a9t_fb(test, a9, A9E_FB_W, A9E_FB_H),
+				     false), 0);
+	KUNIT_EXPECT_FALSE(test, READ_ONCE(a9->kick));	/* a check queues nothing */
+}
+
+/*
+ * From reset, without any MODE_ID commit: ACTIVE+FB, ACTIVE=0, ACTIVE+FB,
+ * MODE_ID=0, ACTIVE+FB, connector-only CRTC_ID=0 (while active), ACTIVE+FB.
+ */
+static void a9t_sequence(struct kunit *test)
+{
+	struct a9_eink *a9 = a9t_dev(test);
+	struct drm_framebuffer *fb = a9t_fb(test, a9, A9E_FB_W, A9E_FB_H);
+	s64 ms;
+	int ret;
+
+	ms = a9t_commit_ms(test, a9, A9T_ACTIVE_FB, fb, &ret);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	a9t_expect_fixed(test, a9, true);
+	a9t_expect_vblank(test, a9, ms);
+	KUNIT_EXPECT_TRUE(test, READ_ONCE(a9->kick));	/* black fb vs white shadow: work queued */
+	KUNIT_EXPECT_FALSE(test, a9->tx.on);		/* and nothing powered (no worker, no transport) */
+	WRITE_ONCE(a9->kick, false);
+
+	KUNIT_ASSERT_EQ(test, a9t_do(test, a9, A9T_ACTIVE_OFF, NULL, true), 0);
+	a9t_expect_fixed(test, a9, false);
+	ms = a9t_commit_ms(test, a9, A9T_ACTIVE_FB, fb, &ret);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	a9t_expect_fixed(test, a9, true);
+	a9t_expect_vblank(test, a9, ms);
+
+	/* MODE_ID=0 with ACTIVE still 1 is refused by the core, as for any driver */
+	KUNIT_ASSERT_EQ(test, a9t_do(test, a9, A9T_MODE_OFF, NULL, true), 0);
+	a9t_expect_fixed(test, a9, false);
+	ms = a9t_commit_ms(test, a9, A9T_ACTIVE_FB, fb, &ret);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	a9t_expect_fixed(test, a9, true);
+	a9t_expect_vblank(test, a9, ms);
+
+	KUNIT_ASSERT_EQ(test, a9t_do(test, a9, A9T_CONN_OFF, NULL, true), 0);
+	a9t_expect_fixed(test, a9, false);	/* detached = inactive, link restored */
+	ms = a9t_commit_ms(test, a9, A9T_ACTIVE_FB, fb, &ret);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	a9t_expect_fixed(test, a9, true);
+	a9t_expect_vblank(test, a9, ms);
+	KUNIT_EXPECT_FALSE(test, a9->tx.on);
+	/* teardown (a9t_shutdown, then drm_mode_config_cleanup) WARNs on any
+	 * leaked connector/vblank/vmap reference: test.log is scanned for that */
+}
+
+/* small framebuffers can be created, but never scanned on the only (full-screen) plane */
+static void a9t_small_fb(struct kunit *test)
+{
+	struct a9_eink *a9 = a9t_dev(test);
+
+	KUNIT_EXPECT_NE(test, a9t_do(test, a9, A9T_ACTIVE_FB, a9t_fb(test, a9, A9E_FB_W, 49), false), 0);
+}
+
+static struct kunit_case a9t_cases[] = {
+	KUNIT_CASE(a9t_initial_state),
+	KUNIT_CASE(a9t_active_only_check),
+	KUNIT_CASE(a9t_sequence),
+	KUNIT_CASE(a9t_small_fb),
+	{}
+};
+
+static struct kunit_suite a9t_suite = {
+	.name = "a9_eink_kms",
+	.test_cases = a9t_cases,
+};
+kunit_test_suite(a9t_suite);
