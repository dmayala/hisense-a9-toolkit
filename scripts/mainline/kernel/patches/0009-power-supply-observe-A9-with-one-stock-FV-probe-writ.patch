+	if ((!a9_is_observe() && s->temp_dc <= A9_COLD_DC) ||
+	    (s->status7 & (BIT(2) | BIT(0))))
 		return POWER_SUPPLY_HEALTH_COLD;
-	if (s->temp_dc >= A9_HOT_DC || (s->status7 & (BIT(3) | BIT(1))) ||
+	if ((!a9_is_observe() && s->temp_dc >= A9_HOT_DC) ||
+	    (s->status7 & (BIT(3) | BIT(1))) ||
