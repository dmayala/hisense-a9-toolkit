From 17b95d01dee5e6fe4a7d4949f42b510fff4f1a25 Mon Sep 17 00:00:00 2001
From: PMI632 proposal <pmic@example.invalid>
Date: Thu, 15 Oct 2026 00:00:00 +0000
Subject: [PATCH 9/9] power: supply: observe A9 with one stock FV probe write

Apply after the existing kernel patch 0008. fv_stock permits one probe-only
stock FV write and readback; no retries. ADC uses the upstream path, unless
observe_adc=0 is selected to omit ADC requests too.
---
 drivers/power/supply/Kconfig         |  29 +++++
 drivers/power/supply/pmi632-a9.c     | 163 +++++++++++++++++++++------
 drivers/power/supply/pmi632-fv.h     |  47 ++++++++
 drivers/power/supply/pmi632-policy.h |  23 ++++
 4 files changed, 230 insertions(+), 32 deletions(-)
 create mode 100644 drivers/power/supply/pmi632-fv.h

diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index 2bd835836..c2b3ca11f 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -1197,4 +1197,33 @@ config CHARGER_PMI632_A9
 	  Battery capacity is an uncalibrated voltage estimate. See the A9
 	  project's docs/mainline-pmic.md before binding this driver.
 
+config CHARGER_PMI632_A9_TELEMETRY_ONLY
+	bool "Permanently disable A9 charging enable path"
+	depends on CHARGER_PMI632_A9
+	help
+	  Compile out control-mode configuration and enable paths even when the
+	  module parameter and DT validation flag request charging. Observe
+	  mode is the default; the optional probe-only stock FV write is allowed.
+
+config CHARGER_PMI632_A9_OBSERVE
+	bool "Observe firmware charging with optional probe-only stock FV"
+	depends on CHARGER_PMI632_A9
+	default y if CHARGER_PMI632_A9_TELEMETRY_ONLY
+	help
+	  Exclude charger/QG control writes except optional fv_stock at probe.
+	  With fv_stock=0 firmware charger configuration stays untouched.
+	  Temperature uses only normal upstream ADC5 conversions (which write
+	  ADC registers); observe_adc=0 omits these and makes TEMP unavailable.
+
+config CHARGER_PMI632_A9_FV_STOCK
+	bool "Default fv_stock=1: one probe-only stock 4.450 V float write"
+	depends on CHARGER_PMI632_A9_OBSERVE
+	help
+	  Default the read-only load-time fv_stock parameter to 1. The telemetry
+	  image explicitly selects this option; pure observe defaults to 0.
+	  After all probe dependencies, allow one write of 0x55 to 0x1070 and
+	  verify readback. Unexpected handoff/readback or I/O errors latch health
+	  failure without retry, further writes, or charging-disable operations.
+	  fv_stock=0 still selects pure observe, even with this option enabled.
+
 endif # POWER_SUPPLY
diff --git a/drivers/power/supply/pmi632-a9.c b/drivers/power/supply/pmi632-a9.c
index 474c412ea..c6def0e05 100644
--- a/drivers/power/supply/pmi632-a9.c
+++ b/drivers/power/supply/pmi632-a9.c
@@ -21,13 +21,14 @@
 #include <soc/qcom/qcom-spmi-pmic.h>
 
 #include "pmi632-policy.h"
+#include "pmi632-fv.h"
 
 #define CHG_STATUS1	0x1006
 #define CHG_STATUS2	0x1007
 #define CHG_STATUS7	0x100d
 #define CHG_ENABLE	0x1042
 #define CHG_FCC		0x1061
-#define CHG_FV		0x1070
+#define CHG_FV		A9_STOCK_FV_REG
 #define JEITA_HARD	0x1098
 #define BATIF_RT	0x1210
 #define USB_RT		0x1310
@@ -52,6 +53,29 @@ static bool allow_charging;
 module_param(allow_charging, bool, 0400);
 MODULE_PARM_DESC(allow_charging, "EXPERIMENTAL charging after coordinator validation; default false");
 
+/* Observe excludes all control writes except the opt-in probe-only stock FV.
+ * CONFIG forces observe; fv_stock=0 preserves pure observation.
+ */
+static bool observe = IS_ENABLED(CONFIG_CHARGER_PMI632_A9_OBSERVE);
+module_param(observe, bool, 0400);
+MODULE_PARM_DESC(observe, "Observe firmware charger; CONFIG_OBSERVE forces true; see fv_stock");
+
+static bool fv_stock = IS_ENABLED(CONFIG_CHARGER_PMI632_A9_FV_STOCK);
+module_param(fv_stock, bool, 0400);
+MODULE_PARM_DESC(fv_stock, "Observe only: one probe write of stock 4.450V FV, with readback; no retries");
+
+/* Optional exception: only the existing upstream ADC5 conversion path writes.
+ * fv_stock=0 observe_adc=0 gives zero consumer writes, with TEMP unavailable.
+ */
+static bool observe_adc = true;
+module_param(observe_adc, bool, 0400);
+MODULE_PARM_DESC(observe_adc, "Use normal upstream ADC5 conversions in observe (default true)");
+
+static bool a9_is_observe(void)
+{
+	return IS_ENABLED(CONFIG_CHARGER_PMI632_A9_OBSERVE) || observe;
+}
+
 struct a9_pmic {
 	struct device *dev;
 	struct regmap *map;
@@ -62,7 +86,7 @@ struct a9_pmic {
 	struct a9_sample sample;
 	unsigned long last_change, sampled_at;
 	u32 last_raw;
-	int current_scale, error;
+	int current_scale, error, fv_error;
 	bool permitted, charging, latched, suspended, have_raw;
 };
 
@@ -92,12 +116,26 @@ static const struct a9_setting a9_settings[] = {
 	{ WD_CFG, BIT(7) | BIT(6) | BIT(1) | BIT(0), BIT(1) | BIT(0) },
 };
 
+static int a9_fv_read(void *context, unsigned int reg, unsigned int *value)
+{
+	return regmap_read(context, reg, value);
+}
+
+static int a9_fv_write(void *context, unsigned int reg, unsigned int value)
+{
+	if (!a9_is_observe() || reg != A9_STOCK_FV_REG || value != A9_STOCK_FV_RAW)
+		return -EPERM;
+	return regmap_write(context, reg, value);
+}
+
 static int a9_update_check(struct a9_pmic *p, unsigned int reg,
 			   unsigned int mask, unsigned int val)
 {
 	unsigned int readback;
 	int ret;
 
+	if (a9_is_observe())
+		return -EPERM;
 	ret = regmap_update_bits(p->map, reg, mask, val);
 	if (ret)
 		return ret;
@@ -107,11 +145,13 @@ static int a9_update_check(struct a9_pmic *p, unsigned int reg,
 	return (readback & mask) == val ? 0 : -EIO;
 }
 
-/* Attempt BOTH stops even if one bus transaction fails. Never restore ON. */
+/* Control mode attempts BOTH stops; observe returns before any bus access. */
 static int a9_off(struct a9_pmic *p)
 {
 	int ret, other;
 
+	if (a9_is_observe())
+		return 0;
 	p->charging = false;
 	ret = a9_update_check(p, CHG_ENABLE, BIT(0), 0);
 	other = a9_update_check(p, USB_SUSPEND, BIT(0), BIT(0));
@@ -130,6 +170,8 @@ static int a9_settings_check(struct a9_pmic *p, bool program)
 	int ret;
 
 	if (program) {
+		if (a9_is_observe())
+			return -EPERM;
 		ret = regmap_bulk_write(p->map, JEITA_HARD, hard, sizeof(hard));
 		if (ret)
 			return ret;
@@ -170,6 +212,9 @@ static int a9_read_sample(struct a9_pmic *p, struct a9_sample *s)
 		{ DIE_STATUS, &s->die }, { CONN_STATUS, &s->conn },
 		{ OTG_CMD, &s->otg }, { 0x1307, &s->apsd }, { 0x1308, &s->source },
 		{ 0x4843, &s->qgmode },
+		{ CHG_ENABLE, &s->enabled }, { USB_SUSPEND, &s->suspend },
+		{ 0x110b, &s->powerpath }, { CHG_FV, &s->fv_raw },
+		{ CHG_FCC, &s->fcc_raw }, { USB_ICL, &s->icl_raw },
 	};
 	unsigned int i;
 
@@ -204,11 +249,16 @@ static int a9_read_sample(struct a9_pmic *p, struct a9_sample *s)
 	/* QG is negative on charge. power_supply battery current is positive in. */
 	s->ua = -div_s64((s64)(s16)get_unaligned_le16(raw + 2) *
 			 p->current_scale, 1000);
+	if (s->uv < 2500000 || s->uv > 4500000 || abs(s->ua) > 5000000)
+		return -ERANGE;
+	if (a9_is_observe() && !observe_adc)
+		return 0;
 	ret = iio_read_channel_processed(p->therm, &therm_uv);
 	if (ret < 0)
 		return ret;
 	if (a9_temp_dc(therm_uv, &s->temp_dc))
 		return -ERANGE;
+	s->temp_valid = 1;
 	ret = iio_read_channel_processed(p->vbus, &s->vbus_uv);
 	if (ret < 0)
 		return ret;
@@ -216,9 +266,8 @@ static int a9_read_sample(struct a9_pmic *p, struct a9_sample *s)
 	if (ret < 0)
 		return ret;
 	/* Stock charger threshold is 80 C; choose 70 C for bring-up. */
-	if (die_mc < -40000 || die_mc >= 70000)
-		return -ERANGE;
-	if (s->uv < 2500000 || s->uv > 4500000 || abs(s->ua) > 5000000)
+	if (die_mc < -40000 || die_mc > 150000 ||
+	    (!a9_is_observe() && die_mc >= 70000))
