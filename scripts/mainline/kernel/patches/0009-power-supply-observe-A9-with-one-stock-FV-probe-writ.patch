@@ -227,15 +276,22 @@ static int a9_health(const struct a9_pmic *p)
 {
 	const struct a9_sample *s = &p->sample;
 
-	if (p->error || p->latched || time_after(jiffies, p->sampled_at + 5 * HZ))
+	if (p->error || p->fv_error || p->latched ||
