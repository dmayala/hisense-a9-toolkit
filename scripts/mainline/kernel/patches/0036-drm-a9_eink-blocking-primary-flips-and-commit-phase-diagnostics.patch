diff --git a/include/drm/drm_atomic_profile.h b/include/drm/drm_atomic_profile.h
new file mode 100644
index 0000000000000000000000000000000000000000..569da0c5056f2e43cf92ae04c9bb99f548235ef2
--- /dev/null
+++ b/include/drm/drm_atomic_profile.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef __DRM_ATOMIC_PROFILE_H__
+#define __DRM_ATOMIC_PROFILE_H__
+
+#include <linux/compiler.h>
+#include <linux/ktime.h>
+#include <linux/types.h>
+
+enum drm_atomic_profile_phase {
+	DRM_ATOMIC_PROFILE_PREPARE,
+	DRM_ATOMIC_PROFILE_FENCES,
+	DRM_ATOMIC_PROFILE_DEPENDENCIES,
+	DRM_ATOMIC_PROFILE_WAIT_PREV,
+	DRM_ATOMIC_PROFILE_PROGRAM,
+	DRM_ATOMIC_PROFILE_FLIP_DONE,
+	DRM_ATOMIC_PROFILE_CLEANUP,
+	DRM_ATOMIC_PROFILE_DONE,
+};
+
+/*
+ * Opt-in elapsed-time accounting for a blocking internal atomic commit.
+ * The caller owns this storage until commit returns and closes it with DONE.
+ * A single commit thread updates it; READ/WRITE_ONCE also permit diagnostic
+ * snapshots, which are approximate while a phase transition is in progress.
+ * This is observation only: no scheduling, fence or hardware-wait changes.
+ */
+struct drm_atomic_commit_profile {
+	u64 ns[DRM_ATOMIC_PROFILE_DONE];
+	u64 mark_ns;
+	u32 phase;
+};
+
+static inline void drm_atomic_profile_init(struct drm_atomic_commit_profile *p)
+{
+	unsigned int i;
+
+	if (!p)
+		return;
+	for (i = 0; i < DRM_ATOMIC_PROFILE_DONE; i++)
+		WRITE_ONCE(p->ns[i], 0);
+	WRITE_ONCE(p->mark_ns, ktime_get_ns());
+	WRITE_ONCE(p->phase, DRM_ATOMIC_PROFILE_PREPARE);
+}
+
+static inline void drm_atomic_profile_enter(struct drm_atomic_commit_profile *p,
+					    u32 phase)
+{
+	u32 old;
+	u64 now;
+
+	if (!p || phase > DRM_ATOMIC_PROFILE_DONE)
+		return;
+	old = READ_ONCE(p->phase);
+	if (old >= DRM_ATOMIC_PROFILE_DONE)
+		return;
+	now = ktime_get_ns();
+	WRITE_ONCE(p->ns[old], READ_ONCE(p->ns[old]) + now - READ_ONCE(p->mark_ns));
+	WRITE_ONCE(p->mark_ns, now);
+	WRITE_ONCE(p->phase, phase);
+}
+
+#endif /* __DRM_ATOMIC_PROFILE_H__ */
