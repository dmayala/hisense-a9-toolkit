+/* ---- sysfs: the compat contract's "eink" group on the connector ---------------- */
+static struct a9_eink *kdev_to_a9(struct device *kdev)
+{
+	struct drm_connector *c = dev_get_drvdata(kdev);	/* drm_sysfs: kdev drvdata = connector */
+
+	return to_a9(c->dev);
