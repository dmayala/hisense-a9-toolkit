@@ -0,0 +1,20 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config DRM_A9_EINK
+	tristate "Hisense A9 (HLTE556N) E Ink display with in-kernel software TCON"
+	depends on DRM && OF && ARM64 && MMU
+	depends on REGULATOR_FP9929A && IIO
+	# msm's fbdev client would scan console contents out to the E Ink transport
+	depends on !DRM_FBDEV_EMULATION
+	select DRM_CLIENT
+	select DRM_KMS_HELPER
+	select DRM_GEM_SHMEM_HELPER
+	select FW_LOADER
+	select CRYPTO_LIB_SHA256
+	help
+	  An 824x1648 KMS device for the Hisense A9 E Ink panel. The kernel
+	  runs the software TCON (a port of the stock composer's frame
+	  generation) and scans the 448x829 drive frames out through the msm
+	  DSI output and the TC358767 bridge. Waveform tables are loaded with
+	  request_firmware from hisense/a9-waveform.bin, extracted by the
+	  user from their own composer binary. Sends nothing to the panel
+	  unless a9_eink.enable=1.
