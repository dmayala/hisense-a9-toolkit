 	return 0;
 }
 
+/* ---- control template ------------------------------------------------------ */
+int a9e_ct_check(const uint8_t *blob, size_t len, const uint8_t **payload)
+{
+	const uint8_t *p;
+	size_t i;
+
+	if (len < sizeof(struct a9e_ct_header))
+		return A9E_CT_ESIZE;
+	if (rd32(blob) != A9E_CT_MAGIC)
+		return A9E_CT_EMAGIC;
+	if (rd32(blob + 4) != A9E_CT_VERSION)
+		return A9E_CT_EVERSION;
+	if (rd32(blob + 8) != sizeof(struct a9e_ct_header) ||
+	    rd32(blob + 12) != A9T_FRAME_BYTES ||
+	    len != sizeof(struct a9e_ct_header) + A9T_FRAME_BYTES)
+		return A9E_CT_ESIZE;
+	p = blob + sizeof(struct a9e_ct_header);
+	for (i = 0; i < A9T_FRAME_BYTES; i += 4) {
+		if (p[i])
+			return A9E_CT_EBYTE0;
+		if (p[i + 2])
+			return A9E_CT_EBYTE2;
+		if (p[i + 3] != 0xff)
+			return A9E_CT_EBYTE3;
+	}
+	if (payload)
+		*payload = p;
+	return 0;
+}
+
 /* ---- setup and rects ------------------------------------------------------- */
 void a9e_setup(struct a9e_engine *e)
 {
diff --git a/drivers/gpu/drm/a9_eink/a9_eink_engine.h b/drivers/gpu/drm/a9_eink/a9_eink_engine.h
index 82db7cd98..d00f852e6 100644
--- a/drivers/gpu/drm/a9_eink/a9_eink_engine.h
+++ b/drivers/gpu/drm/a9_eink/a9_eink_engine.h
@@ -49,6 +49,27 @@ struct a9e_wf_header {
 	uint8_t payload_sha256[32];	/* of the payload that follows */
 };
 
+/*
+ * The control template (/lib/firmware/hisense/a9-ctrl-template.bin), little
+ * endian: this header, then one 448 x 829 frame of 32-bit words whose bytes
+ * 1..3 are the panel's control signals (a9tcon.h) and byte 0 is 0. Made from
+ * the user's own composer by scripts/mainline/eink/tools (vendor-derived:
+ * never part of the source). Only one payload is accepted: its SHA-256 is
+ * A9E_CT_SHA256 (MEASURED: the composer's builder, recovery's builder and 16
+ * live stock ring buffers agree on bytes 1..3).
+ */
+#define A9E_CT_MAGIC 0x54433941u	/* "A9CT" */
+#define A9E_CT_VERSION 1u
+#define A9E_CT_SHA256 "a88ae8efc5325e1ab52e4e48b73d2abb1a3c81a7989baa2a226513b07cebfbe7"
+struct a9e_ct_header {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t header_size;		/* sizeof(struct a9e_ct_header) = 80 */
+	uint32_t payload_size;		/* A9T_FRAME_BYTES */
+	uint8_t source_sha256[32];	/* the composer the template came from */
+	uint8_t payload_sha256[32];	/* of the payload that follows */
+};
+
 struct a9e_engine {
 	/* caller-provided buffers (assign, then a9e_setup) */
 	const struct a9t_tables *t;
@@ -99,6 +120,18 @@ int a9e_mode_valid(uint32_t mode);
 #define A9E_WF_ELAST (-8)	/* a table pass would end on a driving frame */
 int a9e_wf_check(const uint8_t *blob, size_t len, const struct a9t_tables **tables);
 
+/* Check a control-template blob: header, sizes, and every word of the payload
+ * (byte 0 == 0: no drive; byte 2 == 0x00; byte 3 == 0xff, as stock). Returns 0
+ * and the payload, or a negative A9E_CT_E* code. The SHA-256s (header's and
+ * A9E_CT_SHA256) are checked by the caller. */
+#define A9E_CT_ESIZE (-1)
+#define A9E_CT_EMAGIC (-2)
+#define A9E_CT_EVERSION (-3)
+#define A9E_CT_EBYTE0 (-4)
+#define A9E_CT_EBYTE2 (-5)
+#define A9E_CT_EBYTE3 (-6)
+int a9e_ct_check(const uint8_t *blob, size_t len, const uint8_t **payload);
+
 /* After assigning the buffers: engine state, old := 15 (white), arrays := 0. */
 void a9e_setup(struct a9e_engine *e);
 
@@ -128,9 +161,11 @@ void a9e_begin_init(struct a9e_engine *e, int bin);
 int a9e_begin(struct a9e_engine *e, uint32_t mode, int clear, const struct a9e_rect *rect,
 	      int mask, int bin);
 
-/* Next drive frame into out (A9T_FRAME_BYTES; bytes 1..3 of every word are
- * never written, keep them zero). Returns 1 = more frames follow, 0 = this
- * was the last one (always all zero for stock tables). */
+/* Next drive frame into out (A9T_FRAME_BYTES). Only byte 0 of each word is
+ * written; bytes 1..3 must already hold the control template (a9tcon.h), so
+ * pre-fill out (and e->cache) with it once. Returns 1 = more frames follow,
+ * 0 = this was the last one (always a null frame, byte 0 all zero, for stock
+ * tables). */
 int a9e_frame(struct a9e_engine *e, uint8_t *out);
 
 /* Commit the update: old := new, previous mode := this mode. */
@@ -140,7 +175,8 @@ void a9e_end(struct a9e_engine *e);
  * next update is forced to a full clear. */
 void a9e_abort(struct a9e_engine *e);
 
-/* 1 if every data code of the frame is 0 (no drive). */
+/* 1 if byte 0 (the data code) of every word is 0: no drive. Bytes 1..3 (the
+ * control template) are not looked at. */
 int a9e_frame_is_null(const uint8_t *out);
 
 #ifdef __cplusplus
diff --git a/drivers/gpu/drm/a9_eink/a9_eink_transport.c b/drivers/gpu/drm/a9_eink/a9_eink_transport.c
index a1e9a9e52..8bb79d508 100644
--- a/drivers/gpu/drm/a9_eink/a9_eink_transport.c
+++ b/drivers/gpu/drm/a9_eink/a9_eink_transport.c
@@ -13,6 +13,18 @@
  * TC358767 driver creates for the E Ink transport panel carries the panel's
  * DT node, and once attached its ->dev is the msm drm_device.
  *
+ * What the panel scans (2026-10-15, boot 12): every 32-bit word is byte 0 =
+ * drive data | bytes 1..3 = the CONTROL TEMPLATE (gate clocks and source
+ * strobes on the G lane, 0x00 on R, 0xff on X), which stock builds once at TCON
+ * start and never overwrites. Without it the panel's gate/source drivers are
+ * never clocked and nothing changes on the glass. So: both buffers hold the
+ * template from attach on; a frame is composed as (frame & byte-0 lanes) |
+ * template, so bytes 1..3 come from the validated template whatever the
+ * frame's bytes 1..3 hold; the idle ("zero", null) frame is the template
+ * itself (byte 0 = 0 everywhere). The null test looks at byte 0 only, so the
+ * interlock below is unchanged. Without a template the transport never
