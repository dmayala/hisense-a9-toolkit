+CONFIG_THERMAL=y
+CONFIG_THERMAL_CRITICAL_CONFIRM_SAMPLES=3
+CONFIG_THERMAL_CRITICAL_CONFIRM_KUNIT_TEST=y
diff --git a/drivers/thermal/Kconfig b/drivers/thermal/Kconfig
index 810eecced..ee5709bab 100644
--- a/drivers/thermal/Kconfig
+++ b/drivers/thermal/Kconfig
@@ -49,6 +49,36 @@ config THERMAL_CORE_TESTING
 	  with trip points in order to exercise the thermal core
 	  functionality in a controlled way.
 
+config THERMAL_CRITICAL_CONFIRM_SAMPLES
+	int "Time-separated samples needed before a critical trip acts"
+	range 1 10
+	default 1
+	help
+	  Number of consecutive temperature samples, each at or above the
+	  lowest critical trip of a zone and each taken at least 250 ms after
+	  the previous counted one, that the thermal core requires before it
+	  crosses that trip (and so before a critical trip starts the
+	  hardware-protection shutdown). Updates arriving sooner (polling,
+	  sensor interrupts, sysfs reads of the zone) are discarded without
+	  counting; while confirming, the sensor's trip window is reprogrammed
+	  around the current value so a level interrupt cannot storm, and the
+	  zone is re-read when the next sample is due. A sample below the trip,
+	  a failed read, an invalid-temperature sentinel, a mode change or a
+	  zone (re)initialisation (e.g. resume) restarts the count. A genuine
+	  over-temperature acts after (N - 1) * 250 ms plus scheduling delay;
+	  one corrupted successful sample can no longer power the system off.
+
+	  1 = upstream behaviour (every sample acts at once).
+
+config THERMAL_CRITICAL_CONFIRM_KUNIT_TEST
+	tristate "KUnit test for critical-trip confirmation" if !KUNIT_ALL_TESTS
+	depends on KUNIT && THERMAL
+	default KUNIT_ALL_TESTS
+	help
+	  Drives a scripted thermal zone through thermal_zone_device_update()
+	  (the polling and interrupt entry point) and checks the confirmation
+	  policy of THERMAL_CRITICAL_CONFIRM_SAMPLES.
+
 config THERMAL_EMERGENCY_POWEROFF_DELAY_MS
 	int "Emergency poweroff delay in milli-seconds"
 	default 0
