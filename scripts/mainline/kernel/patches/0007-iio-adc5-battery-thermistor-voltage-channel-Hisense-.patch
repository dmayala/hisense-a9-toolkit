From e0330ede38ded7a3bfa02be97916e36ad633d48e Mon Sep 17 00:00:00 2001
From: A9 project <dmayala@users.noreply.github.com>
Date: Wed, 14 Oct 2026 21:20:49 -0700
Subject: [PATCH 7/9] iio: adc5: battery thermistor voltage channel (Hisense
 A9, sol-pmic proposal 0001)

---
 drivers/iio/adc/qcom-spmi-adc5.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/iio/adc/qcom-spmi-adc5.c b/drivers/iio/adc/qcom-spmi-adc5.c
index 83ecd3adf..9ffcdaf64 100644
--- a/drivers/iio/adc/qcom-spmi-adc5.c
+++ b/drivers/iio/adc/qcom-spmi-adc5.c
@@ -540,6 +540,9 @@ static const struct adc5_channels adc5_chans_pmic[ADC5_MAX_CHANNEL] = {
 					SCALE_HW_CALIB_DEFAULT)
 	[ADC5_MID_CHG_DIV6]	= ADC5_CHAN_VOLT("chg_mid_chg", 3,
 					SCALE_HW_CALIB_DEFAULT)
+	/* Battery thermistor voltage; the consumer supplies the NTC curve. */
+	[ADC5_BAT_THERM_30K_PU] = ADC5_CHAN_VOLT("bat_therm_30k_uv", 0,
+					SCALE_HW_CALIB_DEFAULT)
 	[ADC5_XO_THERM_100K_PU]	= ADC5_CHAN_TEMP("xo_therm", 0,
 					SCALE_HW_CALIB_XOTHERM)
 	[ADC5_BAT_ID_100K_PU]	= ADC5_CHAN_TEMP("bat_id", 0,
