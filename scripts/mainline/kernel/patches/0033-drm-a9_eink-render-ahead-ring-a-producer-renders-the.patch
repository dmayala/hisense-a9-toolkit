+/* commit one idle (template) frame now, whatever is on screen (render-ahead prefill) */
+int a9x_idle_refresh(struct a9x_transport *t)
+{
+	int back, ret = -ENODEV;
+
+	mutex_lock(&t->lock);
+	if (t->on && !t->gone) {
