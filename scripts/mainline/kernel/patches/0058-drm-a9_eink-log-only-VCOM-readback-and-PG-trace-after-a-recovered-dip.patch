  * ends at once if the gate closes, a fault latches, the pipeline goes off or
  * the FP9929A reports forced/emergency.
  */
+/*
+ * F9: cumulative HV-on time as the worker observes it (no hook in the power
+ * path). A session is counted from its on_since to "now" while it is on, and
+ * up to its off_since once a later observation finds it ended. Called after
+ * every real waveform and at each settle, so every HV session (each has at
+ * least one waveform) is seen at least once; time not observed is not
+ * credited, which only makes the bucket stricter.
+ */
+static u64 a9_hv_on_ms(struct a9_eink *a9)
+{
+	struct a9x_transport *t = &a9->tx;
+	bool on = READ_ONCE(t->on);
+	ktime_t on_since = READ_ONCE(t->on_since), off_since = READ_ONCE(t->off_since);
+	ktime_t now = ktime_get();
+
+	if (a9->hvon_since && (!on || on_since != a9->hvon_since)) {
+		/* the session counted so far has ended: credit it up to its power-down */
+		if (off_since > a9->hvon_mark)
+			a9->hvon_ms += ktime_ms_delta(off_since, a9->hvon_mark);
+		a9->hvon_since = 0;
+	}
+	if (on) {
+		if (a9->hvon_since != on_since) {
+			a9->hvon_since = on_since;
+			a9->hvon_mark = on_since;
+		}
+		if (now > a9->hvon_mark) {
+			s64 d = ktime_ms_delta(now, a9->hvon_mark);
+
+			a9->hvon_ms += d;
+			a9->hvon_mark = ktime_add_ms(a9->hvon_mark, d);
+		}
+	}
+	return a9->hvon_ms;
+}
+
+/* F9: refill from HV-on time; true when at least one dip's token is available */
+static bool a9_rate_ok(struct a9_eink *a9)
+{
+	u64 cap = (u64)READ_ONCE(pg_settle_rate_burst) * 1000;
+	u64 win = (u64)READ_ONCE(pg_settle_rate_window_s) * 1000;
+	u64 on_ms = a9_hv_on_ms(a9), add = 0;
+
+	if (!a9->rate_init) {
+		a9->rate_init = true;
+		a9->rate_tokens = cap;		/* starts full */
+	} else if (win && on_ms > a9->rate_at_ms) {
+		add = (on_ms - a9->rate_at_ms) * READ_ONCE(pg_settle_rate_n) * 1000 / win;
+	}
+	a9->rate_at_ms = on_ms;
+	a9->rate_tokens = min(a9->rate_tokens + add, cap);
+	return a9->rate_tokens >= 1000;
+}
