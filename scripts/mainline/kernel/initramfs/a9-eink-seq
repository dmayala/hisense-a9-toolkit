#!/bin/sh
# a9-eink-seq -- on-phone E3 -> E5c sequencer for the A9 mainline initramfs
# (2026-10-15). Safety logic and criteria: docs/mainline-eink-steps.md,
# section "E3-E5 sequencer". Driven by first-boot.sh --e3/--e5ab/--e5 through
# a9-ctl ("eink-seq <verb>"); every verb is also usable from the ACM shell.
#
#   pre [FW_SHA256 [CT_SHA256]]  load a9_eink with the session parameters,
#                         check the preconditions (no power); the hashes are
#                         the host's waveform and control-template files
#   e3 [full [stop]]      session A: template frames, PG measured, polarity
#                         decided, then an unconditional latched stop
#                         (measurement only). "full": session B, and E5 may
#                         follow; "full stop": session B, then a latched stop
#   e3t [stop]            after "e3 full": one more template-only HV session
#                         with read-only bridge/clock/DPU reads (patch 0028:
#                         the template scans the gates, drives nothing);
#                         "stop": then a latched stop
#   e5a                   dry run (no commit, no HV); saves grey/levels/last
#   verdict e5a N SHA     the host's CLI result for e5a; must equal the phone's
#   e5b                   panel gate + a9_eink.enable, FP9929A gate CLOSED
#   e5c                   first glass: init flash + "steps" (all gates open)
#   safe [REASON]         close every gate, force the FP9929A off if needed,
#                         verify PWRUP=0 VCOM_EN=0 (REASON latches ABORTED)
#   status | fetch        state summary | tar.gz of the session directory
#
# Order is enforced HERE (each stage needs the previous one's pass file), and
# every failure or timeout runs the abort path, which latches ABORTED: after
# that no stage runs again in this boot. The stage itself runs detached
# (setsid, own log), so a lost host connection cannot stop it half-way; the
# a9-ctl connection only waits for it.
#
# Never writes storage. Opens the power gates only inside e3/e3t/e5b/e5c sessions,
# always closes them at the end of the session and on every abort.

PATH=${A9_SEQ_PREPATH:+$A9_SEQ_PREPATH:}/bin:/sbin:$PATH
trap '' HUP PIPE   # a dropped a9-ctl connection must not kill a stage or "safe" half-way
SELF=${A9_SEQ_SELF:-$0}
# ---- test hooks (tests/mainline-eink-seq): all default to the real phone ----
R=${A9_SEQ_ROOT:-}                       # prefix for /sys and /proc trees
D=${A9_SEQ_DIR:-/tmp/eink-seq}
KMSG_CMD=${A9_SEQ_KMSG_CMD:-cat /dev/kmsg}
KMSG_LOG=${A9_SEQ_KMSG_LOG:-}            # command that logs one line to kmsg
FW=${A9_SEQ_FW:-/lib/firmware/hisense/a9-waveform.bin}
CT=${A9_SEQ_CT:-/lib/firmware/hisense/a9-ctrl-template.bin}
REBOOT=${A9_SEQ_REBOOT:-/bin/a9-reboot bootloader}
SPEED=${A9_SEQ_SPEED:-1}                 # tests: divide waits (never on phone)
NICE=${A9_SEQ_NICE:-10}                  # dense sampler (E3 session A) priority (tests on a loaded host: 0)
NICE_LOW=${A9_SEQ_NICE:-19}              # sparse samplers (B, e3t, E5c): lowest priority (frame pacing)
# QEMU tests run 10-20x slower than real time: A9_SEQ_SLOW stretches every
# deadline and time limit, and is honoured ONLY with a fake tree (A9_SEQ_ROOT)
SLOW=1; [ -n "$R" ] && SLOW=${A9_SEQ_SLOW:-1}
[ -n "$R" ] || SPEED=1   # likewise: never shorten a wait (e.g. the 50 ms VCOM_EN->PWRUP gap) on the phone
# payload sha256 of the control template (bytes 80.. of a9-ctrl-template.bin;
# patch 0028 compiles the same value in as A9_CT_SHA256). The fake tree's
# template is not the vendor one: tests may replace the value, only there.
CT_SHA=a88ae8efc5325e1ab52e4e48b73d2abb1a3c81a7989baa2a226513b07cebfbe7
[ -n "$R" ] && CT_SHA=${A9_SEQ_CT_SHA:-$CT_SHA}
# A9_SEQ_HOOK: called at each step of a session's opening sequence (fault
# injection in tests/mainline-eink-seq); fake tree only, like the knobs above
hook() { [ -n "$R" ] && [ -n "${A9_SEQ_HOOK:-}" ] && $A9_SEQ_HOOK "$1"; return 0; }

PA=$R/sys/module/a9_eink/parameters
PP=$R/sys/module/panel_hisense_hlte556n_eink/parameters
PF=$R/sys/module/fp9929a/parameters
DBG=$R/sys/kernel/debug

# ---- session parameters (docs: "E3-E5 sequencer") ---------------------------
HV_MAX_MS=15000          # a9_eink cap, below fp9929a.max_on_ms (20000)
FP_MAX_ON_MS=20000       # expected fp9929a.max_on_ms (patch 0017 default)
FP_MIN_OFF_MS=500        # expected fp9929a.min_off_ms (patch 0025 + 0049b default: datasheet VLD)
E3A_N=255                # zero frames, session A (3 s at 85 Hz): PG sampling
E3B_N=425                # zero frames, session B (5 s): timing, VCOM, MX
E3T_N=425                # template frames, session e3t (5 s): bridge/clock/DPU reads
CT_BYTES=1485648         # a9-ctrl-template.bin: 80-byte header + 448*829*4 payload
PERIOD_US=11764          # 85 Hz transport frame period
MAXGAP_US=17646          # 1.5 periods = a9_eink's "late" threshold
HV_BUDGET_MS=$(( 30000 * SLOW ))   # total HV-on time allowed in one boot
HV_SETUP_MS=1000         # per-session cutoff allowance: launch + modeset + FP9929A
                         # sequence (~30 ms) + PG wait (<= 100 ms) + 51 ms power-down
E5C_CAP_MS=3588          # E5c kernel cap (review 6/7: fixed, never raised)
E5C_SAMPLE_MS=250        # E5c / e3t sampler period (session load, >= 250 ms)
# Frames per temperature bin with the user's waveform (review 7, MEASURED with
# the real engine + image blob): the init flash, and the COMPLETE Clear request
# (a uniform white type-3 pre-pass, then the type-2 pass of the image)
BIN_INIT="109 93 81 71 61 111 95 83 75 67 63 59 55 51"
BIN_CLEAR="208 176 152 132 114 96 80 70 60 60 60 60 60 60"
nth() { echo "$2" | awk -v k="$1" '{ print $(k + 1) }'; }   # nth <bin> <list>
VCOM_LINE='VCOM 2730 mV (code 0x7e)'

mkdir -p "$D"

# ---- small helpers ------------------------------------------------------------
now() { cut -d' ' -f1 /proc/uptime; }
now_ms() { awk '{printf "%d", $1 * 1000}' /proc/uptime; }
msleep() { usleep $(( $1 * 1000 / SPEED )); }
kmsg() {
	if [ -n "$KMSG_LOG" ]; then $KMSG_LOG "a9-eink-seq: $*"
	else echo "a9-eink-seq: $*" > /dev/kmsg 2>/dev/null; fi
}
log() { echo "$(now) $*" | tee -a "$D/seq.log"; kmsg "$*"; }
mark() { kmsg "MARK $*"; echo "$(now) MARK $*" >> "$D/seq.log"; }
rd() { cat "$1" 2>/dev/null; }
# bool module parameters read back as Y/N (the test fake stores what was written)
isY() { case "$(rd "$1")" in Y|1) return 0;; esac; return 1; }
isN() { case "$(rd "$1")" in N|0) return 0;; esac; return 1; }

FAILS=0
NOGATE=""
chk() { # chk <name> <0|1 pass> <detail>; names listed in $NOGATE only report
	if [ "$2" = 1 ]; then echo "  ok   $1: $3"; echo "$1 1 $3" >> "$D/criteria.$STAGE"
	elif echo " $NOGATE " | grep -qF " $1 "; then echo "  info $1 (not gating): $3"; echo "$1 info $3" >> "$D/criteria.$STAGE"
	else echo "  FAIL $1: $3"; FAILS=$((FAILS + 1)); echo "$1 0 $3" >> "$D/criteria.$STAGE"; fi
}
hexnum() { case "$1" in 0x[0-9a-fA-F]*|[0-9]) echo $(( $1 ));; *) echo x;; esac; }
info() { echo "  info $1: $2"; echo "$1 info $2" >> "$D/criteria.$STAGE"; }
num() { case "$1" in ''|*[!0-9-]*) return 1;; esac; }
between() { num "$1" && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }

# ---- GPIO reads -----------------------------------------------------------------
# TLMM GPIO_IN_OUT registers (pinctrl-sm6115.c: io = tile + 0x1000*n + 4; bit 0
# = pad input, bit 1 = output value; WEST 0x500000, EAST 0xd00000). The same
# register/bit stock reads for PG (0x00552004 bit 0, docs/mainline-fp9929a-pg.md).
io_addr() {
	case "$1" in
	2) echo 0x00502004 ;; 31) echo 0x00d1f004 ;; 36) echo 0x00d24004 ;;
	82) echo 0x00552004 ;; 86) echo 0x00556004 ;; *) return 1 ;;
	esac
}
mem_rd() { v=$(devmem "$1" 32 2>/dev/null) && echo $((v)); }
mem_ok() { [ -e "$D/mem_ok" ]; }
# debugfs: the TLMM chip's section only (pmic gpio chips reuse the names)
dbg_pin() {
	awk -v p="gpio$1" '/^gpiochip/ { t = ($0 ~ /500000[.]pinctrl/) }
		t && $1 == p { print $3, $4; exit }' "$DBG/gpio"
}
# pin <n> -> "<out> <in>" (0/1). devmem when trusted, else debugfs (both = level)
pin() {
	if mem_ok; then
		v=$(mem_rd "$(io_addr "$1")") || { echo "x x"; return; }
		echo "$(( (v >> 1) & 1 )) $(( v & 1 ))"
	else
		set -- $(dbg_pin "$1")
		case "$2" in high) echo "1 1";; low) echo "0 0";; *) echo "x x";; esac
	fi
}
pins() { echo "$(pin 36) $(pin 86) $(pin 82)"; }   # o36 i36 o86 i86 o82 i82
hv_is_off() { [ "$(pin 36)" = "0 0" ] && [ "$(pin 86)" = "0 0" ]; }

# devmem may only be used (read in the sampler, written in the force-off) if it
# agrees with the kernel's own debugfs view on five pins in two tiles, and the
# two HV pins are GPIO-function outputs.
mem_selftest() {
	rm -f "$D/mem_ok"
	command -v devmem >/dev/null || { echo "devmem missing"; return 1; }
	for p in 2 31 36 82 86; do
		set -- $(dbg_pin $p)
		dir=$1 lvl=$2
		v=$(mem_rd "$(io_addr $p)") || { echo "gpio$p: io read failed"; return 1; }
		c=$(mem_rd $(printf '0x%08x' $(( $(io_addr $p) - 4 )))) || { echo "gpio$p: ctl read failed"; return 1; }
		oe=$(( (c >> 9) & 1 )); fn=$(( (c >> 2) & 15 ))
		[ "$dir" = out ] && b=$(( (v >> 1) & 1 )) || b=$(( v & 1 ))
		want=0; [ "$lvl" = high ] && want=1
		if [ "$dir" = out ] && [ $oe != 1 ]; then echo "gpio$p: debugfs out, ctl OE=0 (ctl $c)"; return 1; fi
		if [ "$dir" = in ] && [ $oe != 0 ]; then echo "gpio$p: debugfs in, ctl OE=1 (ctl $c)"; return 1; fi
		[ $b = $want ] || { echo "gpio$p: debugfs $dir $lvl, io $v"; return 1; }
		case $p in 36|86) [ $fn = 0 ] && [ $oe = 1 ] || { echo "gpio$p: not a gpio output (ctl $c)"; return 1; } ;; esac
	done
	touch "$D/mem_ok"; echo "devmem agrees with debugfs on gpio 2 31 36 82 86"
}

# ---- module parameters / gates -----------------------------------------------
gates_close() {
	for f in "$PA/enable" "$PP/enable" "$PF/allow_power_on"; do [ -e "$f" ] && echo 0 > "$f"; done 2>/dev/null
}
gates_closed() { isN "$PA/enable" && isN "$PP/enable" && isN "$PF/allow_power_on"; }
setp() { # setp <file> <value> <expected readback>
	echo "$2" > "$1" 2>/dev/null; [ "$(rd "$1")" = "$3" ]
}
# locked <cmd...>: run <cmd> holding the abort lock (the one safe_off holds for
# its whole run), and refuse (status 3) once ABORTED is latched. Every step
# that can lead to power (zero_test, each gate, the pattern launch) goes
# through it, so an abort is totally ordered against them: a step either
# completes before safe_off starts (and safe_off then undoes it) or sees the
# latch and does nothing. Never call _safe while holding it.
locked() {
	( flock -x 9; [ -e "$D/ABORTED" ] && exit 3; "$@" ) 9>>"$D/safe.lck"
}
# launch the pattern detached (under the lock); safe_off kills it by name
launch_pattern() {
	# 9>&-: the child must not inherit (and so hold) the abort lock
	a9eink-pattern -d "$DEV" --hold 1 "$@" > "$D/pattern.$tag" 2>&1 9>&- &
	echo $! > "$D/pattern.pid"
	echo "$*" > "$D/last_pattern"   # what the a9_eink shadow holds from now on
}
# a9_eink starts an update only for pixels that CHANGED against its shadow
# (plane atomic_update -> a9e_fb_to_grey "changed"; the shadow starts white
# at probe and keeps every later commit, refused or dry). The same pattern
# twice in a row commits nothing: boot 13's e3t ("white" after e3b's
# "white") never powered up. same_as_shadow <pattern words>
same_as_shadow() { [ "$(cat "$D/last_pattern" 2>/dev/null || echo white)" = "$*" ]; }
bset() { # bset <bool parameter file> <0|1>: write, verify the readback
	echo "$2" > "$1" 2>/dev/null
	if [ "$2" = 1 ]; then isY "$1"; else isN "$1"; fi
}

# ---- abort path ------------------------------------------------------------------
# safe_off <latch 0|1> <reason>. Serialised (flock), idempotent, called by the
# stage runner, the kmsg watcher, the guardian timer and "safe".
#  1. a9_eink.enable=0 (emergency stop: the update aborts after the current
#     frame, commits a zero frame and powers the pipeline down, hold 0),
#     panel gate 0, fp9929a.allow_power_on=0, kill a9eink-pattern;
#  2. wait up to 3 s for GPIO 36 (VCOM_EN) and 86 (PWRUP) low;
#  3. still high: drive them low through TLMM (VCOM_EN, 50 ms, PWRUP: the stock
#     order, as the G9 panic notifier does), only if the devmem self-test passed;
#  4. still high: wait for fp9929a.max_on_ms (<= 20 s after power-up) to force
#     them down; still high after 22 s: reboot to the bootloader now (kernel
#     shutdown powers the FP9929A down; PON reason 2 lands in fastboot).
safe_off() {
	latch=$1; shift
	(
		flock -x 9
		[ "$latch" = 1 ] && { echo "$(now) $*" >> "$D/ABORTED"; log "ABORT: $*"; }
		gates_close
		# with patch 0021 a successful write of 0 means: no FP9929A enable in
		# flight and none can raise a pin any more; EBUSY = closed, not quiet
		echo 0 2>/dev/null > "$PF/allow_power_on" || log "safe: fp9929a.allow_power_on=0 returned an error (EBUSY: an enable is still in flight)"
		pkill a9eink-pattern 2>/dev/null
		i=0
		while [ $i -lt $(( 30 * SLOW )) ] && ! hv_is_off; do msleep 100; i=$((i + 1)); done
		if ! hv_is_off; then
			log "safe: HV still up 3 s after closing the gates (36: $(pin 36), 86: $(pin 86))"
			if mem_ok; then
				# VCOM_EN, then 50 ms, then PWRUP (stock order); every MMIO
				# read and write is checked, a failure is logged and the next
				# step still runs (fewer rails up is never worse)
				for p in 36 86; do
					a=$(io_addr $p)
					if v=$(mem_rd $a) && [ -n "$v" ]; then
						devmem $a 32 $(( v & ~2 )) || log "safe: TLMM write to $a (GPIO $p) failed"
						w=$(mem_rd $a) && [ $(( (w >> 1) & 1 )) = 0 ] || log "safe: GPIO $p output bit still set after the write (${w:-read failed})"
					else
						log "safe: TLMM read of $a (GPIO $p) failed: not written"
					fi
					[ $p = 36 ] && msleep 50
				done
				msleep 20
				log "safe: VCOM_EN and PWRUP driven low through TLMM (36: $(pin 36), 86: $(pin 86))"
			else
				log "safe: devmem not trusted, no TLMM force"
			fi
		fi
		if ! hv_is_off; then
			log "safe: CRITICAL HV still up; waiting for fp9929a.max_on_ms"
			i=0
			while [ $i -lt 220 ] && ! hv_is_off; do msleep 100; i=$((i + 1)); done
		fi
		if hv_is_off; then
			log "safe: verified PWRUP=0 VCOM_EN=0 (PG $(pin 82)); gates $(rd $PA/enable || echo -)/$(rd $PP/enable || echo -)/$(rd $PF/allow_power_on || echo -) (a9_eink/panel/fp9929a; - = not loaded)"
			echo "$(now) off-verified" >> "$D/safe.log"
		else
			log "safe: CRITICAL HV could not be verified off: reboot to bootloader NOW"
			echo "$(now) REBOOT" >> "$D/safe.log"
			sync; $REBOOT
		fi
	) 9>>"$D/safe.lck"
}

# ---- kmsg: logger, windows, watcher ------------------------------------------
# One logger appends every record ("pri,seq,ts,flags;msg") to kmsg.log, de-
# duplicated by sequence number (cat restarts if /dev/kmsg reports lost lines).
logger_start() {
	[ -s "$D/logger.pid" ] && kill -0 "$(cat "$D/logger.pid")" 2>/dev/null && return 0
	(
		while [ -d "$D" ]; do $KMSG_CMD 2>/dev/null; sleep 1; done |
		awk -F'[,;]' '/^ / { next } { s = $2 + 0; if (s > m) { m = s; print; fflush() } }' >> "$D/kmsg.log"
	) </dev/null >/dev/null 2>&1 &
	echo $! > "$D/logger.pid"
	i=0; while [ $i -lt 30 ] && ! grep -q . "$D/kmsg.log" 2>/dev/null; do msleep 100; i=$((i + 1)); done
	msleep 500
}
# win <tag>: messages ("L<level> <msg>") between the tag's open/close markers
win() {
	awk -v o="a9-eink-seq: MARK $1 open" -v c="a9-eink-seq: MARK $1 close" '
		{ i = index($0, ";"); m = substr($0, i + 1); split(substr($0, 1, i - 1), h, ",") }
		index(m, o) == 1 { on = 1; next }
		on && index(m, c) == 1 { exit }
		on { print "L" (h[1] % 8), m }' "$D/kmsg.log"
}
cnt() { grep -c -e "$2" "$D/win.$1" 2>/dev/null || true; }
# allmsg: every kernel message so far (for the pre checks), plus init's copy of
# the boot log in case the ring buffer has wrapped since
allmsg() {
	awk '{ i = index($0, ";"); print substr($0, i + 1) }' "$D/kmsg.log"
	sed 's/^\[[^]]*\] //' ${A9_SEQ_BOOTLOG:-/tmp/dmesg.boot} 2>/dev/null
}

# The watcher reads kmsg live (blocking, no polling delay), starts at the tag's
# open marker, and trips on the first record that is
#   - "a9-irqmon:" (IRQ storm), or
#   - a kernel message at warning level or worse (pri & 7 <= 4) that is not on
#     the stage's allow-list (benign or expected), or
#   - "fp9929a ... on:" without code 0x7e, or any "on:" in a no-HV stage, or
#   - an a9_eink zero test that ended with an error code.
# Userspace lines (a9-eink-seq/a9-ctl/a9-init/a9-eink:) are skipped.
# BENIGN: exact known-harmless kernel warnings (boot 8, 2026-10-15, both *_once):
#   msm's adreno lookup on the first DRM open (the GPU is disabled in our DT),
#   and the DPU programmable-fetch notice for this mode's short porches
BENIGN='supply [^ ]* not found, using dummy regulator|psci: failed to set PC mode|msm_dpu [^ ]*: no GPU device was found|low vbp.vfp may lead to perf issues in some cases'
watch_start() { # <tag> <nohv 0|1> <allow-regex or "">
	tag=$1 nohv=$2 allow=$3
	rm -f "$D/trip.$tag"
	# the abort runs from inside awk (system), not after the pipeline: cat on
	# /dev/kmsg would only notice the closed pipe at the next record
	(
		$KMSG_CMD 2>/dev/null | awk -v tag="$tag" -v nohv="$nohv" -v allow="$allow" -v benign="$BENIGN" \
			-v f="$D/trip.$tag" -v cmd="'$SELF' _trip $tag" '
			function trip() { print "L" l, m > f; close(f); system(cmd); exit }
			# /dev/kmsg dictionary continuation lines (" SUBSYSTEM=...", " DEVICE=...")
			# belong to the record before them; no header, no level (boot 8 false trip)
			/^ / || index($0, ";") == 0 { next }
			{ i = index($0, ";"); m = substr($0, i + 1); split(substr($0, 1, i - 1), h, ","); l = h[1] % 8 }
			!on { if (index(m, "a9-eink-seq: MARK " tag " open") == 1) on = 1; next }
			index(m, "a9-eink-seq: MARK " tag " close") == 1 { exit }
			m ~ /^(a9-eink-seq|a9-ctl|a9-init|a9-eink): / { next }
			m ~ /^a9-irqmon:/ { trip() }
			m ~ /fp9929a .*: on: / && (nohv == 1 || m !~ /code 0x7e/) { trip() }
			m ~ /zero test: .*\(-[0-9]+\)/ { trip() }
			l <= 4 && m !~ benign && !(allow != "" && m ~ allow) { trip() }
		'
	) </dev/null >/dev/null 2>&1 &
	echo $! > "$D/watch.$tag.pid"
}
watch_stop() { # the close marker ends the awk; kill as a backstop
	mark "$1 close"
	i=0; while [ $i -lt 20 ] && ! grep -qF "a9-eink-seq: MARK $1 close" "$D/kmsg.log"; do msleep 100; i=$((i + 1)); done
	msleep 200
	p=$(cat "$D/watch.$1.pid" 2>/dev/null); [ -n "$p" ] && { pkill -P "$p" 2>/dev/null; kill "$p" 2>/dev/null; }
	win "$1" > "$D/win.$1"
}
tripped() { [ -s "$D/trip.$1" ]; }

# guardian: hard deadline for one session, independent of the runner
guard_start() { # <tag> <seconds>
	( sleep $(( $2 * SLOW / SPEED + 1 )); [ -e "$D/done.$1" ] || "$SELF" _safe 1 "guardian: $1 still open after $2 s" ) </dev/null >/dev/null 2>&1 &
	echo $! > "$D/guard.$1.pid"
}
guard_stop() { touch "$D/done.$1"; p=$(cat "$D/guard.$1.pid" 2>/dev/null); [ -n "$p" ] && { pkill -P "$p" 2>/dev/null; kill "$p" 2>/dev/null; }; }

# sampler: "<uptime> o36 i36 o86 i86 o82 i82" every <period_ms>, at nice
# $SNICE (default 10: below the a9_eink worker, which sleeps in each commit; a
# starved sampler gives too few samples, and the PG verdict then fails closed:
# undetermined). Session load (frame pacing, boot 12): only E3 session A
# samples densely (5 ms, nice 10: it measures PG and sends template frames
# only); B, e3t and E5c sample at 100-250 ms and nice 19. The kmsg logger and
# watcher keep the default priority (the watcher must stay responsive).
# With devmem the loop stores the raw registers (three devmem reads, no other
# fork) and decodes afterwards, so 5 ms periods are possible; the debugfs
# fallback reads /sys/kernel/debug/gpio once per sample.
sampler_start() { # <file> <period_ms>
	rm -f "$D/stop.sampler" "$1.raw"
	nice -n "${SNICE:-$NICE}" "$SELF" _sampler "$1.raw" "$2" </dev/null >/dev/null 2>&1 &
	echo $! > "$D/sampler.pid"
}
sampler_stop() { # <file>: stop, decode into <file>
	touch "$D/stop.sampler"; msleep 200; kill "$(cat "$D/sampler.pid" 2>/dev/null)" 2>/dev/null
	while read -r t a b c; do
		case "$a" in
		0x*|0X*)
			case "$b$c" in
			0x*0x*|0X*0X*) echo "$t $(( (a >> 1) & 1 )) $(( a & 1 )) $(( (b >> 1) & 1 )) $(( b & 1 )) $(( (c >> 1) & 1 )) $(( c & 1 ))" ;;
			*) echo "$t x x x x x x" ;;   # a failed devmem read: never evidence
			esac ;;
		*) case "$a $b $c" in [01]\ [01]\ [01]*) echo "$t $a $b $c" ;; *) echo "$t x x x x x x" ;; esac ;;
		esac
	done < "$1.raw" > "$1"
}
sampler_loop() { # <raw file> <period_ms>
	us=$(( $2 * 1000 / SPEED ))
	if mem_ok; then
		a=$(io_addr 36) b=$(io_addr 86) c=$(io_addr 82)
		while [ ! -e "$D/stop.sampler" ]; do
			read -r up _ < /proc/uptime
			echo "$up $(devmem $a 32) $(devmem $b 32) $(devmem $c 32)"
			usleep $us
		done >> "$1"
	else
		while [ ! -e "$D/stop.sampler" ]; do
			read -r up _ < /proc/uptime
			awk -v t="$up" '/^gpiochip/ { k = ($0 ~ /500000[.]pinctrl/) }
				k && ($1 == "gpio36" || $1 == "gpio86" || $1 == "gpio82") { v[$1] = ($4 == "high") }
				END { printf "%s %d %d %d %d %d %d\n", t, v["gpio36"], v["gpio36"], v["gpio86"], v["gpio86"], v["gpio82"], v["gpio82"] }' "$DBG/gpio"
			usleep $us
		done >> "$1"
	fi
}

# ---- status of the a9_eink card ------------------------------------------------
eink_dir() { for s in $R/sys/class/drm/card*-DSI-1/eink/status; do [ -r "$s" ] && { dirname "$s"; return 0; }; done; return 1; }
# snap <name>: copy status; sv <name> <key>: value (last_* for the third line)
snap() { cat "$EINK/status" > "$D/st.$1" 2>/dev/null; }
sv() {
	awk -v k="$2" 'NR <= 2 { for (i = 1; i < NF; i += 2) if ($i == k) print $(i + 1) }
		NR == 3 { for (i = 2; i < NF; i += 2) if ("last_" $i == k) print $(i + 1) }' "$D/st.$1"
}
# dv <key> <after> <before>: the delta, or x when a value is missing (a kernel
# without that status field: never an arithmetic error, which would end the
# script, and never equal to 0)
dv() { a=$(sv "$2" "$1"); b=$(sv "$3" "$1"); if num "$a" && num "$b"; then echo $(( a - b )); else echo x; fi; }
live() { snap live; sv live "$1"; }

# msm counters: encoder vsync/underrun (DPU debugfs) and the "msm" IRQ line
msm_dbg() { for d in $DBG/dri/[0-9]*; do grep -q '^msm ' "$d/name" 2>/dev/null && { echo "$d"; return; }; done; }
enc_counts() { # -> "<vsync> <underrun>" summed over encoders, or "x x"
	m=$(msm_dbg); [ -n "$m" ] || { echo "x x"; return; }
	cat "$m"/encoder-*/status 2>/dev/null | awk '
		function after(k,   x) { if (!match($0, k " *[0-9]+")) return 0; x = substr($0, RSTART, RLENGTH); sub(k " *", "", x); return x + 0 }
		/vsync:/ { v += after("vsync:"); u += after("underrun:"); n++ }
		END { if (n) print v, u; else print "x x" }'
}
msm_irq() { awk '$NF == "msm" { s = 0; for (i = 2; i <= NF && $i ~ /^[0-9]+$/; i++) s += $i; print s; exit }' $R/proc/interrupts; }
mx_perf() { awk '$1 == "mx" { print $NF; exit }' $DBG/pm_genpd/pm_genpd_summary 2>/dev/null; }
batt_uv() { rd $R/sys/class/power_supply/battery/voltage_now; }
epd_mc() { for f in $R/sys/bus/iio/devices/iio:device*/in_temp_epd_top_therm_input; do [ -r "$f" ] && { cat "$f"; return; }; done; }

need() { # need <stage>: refuse unless <stage> passed and nothing aborted
	[ -e "$D/ABORTED" ] && { echo "refused: ABORTED latched: $(tail -n1 "$D/ABORTED")"; return 1; }
	[ -z "$1" ] || [ -e "$D/pass.$1" ] || { echo "refused: stage $1 has not passed"; return 1; }
}
envload() { [ -r "$D/env" ] && . "$D/env"; }
hv_add() { t=$(( $(cat "$D/hv_total_ms" 2>/dev/null || echo 0) + $1 )); echo $t > "$D/hv_total_ms"; }

# hv_time <samples> <period_ms> -> ms between the first and last sample with
# PWRUP or VCOM_EN high, plus one period (0 if never seen)
hv_time() {
	awk -v p="$2" '$2 == 1 || $4 == 1 { if (!f) f = $1; l = $1 }
		END { if (f) printf "%d", (l - f) * 1000 + p; else print 0 }' "$1"
}
# pg_verdict <samples>: steady-on = both controls high, at least 120 ms into
# that run of both-high samples: past fp9929a.pg_timeout_ms (100 ms after
# VCOM_EN, patch 0022/0023), so the driver has either seen PG 1 or already
# powered down; a slower but valid PG rise never counts against it (review
# 3). Edge samples are excluded. Off-settled = both low, >= 0.2 s after PWRUP fell (the
# end of the last power-down). Verdicts (since patch 0022 the drivers use
# PG active-high: fp9929a waits for PG = 1, a9_eink requires PG = 1):
#   active-high      steady-on PG all 1 AND settled-off all 0 (>= 3): the
#                    line toggles the way the drivers assume -> may continue
#                    (MEASURED on boot 9, 2026-10-15: on 2/2, off 0/54)
#   high-no-toggle   1 on and 1 off: PG says nothing -> stop
#   raw-low-when-on  steady-on all 0: the opposite of the drivers -> stop
#   high-off-unclear, low-*, unstable, undetermined (< 2 steady) -> stop
pg_verdict() {
	awk '{ for (k = 2; k <= 7; k++) if ($k !~ /^[01]$/) { bad++; next } }
		{ on = ($2 == 1 && $4 == 1) }
		on && !pon { rs = $1 }
		on && $1 - rs >= 0.12 { n++; if ($7 == 1) h++ }
		on { lt = $1; ne++; if ($7 == 1) eh++ }
		!on && $4 == 1 { pw++; if ($7 == 1) pwh++ }
		!on && !lt { pn++; if ($7 == 1) ph++ }
		lt && $2 == 0 && $4 == 0 && !dn { dn = $1 }
		on { dn = 0 }
		{ pon = on; t[NR] = $1; g[NR] = $7; o[NR] = on; z[NR] = ($2 == 0 && $4 == 0); d[NR] = dn }
		END {
			for (i = 1; i <= NR; i++) if (z[i] && d[i] && t[i] - d[i] >= 0.2) { fn++; if (g[i] == 1) fh++ }
			v = "undetermined"
			if (bad) v = "invalid-samples"
			else if (n >= 2 && h == n && fn >= 3 && fh == 0) v = "active-high"
			else if (n >= 2 && h == n && fn >= 1 && fh == fn) v = "high-no-toggle"
			else if (n >= 2 && h == n) v = "high-off-unclear"
			else if (n >= 2 && h == 0 && fn >= 3 && fh == fn) v = "raw-low-when-on"
			else if (n >= 2 && h == 0 && fh == 0) v = "low-no-toggle"
			else if (n >= 2 && h == 0) v = "low-off-unclear"
			else if (n >= 2) v = "unstable"
			printf "%s steady_on=%d/%d(high/n) on_incl_edge=%d/%d pwrup_only=%d/%d before=%d/%d after_settled=%d/%d bad=%d\n",
				v, h + 0, n + 0, eh + 0, ne + 0, pwh + 0, pw + 0, ph + 0, pn + 0, fh + 0, fn + 0, bad + 0
		}' "$1"
}

# ---- one HV session --------------------------------------------------------------
# session <tag> <zero_frames|0> <pattern> <sample_ms> <deadline_s> <midreads 0|1|2> <allow> <nohv> <hv_cap_ms>
# midreads: 1 = FP9929A/MX/pins at 1 s and 3 s after VCOM_EN rose (session B);
# 2 = the same plus the e3t reads (TC358767 raw I2C, clocks, DPU state) and
# HV ON/OFF lines for the user watching the glass. Sampler priority: $SNICE.
# hv_cap_ms: the per-session HV limit. ENFORCED IN THE KERNEL (patch 0024):
# written to fp9929a.max_on_ms (and read back) under the abort lock before the
# FP9929A gate opens; the FP9929A timer starts at energize, drops VCOM_EN, 50 ms,
# PWRUP at the cap even while this runner is blocked (pattern client, I2C reads,
# cleanup) and latches a fault. Restored to 20000 once the rails are verified
# off. The shell check in the wait loop below is an extra, best-effort only
# (it is blind while the runner blocks). 0 = no HV allowed (no-HV stage).
# Opens the gates the stage asks for (GATES="fp panel enable"), triggers one
# update, waits for it to end, closes everything, verifies HV off.
session() {
	tag=$1 zn=$2 pat=$3 per=$4 dl=$5 mid=$6 allow=$7 nohv=$8 hvcap=${9:-0}
	same_as_shadow $pat && noupd=1 || noupd=0
	S=$D/samples.$tag
	: > "$S"
	snap "$tag.0"
	set -- $(enc_counts); echo "$1 $2 $(msm_irq) $(now)" > "$D/msm.$tag.0"
	mark "$tag open"
	watch_start "$tag" "$nohv" "$allow"
	guard_start "$tag" "$dl"
	sampler_start "$S" "$per"
	msleep 300                                     # baseline samples, off level
	hook baseline
	# opening: every step under the abort lock; the first refusal or failure
	# ends the opening for good (no step is ever retried or resumed)
	ok=1 tg=$(now_ms)
	if [ $noupd = 1 ]; then
		# nothing would be updated: do not open anything, fail the stage
		log "$tag: pattern '$pat' equals what the a9_eink shadow holds: no update would run; gates stay closed"
		chk "$tag.pattern" 0 "pattern '$pat' = the shadow's content: no update possible (sequencer bug)"
		ok=0
	fi
	[ $ok = 1 ] && { locked setp "$PA/zero_test" "$zn" "$zn"; r=$?; }
	[ $ok = 1 ] || r=0
	[ $r = 0 ] || { log "$tag: zero_test $zn not set ($r)"; ok=0; }
	[ $ok = 1 ] && hook zero_test
	case " $GATES " in *" fp "*)
		# the kernel cap must be in place before the FP9929A gate opens
		if [ $ok = 1 ]; then
			if [ "$hvcap" -ge 1 ] && [ "$hvcap" -le $FP_MAX_ON_MS ]; then
				locked setp "$PF/max_on_ms" "$hvcap" "$hvcap"; r=$?
			else r=2; fi
			[ $r = 0 ] || { log "$tag: fp9929a.max_on_ms $hvcap not set ($r, read back $(rd $PF/max_on_ms))"; ok=0; }
			[ $ok = 1 ] && hook max_on
		fi ;;
	esac
	for g in $GATES; do
		[ $ok = 1 ] || break
		case $g in
		fp) tg=$(now_ms); locked bset "$PF/allow_power_on" 1 ;;
		panel) locked bset "$PP/enable" 1 ;;
		enable) locked bset "$PA/enable" 1 ;;
		esac
		r=$?
		[ $r = 0 ] || { log "$tag: gate $g not opened ($([ $r = 3 ] && echo 'ABORTED latched' || echo "readback, $r"))"; ok=0; break; }
		hook "gate_$g"
	done
	u0=$(sv "$tag.0" updates) a0=$(sv "$tag.0" aborts)
	if [ $ok = 1 ]; then
		locked launch_pattern $pat; r=$?
		[ $r = 0 ] || { log "$tag: pattern not launched ($r)"; ok=0; }
	fi
	[ $ok = 1 ] || [ -e "$D/ABORTED" ] || "$SELF" _safe 1 "$tag: could not set up the session"
	if [ $ok = 1 ]; then
		log "$tag: gates [$GATES] open, zero_test $zn: a9eink-pattern $pat"
		hook launched
		p=$(cat "$D/pattern.pid"); i=0
		while kill -0 "$p" 2>/dev/null && [ $i -lt 150 ]; do msleep 100; i=$((i + 1)); done
		kill "$p" 2>/dev/null; wait "$p" 2>/dev/null; echo "exit $?" >> "$D/pattern.$tag"
	fi
	# wait: update or abort counted, pipeline off, (HV lines low)
	t0=$(now_ms) ton="" m1="" m2="" me="" end=$(( $(now_ms) + dl * SLOW * 1000 / SPEED ))
	while [ $ok = 1 ] && [ $(now_ms) -lt $end ] && [ ! -e "$D/ABORTED" ]; do
		snap live
		if [ "$(sv live updates)" != "$u0" ] || [ "$(sv live aborts)" != "$a0" ]; then
			[ "$(sv live hv_on)" = 0 ] && break
		fi
		# best-effort shell backstop at cap + 1 s + min_off from the gate
		# opening (the binding limit is the kernel's max_on_ms, counted from
		# energize; patch 0025 may delay energize by up to min_off_ms)
		if [ $(( $(now_ms) - tg )) -ge $(( (hvcap + 1000 + FP_MIN_OFF_MS) * SLOW / SPEED )) ] && ! hv_is_off; then
			"$SELF" _safe 1 "$tag: shell HV backstop: PWRUP/VCOM_EN still high $(( $(now_ms) - tg )) ms after the gate opened (kernel cap $hvcap ms)"
			break
		fi
		if [ "$mid" != 0 ]; then
			if [ -z "$ton" ] && [ "$(pin 36)" != "0 0" ]; then
				ton=$(now_ms)
				# a line the user can match with what the glass does (e3t)
				[ "$mid" = 2 ] && log "$tag: HV ON (VCOM_EN high) at uptime $(now) s: WATCH THE GLASS, expected unchanged (template frames drive nothing)"
			fi
			if [ -n "$ton" ] && [ -z "$m1" ] && [ $(now_ms) -ge $(( ton + 1000 * SLOW / SPEED )) ]; then midread "$tag" 1; m1=1; fi
			# e3t: DSIERRCNT again 1 s after mid read 1 (the counter's delta)
			if [ "$mid" = 2 ] && [ -n "$m1" ] && [ -z "$me" ] && [ $(now_ms) -ge $(( ton + 2000 * SLOW / SPEED )) ]; then
				tc_reg_line "$tag" e 0x0300 DSIERRCNT >> "$D/$tag/regs.txt"; me=1
			fi
			if [ -n "$ton" ] && [ -z "$m2" ] && [ $(now_ms) -ge $(( ton + 3000 * SLOW / SPEED )) ]; then midread "$tag" 2; m2=1; fi
		fi
		msleep 100
	done
	if [ $(now_ms) -ge $end ]; then "$SELF" _safe 1 "$tag: no end of update within $dl s"; fi
	gates_close
	# HV must be down within 2 s of the update's end (stock power-down is 51 ms)
	i=0; while [ $i -lt $(( 20 * SLOW )) ] && ! hv_is_off; do msleep 100; i=$((i + 1)); done
	hv_is_off || "$SELF" _safe 1 "$tag: PWRUP/VCOM_EN still high 2 s after the update"
	[ "$mid" = 2 ] && log "$tag: HV OFF at uptime $(now) s (PWRUP/VCOM_EN low: $(hv_is_off && echo yes || echo NO)): the glass check ends here"
	# rails off (verified, or the abort path ran): the default cap back
	if [ "$(rd $PF/max_on_ms)" != $FP_MAX_ON_MS ]; then
		setp "$PF/max_on_ms" $FP_MAX_ON_MS $FP_MAX_ON_MS || log "$tag: fp9929a.max_on_ms not restored to $FP_MAX_ON_MS (read $(rd $PF/max_on_ms); a smaller cap only fails safe)"
	fi
	msleep 600                                     # settled off-level samples
	sampler_stop "$S"
	guard_stop "$tag"
	snap "$tag.1"
	set -- $(enc_counts); echo "$1 $2 $(msm_irq) $(now)" > "$D/msm.$tag.1"
	watch_stop "$tag"
	ht=$(hv_time "$S" "$per"); hv_add "$ht"; echo "$ht" > "$D/hv_ms.$tag"
	log "$tag: session closed, HV-on ~${ht} ms (total $(cat $D/hv_total_ms) ms), PWRUP/VCOM_EN low: $(hv_is_off && echo yes || echo NO)"
}

# mid-session reads while the rails are up (E3 session B only)
midread() {
	f=$D/mid.$1.$2
	{
		echo "t $(now)"
		echo "pins $(pins)"
		echo "vcom $(timeout 3 i2cget -f -y 0 0x48 0x02 b 2>&1)"
		echo "tmst $(timeout 3 i2cget -f -y 0 0x48 0x00 b 2>&1)"
		echo "mx $(mx_perf)"
		echo "enc $(enc_counts)"
		echo "irq $(msm_irq)"
		echo "hv_on $(live hv_on) frames $(live frames)"
	} > "$f"
	[ "$1" = e3t ] && e3t_mid "$1" "$2"
	return 0
}

# ---- e3t: read-only bridge, clock and DPU reads (template frames only) --------
# TC358767 registers read RAW over I2C (i2ctransfer: 16-bit big-endian address,
# 4 data bytes little-endian; -f because tc358767 owns 0-000f), bypassing the
# regmap cache. All reads; none in this list is read-to-clear except SYSSTAT
# (0x0508, the only register in the driver's tc_precious_ranges: the IRQ
# handler reads it after INT_SYSERR), so it is read LAST. INTSTS_G and
# DSI_INTSTATUS are cleared by WRITES (the driver writes INTSTS_G back;
# DSI_INTCLR is a separate register), so reading them changes nothing.
# DSIERRCNT is volatile, not precious, in the driver; whether the chip clears
# it on read is not known here (no datasheet in the repo): it is read after
# the others, and its two values 1 s apart are reported as they are.
# "<reg> <name> [<init-sequence value>]" (docs/mainline/sm6115-hisense-hlte556n.dts)
TC_REGS="0x0500:TC_IDREG 0x0510:SYSCTRL:0x00000001 0x050c:SYSRSTENB 0x0108:PPI_BUSYPPI 0x0208:DSI_BUSYDSI
0x0214:DSI_LANESTATUS0 0x0218:DSI_LANESTATUS1 0x0220:DSI_INTSTATUS 0x0564:INTSTS_G
0x0448:POCTRL:0x00000086 0x0450:VPCTRL0:0x03f00100 0x0454:HTIM01:0x001d0003 0x045c:VTIM01:0x00040002
0x0464:VFUEN0:0x00000001 0x0908:PXL_PLLCTRL:0x00000005 0x0914:PXL_PLLPARAM:0x00118301
0x0300:DSIERRCNT 0x0508:SYSSTAT"
CLKS="disp_cc_mdss_byte0_clk:59500000:60700000 disp_cc_mdss_pclk0_clk:39680000:40480000"
# tc_reg_line <tag> <point> <reg> <name>: one line of <tag>/regs.txt
#   "<point> <uptime> <reg> <name> <value|x> raw <i2ctransfer output>"
tc_reg_line() {
	o=$(timeout 3 i2ctransfer -f -y 0 w2@0x0f $(printf '0x%02x 0x%02x' $(( $3 >> 8 )) $(( $3 & 255 ))) r4 2>&1 | tr '\n' ' ')
	set -- "$1" "$2" "$3" "$4" $o
	v=x
	if [ $# = 8 ]; then
		case "$5$6$7$8" in
		0x*0x*0x*0x*) v=$(printf '0x%08x' $(( $5 | ($6 << 8) | ($7 << 16) | ($8 << 24) ))) ;;
		esac
	fi
	echo "$2 $(now) $3 $4 $v raw $o"
}
e3t_mid() { # <tag> <point 1|2>
	X=$D/$1; mkdir -p "$X"
	for e in $TC_REGS; do
		r=${e%%:*}; n=${e#*:}; n=${n%%:*}
		tc_reg_line "$1" "$2" "$r" "$n" >> "$X/regs.txt"
	done
	for c in $CLKS; do echo "$2 $(now) clk ${c%%:*} $(rd "$DBG/clk/${c%%:*}/clk_rate" || echo x)" >> "$X/regs.txt"; done
	if [ "$2" = 2 ]; then
		# the DPU state print takes the modeset locks and can delay one
		# commit: the status is snapshotted first, and late/vbl_skips/
		# max_gap gate only up to here (template frames drive nothing,
		# and the frame-progress interlock is not armed without a drive
		# frame). Read in the background, so the runner never blocks on it.
		snap "$1.ps"
		m=$(msm_dbg)
		( timeout 5 cat "$m/state" > "$X/state.txt" 2>&1; echo "rc $?" > "$X/state.rc" ) </dev/null >/dev/null 2>&1 &
	fi
}
# regv <tag> <point> <reg>: the value read at that point (x if failed/absent)
# a missing regs.txt (no mid read ran, e.g. HV never rose) reads as x, not ""
regv() { [ -r "$D/$1/regs.txt" ] || { echo x; return; }; awk -v k="$2" -v r="$3" '$1 == k && $3 == r { v = $5 } END { print (v == "" ? "x" : v) }' "$D/$1/regs.txt" 2>/dev/null; }
clkv() { [ -r "$D/$1/regs.txt" ] || { echo x; return; }; awk -v k="$2" -v c="$3" '$1 == k && $3 == "clk" && $4 == c { v = $5 } END { print (v == "" ? "x" : v) }' "$D/$1/regs.txt" 2>/dev/null; }
mid() { awk -v k="$3" '$1 == k { $1 = ""; sub(/^ /, ""); print; exit }' "$D/mid.$1.$2" 2>/dev/null; }

# common HV-session criteria: the "on:" line, the bridge, kmsg, HV off/time
crit_hv() { # <tag> <max_hv_ms>
	t=$1
	n=$(cnt "$t" 'fp9929a .*: on: ')
	chk "$t.fp_on_once" $([ "$n" = 1 ] && echo 1 || echo 0) "fp9929a 'on:' lines: $n (want 1)"
	l=$(grep -m1 'fp9929a .*: on: ' "$D/win.$t" 2>/dev/null)
	chk "$t.vcom" $(echo "$l" | grep -qF "$VCOM_LINE" && echo 1 || echo 0) "${l:-no on line}"
	tc=$(echo "$l" | sed -n 's/.*temp \(-*[0-9]*\) C.*/\1/p'); e=$(( $(epd_mc || echo -99000) / 1000 ))
	chk "$t.temp" $(between "$tc" 5 45 && [ $(( tc > e ? tc - e : e - tc )) -le 10 ] && echo 1 || echo 0) "FP9929A TMST $tc C, epd_top_therm $e C (5-45, within 10)"
	info "$t.pg_settle" "$(echo "$l" | sed -n 's/.*PG \(-*[0-9]*\) after \([0-9]*\) us.*/PG \1 after \2 us (fp9929a waited for it, patch 0022)/p')"
	chk "$t.bridge_id" $([ "$(cnt "$t" 'tc358767 .*before init sequence: ID read 0, ID 0x6601')" -ge 1 ] && echo 1 || echo 0) \
		"$(grep -m1 'before init sequence' "$D/win.$t" || echo 'no ID line')"
	# the ID line may come from the regmap cache (TC_IDREG is not volatile);
	# the evidence that the bridge answered on THIS power-up is the 25 raw
	# init writes (i2c_transfer, uncached) all succeeding
	ie=$(cnt "$t" 'tc358767 .*init seq #')
	chk "$t.init_errors" $([ "$ie" = 0 ] && echo 1 || echo 0) "bridge init-sequence write failures: $ie (raw I2C, uncached: the bridge answered)"
	chk "$t.stream_ok" $([ "$(cnt "$t" 'main link stream start error')" = 0 ] && echo 1 || echo 0) "no 'main link stream start error'"
	chk "$t.kmsg_clean" $(tripped "$t" && echo 0 || echo 1) "$(tripped "$t" && head -c 200 "$D/trip.$t" || echo 'no warning/error/fault/storm line')"
	ht=$(cat "$D/hv_ms.$t")
	chk "$t.hv_time" $([ "$ht" -le $(( $2 * SLOW )) ] && echo 1 || echo 0) "HV on ~$ht ms (max $(( $2 * SLOW )))"
	chk "$t.hv_off" $(hv_is_off && echo 1 || echo 0) "PWRUP/VCOM_EN now: $(pin 86) / $(pin 36)"
	chk "$t.hv_budget" $([ "$(cat $D/hv_total_ms)" -le $HV_BUDGET_MS ] && echo 1 || echo 0) "boot total $(cat $D/hv_total_ms) ms (max $HV_BUDGET_MS)"
}
# crit_frames <tag> <expected frames or ""> [<timing end snapshot>]: counters.
# DRIVE=0 (E3 A/B, e3t: template frames only, patch 0028): the total late/
# vbl_skips/max_gap gate (up to the timing end snapshot, default <tag>.1),
# and the drive counters (gaps with a DRIVE frame on the glass, patch 0029)
# must not move at all. DRIVE=1 (E5c): the drive counters gate (late_drive +0,
# vbl_skips_drive +0, max_gap_drive_us <= 1.5 periods) IN ADDITION to the
# totals, which also gate (review 10: drive attribution can miss a slow
# incoming drive commit; refusing on a harmless idle delay is preferred).
crit_frames() {
	t=$1 te=${3:-$1.1}
	chk "$t.updates" $([ "$(dv updates $t.1 $t.0)" = 1 ] && echo 1 || echo 0) "updates +$(dv updates $t.1 $t.0) (want +1)"
	chk "$t.aborts" $([ "$(dv aborts $t.1 $t.0)" = 0 ] && echo 1 || echo 0) "aborts +$(dv aborts $t.1 $t.0)"
	[ -n "$2" ] && chk "$t.frames" $([ "$(dv frames $t.1 $t.0)" = "$2" ] && echo 1 || echo 0) "frames +$(dv frames $t.1 $t.0) (want $2)"
	chk "$t.template" $([ "$(sv $t.1 template)" = 1 ] && echo 1 || echo 0) "status template $(sv $t.1 template) (1 = control template loaded and valid, patch 0028)"
	ng=$NOGATE
	w=""; [ "$te" != "$t.1" ] && w=" (up to the DPU state read; the whole session: +$(dv late $t.1 $t.0))"
	chk "$t.late" $([ "$(dv late $te $t.0)" = 0 ] && echo 1 || echo 0) "late +$(dv late $te $t.0)$w"
	w=""; [ "$te" != "$t.1" ] && w=" (up to the DPU state read; the whole session: +$(dv vbl_skips $t.1 $t.0))"
	chk "$t.vbl_skips" $([ "$(dv vbl_skips $te $t.0)" = 0 ] && echo 1 || echo 0) "vbl_skips +$(dv vbl_skips $te $t.0)$w"
	g=$(sv $te max_gap_us)
	w=""; [ "$te" != "$t.1" ] && w="; at the end $(sv $t.1 max_gap_us)"
	chk "$t.max_gap" $(between "$g" 1 $MAXGAP_US && echo 1 || echo 0) "max_gap_us $g (<= $MAXGAP_US; cumulative maximum$w)"
	NOGATE=$ng
	if [ "${DRIVE:-0}" = 1 ]; then
		chk "$t.late_drive" $([ "$(dv late_drive $t.1 $t.0)" = 0 ] && echo 1 || echo 0) "late_drive +$(dv late_drive $t.1 $t.0) (gaps > 1.5 periods with a drive frame on the glass)"
		chk "$t.vbl_skips_drive" $([ "$(dv vbl_skips_drive $t.1 $t.0)" = 0 ] && echo 1 || echo 0) "vbl_skips_drive +$(dv vbl_skips_drive $t.1 $t.0)"
		g=$(sv $t.1 max_gap_drive_us)
		chk "$t.max_gap_drive" $(between "$g" 0 $MAXGAP_US && echo 1 || echo 0) "max_gap_drive_us ${g:-missing} (<= $MAXGAP_US; cumulative maximum)"
	else
		# no drive frame is ever sent here: the drive counters stay put
		chk "$t.late_drive" $([ "$(dv late_drive $t.1 $t.0)" = 0 ] && echo 1 || echo 0) "late_drive +$(dv late_drive $t.1 $t.0) (template frames only: want +0)"
		chk "$t.vbl_skips_drive" $([ "$(dv vbl_skips_drive $t.1 $t.0)" = 0 ] && echo 1 || echo 0) "vbl_skips_drive +$(dv vbl_skips_drive $t.1 $t.0) (want +0)"
		chk "$t.max_gap_drive" $([ "$(dv max_gap_drive_us $t.1 $t.0)" = 0 ] && echo 1 || echo 0) "max_gap_drive_us $(sv $t.1 max_gap_drive_us) (+$(dv max_gap_drive_us $t.1 $t.0); want +0)"
	fi
	chk "$t.hv_on" $([ "$(sv $t.1 hv_on)" = 0 ] && echo 1 || echo 0) "status hv_on $(sv $t.1 hv_on) after the session"
	set -- $(cat "$D/msm.$t.0") ; v0=$1 u0=$2 i0=$3
	set -- $(cat "$D/msm.$t.1") ; v1=$1 u1=$2 i1=$3
	if [ "$v0" != x ] && [ "$v1" != x ]; then
		chk "$t.underrun" $([ $((u1 - u0)) = 0 ] && echo 1 || echo 0) "DPU underrun counter +$((u1 - u0))"
		chk "$t.vsync_adv" $([ $((v1 - v0)) -ge "$(dv frames $t.1 $t.0)" ] && echo 1 || echo 0) "DPU vsync +$((v1 - v0)) for frames +$(dv frames $t.1 $t.0)"
	else
		info "$t.underrun" "no DPU encoder debugfs status; msm IRQ +$(( ${i1:-0} - ${i0:-0} ))"
		chk "$t.vsync_adv" $([ $(( ${i1:-0} - ${i0:-0} )) -ge "$(dv frames $t.1 $t.0)" ] && echo 1 || echo 0) "msm IRQ +$(( ${i1:-0} - ${i0:-0} )) for frames +$(dv frames $t.1 $t.0)"
	fi
}

# zero_line <tag> <N>: the zero test's end line. Since patch 0028 the zero-test
# frames are the control template ("template frames"); the old text means a
# kernel without 0028, whose frames had zeros in the control bytes too (boot
# 12: the panel was never clocked)
zero_line() {
	if [ "$(cnt "$1" "zero test: $2/$2 template frames with HV on (0)")" = 1 ]; then
		chk "$1.zero_line" 1 "zero test $2/$2 template frames (0)"
	elif [ "$(cnt "$1" 'all-zero frames with HV on')" != 0 ]; then
		chk "$1.zero_line" 0 "kernel without patch 0028: '$(grep -m1 'all-zero frames with HV on' "$D/win.$1" | sed 's/^L[0-9] //')' (no control template in the frames)"
	else
		chk "$1.zero_line" 0 "no 'zero test: $2/$2 template frames with HV on (0)' line ($(grep -m1 'zero test:' "$D/win.$1" | sed 's/^L[0-9] //' || true))"
	fi
}

finish() { # <stage> : write the RESULT line and pass/fail files
	if [ $FAILS = 0 ] && [ ! -e "$D/ABORTED" ]; then
		touch "$D/pass.$1"; echo "RESULT $1 PASS${2:+ $2}"
	else
		[ -e "$D/ABORTED" ] || "$SELF" _safe 1 "$1: $FAILS criteria failed"
		touch "$D/fail.$1"; echo "RESULT $1 FAIL ($FAILS criteria${2:+; $2})"
		[ -e "$D/ABORTED" ] && echo "ABORTED: $(tail -n1 "$D/ABORTED")"
	fi
}

# ---- stages --------------------------------------------------------------------------
st_pre() {
	need "" || return 1
	[ -e "$D/pass.pre" ] && { echo "pre already passed"; echo "RESULT pre PASS"; return 0; }
	logger_start
	mark "pre open"
	M=$D/allmsg.pre; allmsg > "$M"
	chk pre.msm_drm $(grep -q '\[drm\] Initialized msm' "$M" && echo 1 || echo 0) "msm DRM bound (E2b)"
	chk pre.tc358767 $([ -e $R/sys/bus/i2c/drivers/tc358767/0-000f ] && echo 1 || echo 0) "tc358767 bound to 0-000f"
	chk pre.vcom_src $(grep -q 'fp9929a .*VCOM 2730 mV (from cmdline) -> code 0x7e' "$M" && echo 1 || echo 0) "VCOM 2730 mV from the ABL cmdline, code 0x7e"
	chk pre.no_fp_fault $(grep -q 'max_on_ms .* expired' "$M" && echo 0 || echo 1) "no fp9929a max_on_ms fault so far"
	chk pre.no_fp_on $(grep -q 'fp9929a .*: on: ' "$M" && echo 0 || echo 1) "the FP9929A was never powered in this boot"
	chk pre.fp_max_on $([ "$(rd $PF/max_on_ms)" = $FP_MAX_ON_MS ] && echo 1 || echo 0) "fp9929a.max_on_ms $(rd $PF/max_on_ms) (want $FP_MAX_ON_MS)"
	chk pre.fp_min_off $([ "$(rd $PF/min_off_ms)" = $FP_MIN_OFF_MS ] && echo 1 || echo 0) "fp9929a.min_off_ms $(rd $PF/min_off_ms) (want $FP_MIN_OFF_MS: VGL discharge, patch 0025)"
	gates_close
	chk pre.gates $(isN $PF/allow_power_on && isN $PP/enable && echo 1 || echo 0) "fp9929a gate $(rd $PF/allow_power_on), panel gate $(rd $PP/enable)"
	# trailing slash: /proc/device-tree is a symlink, and find does not
	# descend into a symlinked starting point (boot 7, 2026-10-15)
	pg=$(find "$R/proc/device-tree/" -name pg-gpios -path '*pmic@48*' 2>/dev/null | head -n1)
	fl=$(od -An -tu1 "$pg" 2>/dev/null | tr -s ' \n' ' ' | awk '{ print $(NF-3) * 16777216 + $(NF-2) * 65536 + $(NF-1) * 256 + $NF }')
	chk pre.pg_dt_flags $([ "$fl" = 0 ] && echo 1 || echo 0) "DT pg-gpios flags ${fl:-?} (0 = active-high: logical PG = raw GPIO82)"
	r=$(mem_selftest); chk pre.devmem $(mem_ok && echo 1 || echo 0) "$r"
	chk pre.hv_low $(hv_is_off && echo 1 || echo 0) "GPIO 36 $(pin 36) 86 $(pin 86) (out in), PG 82 $(pin 82)"
	b=$(batt_uv); chk pre.battery $(between "$b" 3800000 4500000 && echo 1 || echo 0) "battery ${b:-?} uV (>= 3.8 V)"
	e=$(epd_mc); chk pre.epd_temp $(between "$e" 5000 45000 && echo 1 || echo 0) "epd_top_therm ${e:-?} mC (5-45 C)"
	# host hashes: "pre [FW_SHA256 [CT_SHA256]]", "-" = not given
	h1=$1 h2=${2:-}; [ "$h1" = - ] && h1=""; [ "$h2" = - ] && h2=""
	s=$(sha256sum "$FW" 2>/dev/null | cut -d' ' -f1)
	chk pre.waveform $([ -n "$s" ] && { [ -z "$h1" ] || [ "$s" = "$h1" ]; } && echo 1 || echo 0) "$FW sha256 ${s:-missing}${h1:+ (host: $h1)}"
	# control template (patch 0028): header (magic "A9CT", version 1, header
	# 80, payload 1485568), payload sha256 = the value the kernel compiles in,
	# whole file = the host's copy. The kernel checks it again at load.
	s=$(sha256sum "$CT" 2>/dev/null | cut -d' ' -f1)
	chk pre.template_file $([ -n "$s" ] && { [ -z "$h2" ] || [ "$s" = "$h2" ]; } && echo 1 || echo 0) "$CT sha256 ${s:-missing}${h2:+ (host: $h2)}"
	hd=$(od -An -tu1 -N16 "$CT" 2>/dev/null | tr -s ' \n' ' ' | sed 's/^ //; s/ $//')
	chk pre.template_header $([ "$hd" = "65 57 67 84 1 0 0 0 80 0 0 0 0 171 22 0" ] && [ "$(wc -c < "$CT" 2>/dev/null)" = $CT_BYTES ] && echo 1 || echo 0) "header ${hd:-unreadable}, $(wc -c < "$CT" 2>/dev/null || echo 0) bytes (want A9CT v1, 80 + 1485568 = $CT_BYTES)"
	ps=$(tail -c +81 "$CT" 2>/dev/null | sha256sum | cut -d' ' -f1)
	chk pre.template_payload $([ -s "$CT" ] && [ "$ps" = "$CT_SHA" ] && echo 1 || echo 0) "payload sha256 $([ -s "$CT" ] && echo "$ps" || echo -) (want $CT_SHA)"
	chk pre.pattern $(command -v a9eink-pattern >/dev/null && echo 1 || echo 0) "a9eink-pattern present"
	[ $FAILS = 0 ] || echo "  info pre.modprobe: NOT run, $FAILS criteria above failed; the a9_eink checks below fail as a consequence"
	if [ $FAILS = 0 ] && [ ! -d $PA ]; then
		modprobe a9_eink hv_hold_ms=0 hv_max_ms=$HV_MAX_MS zero_test=0 init_flash=1 trace=0 > "$D/modprobe.out" 2>&1
		mrc=$?
		chk pre.modprobe $([ $mrc = 0 ] && echo 1 || echo 0) "modprobe a9_eink hv_hold_ms=0 hv_max_ms=$HV_MAX_MS zero_test=0 init_flash=1 trace=0"
		msleep 1000
	fi
	chk pre.p_enable $(isN $PA/enable && echo 1 || echo 0) "a9_eink.enable $(rd $PA/enable)"
	chk pre.p_hold $([ "$(rd $PA/hv_hold_ms)" = 0 ] && echo 1 || echo 0) "hv_hold_ms $(rd $PA/hv_hold_ms) (want 0)"
	chk pre.p_max $([ "$(rd $PA/hv_max_ms)" = $HV_MAX_MS ] && [ $HV_MAX_MS -lt "$(rd $PF/max_on_ms)" ] && echo 1 || echo 0) "hv_max_ms $(rd $PA/hv_max_ms) < fp9929a.max_on_ms $(rd $PF/max_on_ms)"
	chk pre.p_zero $([ "$(rd $PA/zero_test)" = 0 ] && echo 1 || echo 0) "zero_test $(rd $PA/zero_test)"
	chk pre.p_init $(isY $PA/init_flash && isN $PA/trace && echo 1 || echo 0) "init_flash $(rd $PA/init_flash) trace $(rd $PA/trace)"
	chk pre.p_fmt $([ "$(rd $PA/transport_format)" = XR24 ] && echo 1 || echo 0) "transport_format $(rd $PA/transport_format)"
	chk pre.p_bins $([ "$(rd $PA/bin_min)" = 0 ] && [ "$(rd $PA/bin_max)" = 13 ] && echo 1 || echo 0) "bin_min/bin_max $(rd $PA/bin_min)/$(rd $PA/bin_max) (0/13; patch 0026)"
	EINK=$(eink_dir); CARD=$(basename "$(dirname "$EINK")" 2>/dev/null); CARD=${CARD%-DSI-1}
	DEV=/dev/dri/$CARD
	chk pre.card $([ -n "$EINK" ] && [ -c "$R$DEV" -o -e "$R$DEV" ] && echo 1 || echo 0) "a9_eink card ${CARD:-?} ($EINK)"
	if [ -n "$EINK" ]; then
		snap pre
		chk pre.status $([ "$(sv pre enable)" = 0 ] && [ "$(sv pre hv_on)" = 0 ] && [ "$(sv pre stall_fault)" = 0 ] && echo 1 || echo 0) "$(head -n1 "$D/st.pre")"
		# patch 0028/0029 status fields; template is 0 until the first update
		# loads it with the waveform (checked as 1 after every HV session)
		chk pre.kernel_0028 $(num "$(sv pre template)" && num "$(sv pre late_drive)" && num "$(sv pre vbl_skips_drive)" && num "$(sv pre max_gap_drive_us)" && echo 1 || echo 0) \
			"status template '$(sv pre template)' late_drive '$(sv pre late_drive)' vbl_skips_drive '$(sv pre vbl_skips_drive)' max_gap_drive_us '$(sv pre max_gap_drive_us)' (missing = kernel without patches 0028/0029)"
	fi
	allmsg > "$M"
	chk pre.dry_banner $(grep -q 'E Ink KMS 824x1648; frames dry run' "$M" && echo 1 || echo 0) "a9_eink probed in dry-run mode"
	cat > "$D/env" <<-EOF
	EINK=$EINK
	DEV=$DEV
	CARD=$CARD
	EOF
	mark "pre close"
	finish pre
}

st_e3() {
	E3MODE="$*"   # "", "full" or "full stop"; saved now: later code uses set --
	need pre || return 1
	envload
	[ -e "$D/pass.e3" ] && { echo "RESULT e3 PASS (already)"; return 0; }
	# Session A: PG sampling across power-up, steady on and power-down
	GATES="fp panel enable"
	if mem_ok; then pa=5; else pa=50; fi
	session e3a $E3A_N black $pa $(( E3A_N / 85 + 10 )) 0 "" 0 $(( E3A_N * 1000 / 85 + HV_SETUP_MS ))
	PG=$(pg_verdict "$D/samples.e3a"); echo "$PG" > "$D/pg_verdict"
	log "e3a: PG verdict: $PG"
	echo "PG_VERDICT $PG"
	crit_hv e3a $(( E3A_N * 1000 / 85 + 2000 ))
	refused=$(cnt e3a 'FP9929A is not on after enable')
	chk e3a.a9_accepted_hv $([ "$refused" = 0 ] && echo 1 || echo 0) "a9_eink's own PG/HV check $([ "$refused" = 0 ] && echo passed || echo 'REFUSED (no frame sent)')"
	zero_line e3a $E3A_N
	info e3a.template_kmsg "$(grep -m1 'control template loaded' "$D/win.e3a" | sed 's/^L[0-9] //' || true) (the template loads with the waveform at the first update)"
	# the kernel prints %#x of 0 as "0x0" (lib/vsprintf.c: the prefix does not
	# depend on the value; boot 10): compare numerically
	chk e3a.last $([ "$(hexnum "$(sv e3a.1 last_mode)")" = 0 ] && [ "$(sv e3a.1 last_frames)" = $E3A_N ] && [ "$(sv e3a.1 last_aborted)" = 0 ] && echo 1 || echo 0) \
		"last mode $(sv e3a.1 last_mode) frames $(sv e3a.1 last_frames) aborted $(sv e3a.1 last_aborted)"
	# late/vbl_skips in A are not gating (the dense sampler shares the one CPU)
	NOGATE="e3a.late e3a.vbl_skips e3a.max_gap"
	crit_frames e3a $E3A_N
	NOGATE=""
	case "$PG" in
	active-high*) chk e3.pg_polarity 1 "steady-on PG 1, settled-off 0 = the drivers' convention (patch 0022: PG 1 good)" ;;
	raw-low-when-on*) chk e3.pg_polarity 0 "steady-on PG 0: the opposite of the drivers (fp9929a waits for PG 1); E5 refused" ;;
	*) chk e3.pg_polarity 0 "PG not decided from the samples ($PG): E5 refused" ;;
	esac
	if [ "${E3MODE%% *}" != full ]; then
		# default (--e3): measurement only. Unconditional latched stop after
		# session A, whatever its result; session B and E5 need "e3 full"
		"$SELF" _safe 1 "E3A measurement-only stop"
		touch "$D/fail.e3"
		echo "RESULT e3 STOP-A (measurement only; session A: $FAILS criteria failed; PG $(cut -d' ' -f1 "$D/pg_verdict"))"
		return
	fi
	if [ $FAILS != 0 ] || [ -e "$D/ABORTED" ]; then finish e3 "stopped after session A"; return; fi
	# Session B: timing, VCOM/TMST readback, MX vote, vsync, with a sparse sampler
	SNICE=$NICE_LOW
	session e3b $E3B_N white 100 $(( E3B_N / 85 + 10 )) 1 "" 0 $(( E3B_N * 1000 / 85 + HV_SETUP_MS ))
	SNICE=
	crit_hv e3b $(( E3B_N * 1000 / 85 + 2000 ))
	zero_line e3b $E3B_N
	crit_frames e3b $E3B_N
	for k in 1 2; do
		v=$(mid e3b $k vcom); tm=$(mid e3b $k tmst); mx=$(mid e3b $k mx); p=$(mid e3b $k pins)
		chk e3b.vcom_rb$k $([ "$v" = 0x7e ] && echo 1 || echo 0) "FP9929A reg 0x02 = ${v:-not read} (want 0x7e)"
		chk e3b.tmst$k $(between "$(hexnum "$tm")" 5 45 && echo 1 || echo 0) "FP9929A reg 0x00 = ${tm:-not read} (5-45 C)"
		chk e3b.mx$k $(num "$mx" && [ "$mx" -ge 256 ] && echo 1 || echo 0) "pm_genpd mx performance ${mx:-?} during video (>= 256)"
		set -- $p
		chk e3b.pg_mid$k $([ "$1 $3" = "1 1" ] && [ "$6" = 1 ] && echo 1 || echo 0) "mid-session pins: o36 i36 o86 i86 o82 i82 = ${p:-?} (PG 1 as in session A)"
	done
	set -- $(mid e3b 1 enc) ; a=$1; set -- $(mid e3b 2 enc) ; b=$1
	t1=$(mid e3b 1 t); t2=$(mid e3b 2 t)
	if [ "${a:-x}" != x ] && [ "${b:-x}" != x ]; then
		r=$(awk -v a="$a" -v b="$b" -v x="$t1" -v y="$t2" 'BEGIN { if (y > x) printf "%d", (b - a) / (y - x); else print 0 }')
	else
		a=$(mid e3b 1 irq); b=$(mid e3b 2 irq)
		r=$(awk -v a="${a:-0}" -v b="${b:-0}" -v x="$t1" -v y="$t2" 'BEGIN { if (y > x) printf "%d", (b - a) / (y - x); else print 0 }')
	fi
	chk e3b.vsync_rate $(between "$r" 76 94 && echo 1 || echo 0) "vsync rate $r /s between the mid reads (85 +-10 %)"
	if [ "$E3MODE" = "full stop" ]; then
		# --e3full: zero frames only, latched stop after B on the phone itself,
		# whether or not the host's final command arrives (review 3)
		if [ $FAILS = 0 ] && [ ! -e "$D/ABORTED" ]; then r=PASS; else r=FAIL; fi
		"$SELF" _safe 1 "E3 full (A+B) measurement-only stop"
		touch "$D/fail.e3"
		echo "RESULT e3 STOP-B (zero frames only; sessions A+B $r, $FAILS criteria failed; PG $(cut -d' ' -f1 "$D/pg_verdict"))"
		echo "SAFE $(tail -n1 "$D/safe.log")"
		return
	fi
	finish e3 "PG $(cut -d' ' -f1 "$D/pg_verdict")"
}

# e3t: one more template-only HV session after "e3 full" (patch 0028: the
# zero-test frames ARE the control template, byte 0 = 0: the gates scan, no
# pixel is driven). Session B's opening, limits and criteria, plus read-only
# raw I2C reads of the TC358767, the DSI clock rates and one DPU state print,
# all recorded as info (e3t/regs.txt, e3t/state.txt, criteria.e3t). The user
# watches the glass: the expected result is "unchanged" (not checkable here).
st_e3t() {
	E3TMODE="$*"
	need e3 || return 1
	envload
	[ -e "$D/pass.e3t" ] && { echo "RESULT e3t PASS (already)"; return 0; }
	case "$(cat "$D/pg_verdict")" in active-high*) ;; *) echo "refused: PG verdict $(cat "$D/pg_verdict")"; return 1 ;; esac
	gates_close
	rm -rf "$D/e3t"; mkdir -p "$D/e3t"
	GATES="fp panel enable"
	SNICE=$NICE_LOW
	session e3t $E3T_N black $E5C_SAMPLE_MS $(( E3T_N / 85 + 10 )) 2 "" 0 $(( E3T_N * 1000 / 85 + HV_SETUP_MS ))
	SNICE=
	crit_hv e3t $(( E3T_N * 1000 / 85 + 2000 ))
	zero_line e3t $E3T_N
	# timing gates up to the DPU state read (taken after the I2C reads at
	# ~3 s); after it they are info (the print holds the modeset locks)
	te=e3t.1; [ -s "$D/st.e3t.ps" ] && te=e3t.ps
	crit_frames e3t $E3T_N $te
	for k in 1 2; do
		v=$(mid e3t $k vcom); tm=$(mid e3t $k tmst); mx=$(mid e3t $k mx); p=$(mid e3t $k pins)
		chk e3t.vcom_rb$k $([ "$v" = 0x7e ] && echo 1 || echo 0) "FP9929A reg 0x02 = ${v:-not read} (want 0x7e)"
		chk e3t.tmst$k $(between "$(hexnum "$tm")" 5 45 && echo 1 || echo 0) "FP9929A reg 0x00 = ${tm:-not read} (5-45 C)"
		chk e3t.mx$k $(num "$mx" && [ "$mx" -ge 256 ] && echo 1 || echo 0) "pm_genpd mx performance ${mx:-?} during video (>= 256)"
		set -- $p
		chk e3t.pg_mid$k $([ "$1 $3" = "1 1" ] && [ "$6" = 1 ] && echo 1 || echo 0) "mid-session pins: o36 i36 o86 i86 o82 i82 = ${p:-?} (PG 1)"
	done
	# --- info only: TC358767 raw registers, clocks, DPU state -------------
	nf=0
	for e in $TC_REGS; do
		r=${e%%:*}; n=${e#*:}; w=""; case "$n" in *:*) w=${n#*:}; n=${n%%:*} ;; esac
		a=$(regv e3t 1 $r); b=$(regv e3t 2 $r)
		[ "$a" = x ] && nf=$((nf + 1)); [ "$b" = x ] && nf=$((nf + 1))
		x=""
		[ "$r" = 0x0500 ] && x=" (expect 0x00006601)"
		if [ -n "$w" ]; then
			if [ "$a" = x ] && [ "$b" = x ]; then x=" (init-sequence $w: not read)"
			elif [ "$a" = "$w" ] && [ "$b" = "$w" ]; then x=" (init-sequence $w: match)"
			else x=" (init-sequence $w: MISMATCH)"; fi
		fi
		[ "$r" = 0x0508 ] && x=" (read last: precious, the read may clear it)"
		case $r in 0x0464|0x0908) x="$x (the value has an upload/update bit, likely self-clearing: the driver marks the register volatile; a readback without it is not an error)" ;; esac
		info "e3t.tc_$n" "reg $r: 1 s $a, 3 s $b$x"
	done
	c1=$(regv e3t 1 0x0300); c2=$(regv e3t e 0x0300)
	if [ "$c1" != x ] && [ "$c2" != x ]; then
		info e3t.dsierrcnt_delta "DSIERRCNT $c1 -> $c2 1 s later: delta $(( c2 - c1 )) (may clear on read: datasheet not checked)"
	else
		info e3t.dsierrcnt_delta "DSIERRCNT not read twice ($c1, $c2)"
	fi
	info e3t.tc_reads "$nf failed raw I2C reads of $(( 2 * $(echo $TC_REGS | wc -w) )) (info: a failed read is not an abort)"
	for c in $CLKS; do
		n=${c%%:*}; lo=${c#*:}; hi=${lo#*:}; lo=${lo%%:*}
		for k in 1 2; do
			v=$(clkv e3t $k $n)
			if between "$v" $lo $hi; then x="in $lo-$hi"; else x="OUT OF $lo-$hi"; fi
			info "e3t.$n.$k" "clk_rate $v Hz at mid read $k ($x)"
		done
	done
	i=0; while [ $i -lt 30 ] && [ ! -e "$D/e3t/state.rc" ] && [ -s "$D/st.e3t.ps" ]; do msleep 100; i=$((i + 1)); done
	if [ -s "$D/e3t/state.txt" ]; then
		info e3t.drm_state "$(cat "$D/e3t/state.rc" 2>/dev/null || echo 'rc ?'), $(wc -l < "$D/e3t/state.txt") lines: $(grep -E '^(crtc|plane)\[|active=|fb=|format=|crtc-pos|src-pos' "$D/e3t/state.txt" | tr -s ' \t' ' ' | head -n 12 | tr '\n' ';')"
	else
		info e3t.drm_state "not read ($(cat "$D/e3t/state.rc" 2>/dev/null || echo 'no mid read 2'))"
	fi
	info e3t.glass "NOT machine-checkable: the user watches the glass between the 'HV ON' and 'HV OFF' lines; expected UNCHANGED (template frames clock the gates, drive no pixel)"
	if [ "${E3TMODE%% *}" = stop ]; then
		if [ $FAILS = 0 ] && [ ! -e "$D/ABORTED" ]; then r=PASS; else r=FAIL; fi
		"$SELF" _safe 1 "e3t template session: measurement-only stop"
		touch "$D/fail.e3t"
		echo "RESULT e3t STOP-T (template frames only; e3t $r, $FAILS criteria failed)"
		echo "SAFE $(tail -n1 "$D/safe.log")"
		return
	fi
	finish e3t
}

st_e5a() {
	need e3 || return 1
	envload
	case "$(cat "$D/pg_verdict")" in active-high*) ;; *) echo "refused: PG verdict $(cat "$D/pg_verdict")"; return 1 ;; esac
	gates_close
	GATES=""
	chk e5a.dry $(setp "$PA/zero_test" 0 0 && gates_closed && echo 1 || echo 0) "zero_test 0, enable/panel/fp all N"
	session e5a 0 steps 200 30 0 "" 1 0
	X=$D/e5a; mkdir -p "$X"
	for f in grey levels_before levels dry_levels last; do cat "$DBG/a9_eink/$f" > "$X/$f" 2>/dev/null; done
	cp "$D/st.e5a.1" "$X/status"
	crit_hv_none e5a
	chk e5a.updates $([ "$(dv updates e5a.1 e5a.0)" = 1 ] && echo 1 || echo 0) "updates +$(dv updates e5a.1 e5a.0)"
	chk e5a.no_commit $([ "$(dv frames e5a.1 e5a.0)" = 0 ] && echo 1 || echo 0) "transport frames +$(dv frames e5a.1 e5a.0) (dry: 0)"
	L=$(head -n1 "$X/last"); F=$(sed -n 3p "$X/last")
	chk e5a.last $(echo "$L" | grep -q '^mode 0x203 pre 0x203 clear 1 type 2 ' && sed -n 2p "$X/last" | grep -q 'dry 1 aborted 0' && echo 1 || echo 0) "$L / $(sed -n 2p "$X/last")"
	chk e5a.sha $(echo "$F" | grep -Eq '^frames [0-9]+ sha256 [0-9a-f]{64}$' && echo 1 || echo 0) "$F"
	chk e5a.blobs $([ "$(wc -c < "$X/grey")" = 1357952 ] && [ "$(wc -c < "$X/levels_before")" = 1357952 ] && echo 1 || echo 0) "grey $(wc -c < "$X/grey") levels_before $(wc -c < "$X/levels_before") bytes"
	(cd "$X" && sha256sum grey levels_before last > SHA256SUMS)
	info e5a.prep_us "a9e_prepare $(sv e5a.1 last_prep_us) us (patch 0029: runs before power-up)"
	echo "E5A_LAST $L"
	echo "E5A_FRAMES $F"
	sed 's/^/E5A_SHA /' "$X/SHA256SUMS"
	if [ $FAILS = 0 ] && [ ! -e "$D/ABORTED" ]; then
		touch "$D/dry.e5a"; echo "RESULT e5a DRY-OK (waiting for the host CLI verdict)"
	else finish e5a; fi
}
crit_hv_none() { # no-HV stage: the FP9929A never rose, nothing tripped
	t=$1
	chk "$t.no_fp_on" $([ "$(cnt "$t" 'fp9929a .*: on: ')" = 0 ] && echo 1 || echo 0) "no fp9929a 'on:' line"
	chk "$t.hv_never" $(awk '$2 == 1 || $4 == 1 { x = 1 } END { exit x }' "$D/samples.$t" && echo 1 || echo 0) "GPIO 36/86 low in all $(wc -l < "$D/samples.$t") samples"
	chk "$t.kmsg_clean" $(tripped "$t" && echo 0 || echo 1) "$(tripped "$t" && head -c 200 "$D/trip.$t" || echo 'no unexpected warning/error line')"
	chk "$t.hv_on" $([ "$(sv $t.1 hv_on)" = 0 ] && echo 1 || echo 0) "status hv_on $(sv $t.1 hv_on)"
}

st_verdict() { # verdict e5a <frames> <sha256>
	need "" || return 1
	[ "$1" = e5a ] && [ -e "$D/dry.e5a" ] || { echo "refused: no e5a dry result"; return 1; }
	F=$(sed -n 3p "$D/e5a/last")
	if [ "$F" = "frames $2 sha256 $3" ]; then
		touch "$D/pass.e5a"; log "e5a: host CLI agrees ($F)"; echo "RESULT verdict PASS"
	else
		"$SELF" _safe 1 "e5a: host CLI 'frames $2 sha256 $3' != phone '$F'"
		touch "$D/fail.e5a"; echo "RESULT verdict FAIL (host frames $2 sha256 $3, phone $F)"
	fi
}

st_e5b() {
	need e5a || return 1
	envload
	gates_close
	setp "$PA/zero_test" 0 0
	GATES="panel enable"
	# expected here and only here: the PMIC refuses, the panel and a9_eink report
	# it; the failed prepare drops the I2C mux (GPIO 2), so the bridge's 25 init
	# writes NACK (-6) and it reports one "main link stream start error: -6"
	# (boot 11, MEASURED). No power is involved and nothing retries.
	A='fp9929a .*power-up refused|panel-hisense-hlte556n-eink .*FP9929A power-up failed|a9-eink .*FP9929A is not on after enable|a9-eink .*update dropped: pipeline not available|tc358767 .*init seq #|panel-hisense-hlte556n-eink .*Skipping unprepare of already unprepared panel|tc358767 0-000f: main link stream start error: -6$'
	session e5b 0 "checker 64" 50 15 0 "$A" 1 0
	crit_hv_none e5b
	chk e5b.refused $([ "$(cnt e5b 'FP9929A is not on after enable: no frames sent')" -ge 1 ] && echo 1 || echo 0) "'FP9929A is not on after enable: no frames sent'"
	chk e5b.pmic_refused $([ "$(cnt e5b 'fp9929a .*power-up refused')" -ge 1 ] && echo 1 || echo 0) "fp9929a refused the power-up (gate closed)"
	chk e5b.aborts $([ "$(dv aborts e5b.1 e5b.0)" -ge 1 ] && echo 1 || echo 0) "aborts +$(dv aborts e5b.1 e5b.0)"
	chk e5b.no_frames $([ "$(dv frames e5b.1 e5b.0)" = 0 ] && [ "$(dv updates e5b.1 e5b.0)" = 0 ] && echo 1 || echo 0) "frames +$(dv frames e5b.1 e5b.0) updates +$(dv updates e5b.1 e5b.0)"
	chk e5b.commit_fail $([ "$(dv commit_fail e5b.1 e5b.0)" = 0 ] && echo 1 || echo 0) "commit_fail +$(dv commit_fail e5b.1 e5b.0) (modeset and power-down without HV)"
	info e5b.bridge "$(grep -m1 'before init sequence' "$D/win.e5b" || echo 'no ID line') (TC_IDREG is regmap-cached: not proof the bridge answered); mux low after the refused prepare"
	# the bridge path ran once and did not retry: at most one pass of the 25-entry
	# table and at most one stream error, no stream-stop error, pipeline down
	ie=$(cnt e5b 'tc358767 .*init seq #'); se=$(cnt e5b 'tc358767 .*main link stream start error')
	chk e5b.bridge_one_pass $([ "$ie" -le 25 ] && echo 1 || echo 0) "bridge init-seq write failures $ie (<= 25: one pass, no retry)"
	chk e5b.stream_err_once $([ "$se" -le 1 ] && echo 1 || echo 0) "'main link stream start error' $se time(s) (<= 1)"
	chk e5b.no_stop_err $([ "$(cnt e5b 'main link stream stop error')" = 0 ] && echo 1 || echo 0) "no 'main link stream stop error'"
	chk e5b.no_force $([ "$(cnt e5b 'forcing the FP9929A down')" = 0 ] && echo 1 || echo 0) "no forced FP9929A power-down (the pipeline went down normally)"
	finish e5b
}

st_e5c() {
	need e5b || return 1
	envload
	for s in pre e3 e5a e5b; do [ -e "$D/pass.$s" ] || { echo "refused: $s not passed"; return 1; }; done
	case "$(cat "$D/pg_verdict")" in active-high*) ;; *) echo "refused: PG verdict $(cat "$D/pg_verdict")"; return 1 ;; esac
	b=$(batt_uv); e=$(epd_mc)
	between "$b" 3800000 4500000 || { echo "refused: battery $b uV"; return 1; }
	between "$e" 5000 45000 || { echo "refused: epd_top_therm $e mC"; return 1; }
	gates_close
	setp "$PA/zero_test" 0 0 && [ "$(rd $PA/hv_hold_ms)" = 0 ] && [ "$(rd $PA/hv_max_ms)" = $HV_MAX_MS ] && isY $PA/init_flash && isN $PA/trace ||
		{ echo "refused: parameters changed"; return 1; }
	# bin admission (review 7): only the bin E5a measured, +-1, and only if
	# every admitted bin's init + Clear frames fit the fixed kernel cap; the
	# DRIVER enforces it at update time (patch 0026: bin_min/bin_max, checked
	# before power-up and again with the fresh TMST before any frame)
	b5=$(sed -n 's/.* bin \([0-9]*\) .*/\1/p' "$D/e5a/last" | head -n1)
	num "$b5" || { echo "refused: no E5a bin"; return 1; }
	lo=$(( b5 > 0 ? b5 - 1 : 0 )); hi=$(( b5 < 13 ? b5 + 1 : 13 )); worst=0
	for k in $(seq $lo $hi); do c=$(( $(nth $k "$BIN_INIT") + $(nth $k "$BIN_CLEAR") )); [ $c -gt $worst ] && worst=$c; done
	[ $(( worst * 1000 / 85 + HV_SETUP_MS )) -le $E5C_CAP_MS ] ||
		{ echo "refused: bins $lo-$hi need up to $worst frames, more than the ${E5C_CAP_MS} ms cap allows"; return 1; }
	setp "$PA/bin_min" $lo $lo && setp "$PA/bin_max" $hi $hi ||
		{ echo "refused: a9_eink.bin_min/bin_max not set ($(rd $PA/bin_min)/$(rd $PA/bin_max))"; return 1; }
	echo "E5C_BINS $lo-$hi (E5a bin $b5; worst case $worst frames)"
	GATES="fp panel enable"
	# sparse, lowest-priority sampler (frame pacing: boot 12 had late +4,
	# vbl_skips +6, max_gap 47.8 ms with a 200 ms nice-10 sampler)
	SNICE=$NICE_LOW
	session e5c 0 steps $E5C_SAMPLE_MS 25 0 "" 0 $E5C_CAP_MS
	SNICE=
	setp "$PA/bin_min" 0 0; setp "$PA/bin_max" 13 13
	# sampled HV time vs the kernel cap: <= cap + the 50 ms ordered drop + one
	# sample period (hv_time adds one) + 100 ms scheduling slack
	crit_hv e5c $(( E5C_CAP_MS + 50 + E5C_SAMPLE_MS + 100 ))
	DRIVE=1 crit_frames e5c ""
	cat "$DBG/a9_eink/last" > "$D/last.e5c" 2>/dev/null
	chk e5c.last $(grep -q '^mode 0x203 pre 0x203 clear 1 type 2 ' "$D/last.e5c" && sed -n 2p "$D/last.e5c" | grep -q 'dry 0 aborted 0' && echo 1 || echo 0) "$(head -n1 "$D/last.e5c") / $(sed -n 2p "$D/last.e5c")"
	bc=$(sv e5c.1 last_bin); lf=$(sv e5c.1 last_frames); df=$(dv frames e5c.1 e5c.0)
	chk e5c.bin $(between "$bc" $lo $hi && echo 1 || echo 0) "E5c bin ${bc:-?} (admitted $lo-$hi)"
	if between "$bc" 0 13; then
		chk e5c.update_frames $([ "$lf" = "$(nth $bc "$BIN_CLEAR")" ] && echo 1 || echo 0) "Clear request frames $lf (bin $bc: $(nth $bc "$BIN_CLEAR"))"
		chk e5c.init_frames $([ $(( df - ${lf:-0} )) = "$(nth $bc "$BIN_INIT")" ] && echo 1 || echo 0) "init flash frames $(( df - ${lf:-0} )) (bin $bc: $(nth $bc "$BIN_INIT"))"
	fi
	info e5c.prep_us "a9e_prepare $(sv e5c.1 last_prep_us) us (before power-up)"
	chk e5c.no_stall $([ "$(cnt e5c 'no frame progress')" = 0 ] && echo 1 || echo 0) "no frame-progress interlock trip (patch 0026)"
	info e5c.glass "NOT machine-checkable: expect the bootloader picture gone, 16 grey bands black (top) to white (bottom)"
	finish e5c
}

st_status() {
	echo "dir $D"; ls "$D" | grep -E '^(pass|fail|dry)\.' | tr '\n' ' '; echo
	[ -e "$D/ABORTED" ] && echo "ABORTED: $(cat "$D/ABORTED")"
	echo "pg_verdict $(cat "$D/pg_verdict" 2>/dev/null)"
	echo "hv_total_ms $(cat "$D/hv_total_ms" 2>/dev/null || echo 0)"
	echo "gates: enable $(rd $PA/enable) panel $(rd $PP/enable) fp $(rd $PF/allow_power_on); pins 36 $(pin 36) 86 $(pin 86) 82 $(pin 82)"
}

# ---- dispatch -----------------------------------------------------------------------
case "${1:-status}" in
_sampler)
	sampler_loop "$2" "$3" ;;
_safe)
	shift; l=$1; shift; safe_off "$l" "$@" ;;
_trip)
	safe_off 1 "kmsg in $2: $(head -c 300 "$D/trip.$2")" ;;
_run)
	shift; STAGE=$1; shift
	trap '' HUP PIPE
	trap 'rm -rf "$D/run.lock"; touch "$D/end.$STAGE"' EXIT
	: > "$D/criteria.$STAGE"
	case $STAGE in
	pre) st_pre "$@" ;; e3) st_e3 "$@" ;; e3t) st_e3t "$@" ;; e5a) st_e5a ;; e5b) st_e5b ;; e5c) st_e5c ;;
	verdict) st_verdict "$@" ;;
	esac
	;;
pre|e3|e3t|e5a|e5b|e5c|verdict)
	st=$1
	case $st in pre) w=90;; e3) w=150;; e3t) w=90;; e5a) w=90;; e5b) w=60;; e5c) w=90;; *) w=20;; esac
	w=$(( w * SLOW ))
	mkdir "$D/run.lock" 2>/dev/null || { echo "busy: another stage is running"; exit 1; }
	rm -f "$D/end.$st"
	setsid "$SELF" _run "$@" </dev/null > "$D/out.$st" 2>&1 &
	i=0; while [ $i -lt $w ] && [ ! -e "$D/end.$st" ]; do sleep 1; i=$((i + 1)); done
	cat "$D/out.$st"
	[ -e "$D/end.$st" ] || echo "RESULT $st TIMEOUT (stage still running on the phone; see 'eink-seq status')"
	;;
safe)
	shift
	if [ -n "$*" ]; then safe_off 1 "$*"; else safe_off 0 "safe"; fi
	st_status ;;
status) st_status ;;
fetch) tar -czf - -C "$D" . 2>/dev/null ;;
*) sed -n '2,33p' "$0" ;;
esac
