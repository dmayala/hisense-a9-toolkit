Subject: [PROPOSAL] mainline: qualify PMI632 battery OV health like stock

Apply to the A9 project, not Linux. Current base already integrates
0007-0009, built-in observe/FV config and the enabled board node.
Only adds Linux patch 0014; does not edit applied 0009, build or config.
No raw capture or device identifier is included. This is unapplied.

diff --git a/scripts/mainline/kernel/patches/0014-power-supply-pmi632-stock-health.patch b/scripts/mainline/kernel/patches/0014-power-supply-pmi632-stock-health.patch
new file mode 100644
--- /dev/null
+++ b/scripts/mainline/kernel/patches/0014-power-supply-pmi632-stock-health.patch
@@ -0,0 +1,65 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: PMI632 proposal <pmic@example.invalid>
+Date: Thu, 15 Oct 2026 00:00:00 +0000
+Subject: [PATCH] power: supply: qualify A9 OV health like stock
+
+Apply after integrated 0009. Match the stock battery-health FV +
+40mV qualification. Constant QG codes in observe cannot establish
+stale hardware. Leave the probe-only FV write budget unchanged.
+
+diff --git a/drivers/power/supply/pmi632-a9.c b/drivers/power/supply/pmi632-a9.c
+--- a/drivers/power/supply/pmi632-a9.c
++++ b/drivers/power/supply/pmi632-a9.c
+@@ -243,7 +243,11 @@
+ 		p->last_change = jiffies;
+ 		p->have_raw = true;
+ 	}
+-	if (time_after(jiffies, p->last_change + 30 * HZ))
++	/* Constant quantized data is valid at rest/termination. In observe it
++	 * cannot prove stale hardware, so retain this fail-closed guard only for
++	 * the experimental control path. Getters still reject failed/old samples.
++	 */
++	if (!a9_is_observe() && time_after(jiffies, p->last_change + 30 * HZ))
+ 		return -ESTALE;
+ 	s->uv = div_u64((u64)get_unaligned_le16(raw) * 194637, 1000);
+ 	/* QG is negative on charge. power_supply battery current is positive in. */
+@@ -279,7 +283,7 @@
+ 	if (p->error || p->fv_error || p->latched ||
+ 	    time_after(jiffies, p->sampled_at + 5 * HZ))
+ 		return POWER_SUPPLY_HEALTH_UNSPEC_FAILURE;
+-	if (s->status2 & BIT(1))
++	if (a9_battery_overvoltage(s))
+ 		return POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+ 	if (a9_is_observe() && !a9_observed_limits_ok(s))
+ 		return POWER_SUPPLY_HEALTH_UNSPEC_FAILURE;
+diff --git a/drivers/power/supply/pmi632-policy.h b/drivers/power/supply/pmi632-policy.h
+--- a/drivers/power/supply/pmi632-policy.h
++++ b/drivers/power/supply/pmi632-policy.h
+@@ -8,6 +8,8 @@
+ #define A9_ICL_UA 500000
+ #define A9_COLD_DC 100
+ #define A9_HOT_DC 400
++#define A9_PROFILE_FV_UV 4450000
++#define A9_OV_MARGIN_UV 40000
+ 
+ /*
+  * MEASURED: adcmap_batt_therm_30k_NCP_XH103 in the phone's own Image,
+@@ -52,6 +54,18 @@
+ 	unsigned int enabled, suspend, powerpath, fv_raw, fcc_raw, icl_raw;
+ 	int temp_valid;
+ };
++
++static inline int a9_battery_overvoltage(const struct a9_sample *s)
++{
++	int fv_uv = 3600000 + (int)s->fv_raw * 10000;
++
++	/* Stock smblib_get_prop_batt_health qualifies BAT_OV with FV + 40 mV.
++	 * Never raise this threshold above the A9 stock profile for bad firmware FV.
++	 */
++	if (fv_uv > A9_PROFILE_FV_UV)
++		fv_uv = A9_PROFILE_FV_UV;
++	return (s->status2 & 0x02) && s->uv >= fv_uv + A9_OV_MARGIN_UV;
++}
+ 
+ static inline int a9_observed_limits_ok(const struct a9_sample *s)
+ {
