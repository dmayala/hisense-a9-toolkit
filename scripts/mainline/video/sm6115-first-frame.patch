-	u32 msg_ret;
+	u32 msg_ret, status, wd_mask;
 
 	if (!hdev)
 		return IRQ_NONE;
 
+	/* IRQF_ONESHOT serializes this snapshot with the top half. */
+	status = hdev->irq_status;
+	hdev->irq_status = 0;
+	if (IS_IRIS2(core) || IS_IRIS2_1(core))
+		wd_mask = WRAPPER_INTR_STATUS_A2HWD_MASK_V6;
+	else if (IS_AR50_LITE(core))
+		wd_mask = WRAPPER_INTR_STATUS_A2HWD_MASK_V4_LITE;
+	else
+		wd_mask = WRAPPER_INTR_STATUS_A2HWD_MASK;
+	if (status & wd_mask) {
+		/* Preserve the observation before taking locks or attempting SSR. */
+		dev_err(core->dev, "A9_VENUS_RECOVERY event=1 stage=0 rc=0 irq=%#x\n",
+			status);
+		venus_set_state(hdev, VENUS_STATE_DEINIT);
+		venus_sfr_print(hdev);
+		hfi_process_watchdog_timeout(core);
+		return IRQ_HANDLED;
+	}
+
 	res = hdev->core->res;
 	pkt = hdev->pkt_buf;
-
 
