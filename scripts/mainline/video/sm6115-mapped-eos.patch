+/* inst->lock serializes drains; retain the mapping through session teardown. */
+static int a9_venc_prepare_eos(struct venus_inst *inst, struct hfi_frame_data *fdata)
+{
+	struct a9_venc_inst *priv = container_of(inst, struct a9_venc_inst, inst);
+	struct venus_core *core = inst->core;
+
+	if (!priv->mapped_eos || !IS_V4(core) || !IS_AR50_LITE(core) ||
+	    !of_device_is_compatible(core->dev->of_node, "qcom,sm6115-venus") ||
+	    core->venus_ver.major != 6 || core->venus_ver.minor != 0 ||
+	    core->venus_ver.rev != 39)
+		return 0;
+
+	if (!priv->eos_cpu) {
+		priv->eos_cpu = dma_alloc_coherent(core->dev, SZ_4K,
+						 &priv->eos_dma, GFP_KERNEL);
+		if (!priv->eos_cpu)
+			return -ENOMEM;
+		if (!priv->eos_dma || upper_32_bits(priv->eos_dma)) {
+			dma_free_coherent(core->dev, SZ_4K, priv->eos_cpu, priv->eos_dma);
+			priv->eos_cpu = NULL;
+			return -EOVERFLOW;
+		}
+		memset(priv->eos_cpu, 0, SZ_4K);
+	}
+
+	fdata->device_addr = priv->eos_dma;
+	fdata->alloc_len = SZ_4K;
+	/* Opaque HFI tag: a dummy EBD must never dequeue real vb2 input 0. */
+	fdata->clnt_data = U32_MAX;
+	return 0;
+}
