+/* These experiments change only the selected stock firmware's AVC/HEVC path. */
+static bool a9_venc_variants_supported(struct venus_inst *inst)
+{
+	struct venus_core *core = inst->core;
+
+	return IS_V4(core) && IS_AR50_LITE(core) &&
+		of_device_is_compatible(core->dev->of_node, "qcom,sm6115-venus") &&
+		core->venus_ver.major == 6 && core->venus_ver.minor == 0 &&
+		core->venus_ver.rev == 39 &&
+		(inst->hfi_codec == HFI_VIDEO_CODEC_H264 ||
+		 inst->hfi_codec == HFI_VIDEO_CODEC_HEVC);
+}
+
+/* Baseline stays at the start of properties. Stock decides mode after RC and
+ * the other properties, before requirements/internal buffers and LOAD/START.
+ */
+static int a9_venc_set_work_mode(struct venus_inst *inst, bool after_properties)
+{
+	struct a9_venc_inst *priv = container_of(inst, struct a9_venc_inst, inst);
+	struct venc_controls *ctr = &inst->controls.enc;
+	struct hfi_video_work_mode wm;
+	struct hfi_enable en = { .enable = 1 };
+	bool stock = priv->stock_work_mode && a9_venc_variants_supported(inst);
+	const char *op;
+	int ret;
+
+	if (stock != after_properties)
+		return 0;
+	if (!stock)
+		return venus_helper_set_work_mode(inst);
+
+	if (!ctr->rc_enable) {
+		wm.video_work_mode = VIDC_WORK_MODE_1;
+		op = "a9_stock_work_mode_off";
+	} else if (ctr->bitrate_mode == V4L2_MPEG_VIDEO_BITRATE_MODE_CBR) {
+		wm.video_work_mode = VIDC_WORK_MODE_1;
+		op = "a9_stock_work_mode_cbr";
+	} else {
+		wm.video_work_mode = VIDC_WORK_MODE_2;
+		op = "a9_stock_work_mode_2";
+	}
+	a9_enc_trace(inst, op, "begin", 0);
+	ret = hfi_session_set_property(inst, HFI_PROPERTY_PARAM_WORK_MODE, &wm);
+	if (!ret && wm.video_work_mode == VIDC_WORK_MODE_1)
+		ret = hfi_session_set_property(inst,
+			HFI_PROPERTY_PARAM_VENC_LOW_LATENCY_MODE, &en);
+	a9_enc_trace(inst, op, "end", ret);
+	return ret;
+}
+
+static int a9_venc_set_output_size(struct venus_inst *inst)
+{
+	struct a9_venc_inst *priv = container_of(inst, struct a9_venc_inst, inst);
+	int ret;
+
+	if (!priv->output_size || !a9_venc_variants_supported(inst))
+		return 0;
+	a9_enc_trace(inst, "a9_output_size", "begin", 0);
+	ret = venus_helper_set_bufsize(inst, inst->output_buf_size, HFI_BUFFER_OUTPUT);
+	a9_enc_trace(inst, "a9_output_size", "end", ret);
+	return ret;
+}
