+    const auto& capture = adjustedFormat->fmt.pix_mp;
+    const ui::Size pictureSize(capture.width, capture.height);
+    mVisibleRect = getVisibleRect(pictureSize);
+    mCodedSize = pictureSize;
+    // Venus NV12 uses one memory plane with a 128-byte luma/chroma stride.
+    // Gralloc takes pixel dimensions, not V4L2 bytesperline: requesting only
+    // picture width (e.g. 320) gives a smaller/differently laid-out BO than the
+    // driver needs (stride 384). Keep the driver scanline count so the UV plane
+    // starts at bytesperline * height, and keep picture/crop dimensions separate.
+    if (capture.pixelformat == V4L2_PIX_FMT_NV12 && capture.num_planes == 1) {
+        mCodedSize.width = std::max(capture.width, capture.plane_fmt[0].bytesperline);
+    }
+    ALOGI("CAPTURE picture %s, allocation %s, stride %u, sizeimage %u, planes %u",
+          toString(pictureSize).c_str(), toString(mCodedSize).c_str(),
+          capture.plane_fmt[0].bytesperline, capture.plane_fmt[0].sizeimage,
+          capture.num_planes);
 
