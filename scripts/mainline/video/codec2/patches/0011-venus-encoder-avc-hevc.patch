@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstddef>
+#include <cstring>
+namespace android {
+// Validate the driver's range before pointer arithmetic or either memory access.
+inline bool copyEncoderOutput(void* dst, size_t dstSize, const void* src,
+                              size_t srcSize, size_t offset, size_t used) {
+    if (offset > used || used > srcSize || used - offset > dstSize) return false;
+    if (used == offset) return true;
+    if (!src || !dst) return false;
+    std::memcpy(dst, static_cast<const unsigned char*>(src) + offset, used - offset);
+    return true;
+}
+}  // namespace android
