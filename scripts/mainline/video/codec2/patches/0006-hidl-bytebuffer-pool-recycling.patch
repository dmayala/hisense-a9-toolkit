@@ -198,7 +200,25 @@ std::unique_ptr<VideoFramePool> DecodeComponent::getVideoFramePool(const ui::Siz
     auto poolId = mIntfImpl->getBlockPoolId();
     ALOGI("Using C2BlockPool ID = %" PRIu64 " for allocating output buffers", poolId);
     std::shared_ptr<C2BlockPool> blockPool;
-    auto status = GetCodec2BlockPool(poolId, std::move(sharedThis), &blockPool);
+    c2_status_t status = C2_NOT_FOUND;
+    // Venus: ByteBuffer mode (BASIC_GRAPHIC): recycled, HIDL bufferpool-backed gralloc buffers.
+    if (poolId == C2BlockPool::BASIC_GRAPHIC && !mIsSecure &&
+        property_get_bool("vendor.a9.c2dec.bytebuffer_pool", true)) {
+        static std::atomic<C2BlockPool::local_id_t> sNextLocalId{C2BlockPool::PLATFORM_START + 0xA9100};
+        std::shared_ptr<C2Allocator> allocator;
+        status = GetCodec2PlatformAllocatorStore()->fetchAllocator(C2PlatformAllocatorStore::GRALLOC,
+                                                                   &allocator);
+        if (status == C2_OK && allocator) {
+            blockPool = std::make_shared<C2PooledBlockPool>(allocator, sNextLocalId++,
+                                                            C2PooledBlockPool::VER_HIDL);
+            ALOGI("ByteBuffer output: HIDL bufferpool gralloc pool %" PRIu64 " instead of the basic pool",
+                  blockPool->getLocalId());
+        } else {
+            ALOGW("No gralloc allocator (%d), keeping the basic graphic pool", status);
+            status = C2_NOT_FOUND;
+        }
+    }
+    if (!blockPool) status = GetCodec2BlockPool(poolId, std::move(sharedThis), &blockPool);
     if (status != C2_OK) {
         ALOGE("Graphic block allocator is invalid: %d", status);
         reportError(status);
