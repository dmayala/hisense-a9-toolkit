+// Venus: copy one bitstream buffer (plus pending parameter sets) into a free MMAP buffer.
+// Returns false when decoding must pause (no free buffer: the request is put back) or failed (onError called).
+bool V4L2Decoder::queueInputMmap(DecodeRequest request) {
+    const int32_t bitstreamId = request.buffer->id;
+    C2ReadView view = request.buffer->dmabuf.map().get();
+    if (view.error() != C2_OK) {
+        ALOGE("Failed to map input buffer, bitstreamId=%d", bitstreamId);
+        std::move(request.decodeCb).Run(VideoDecoder::DecodeStatus::kError);
+        onError();
+        return false;
+    }
+    const uint8_t* data = view.data();
+    const size_t size = request.buffer->size;
+    if (size > view.capacity() || size > kInputBufferSizeMmap ||
+        mPendingParamSets.size() > kInputBufferSizeMmap - size) {
+        ALOGE("Bitstream and pending parameter sets exceed input capacity");
+        std::move(request.decodeCb).Run(VideoDecoder::DecodeStatus::kError);
+        onError();
+        return false;
+    }
+
+    if (mMergeCsd && isParameterSetsOnly(data, size, mCodec)) {
+        ALOGV("bitstreamId=%d: %zu bytes of parameter sets, merged into the next frame", bitstreamId,
+              size);
+        mPendingParamSets.insert(mPendingParamSets.end(), data, data + size);
+        mTaskRunner->PostTask(FROM_HERE, ::base::BindOnce(std::move(request.decodeCb),
+                                                          VideoDecoder::DecodeStatus::kOk));
+        return true;
+    }
+
+    std::optional<V4L2WritableBufferRef> inputBuffer = mInputQueue->getFreeBuffer();
+    if (!inputBuffer) {
+        ALOGV("There is no free input buffer.");
+        std::queue<DecodeRequest> rest;
+        rest.push(std::move(request));
+        while (!mDecodeRequests.empty()) {
+            rest.push(std::move(mDecodeRequests.front()));
+            mDecodeRequests.pop();
+        }
+        std::swap(mDecodeRequests, rest);
+        return false;
+    }
+    const size_t total = mPendingParamSets.size() + size;
+    const size_t planeSize = inputBuffer->getPlaneSize(0);
+    uint8_t* dst = static_cast<uint8_t*>(inputBuffer->getPlaneMapping(0));
+    if (!dst || total > planeSize) {
+        ALOGE("Input of %zu bytes does not fit the %zu-byte MMAP buffer (mapping %p)", total, planeSize,
+              dst);
+        std::move(request.decodeCb).Run(VideoDecoder::DecodeStatus::kError);
+        onError();
+        return false;
+    }
+    if (!mPendingParamSets.empty()) {
+        memcpy(dst, mPendingParamSets.data(), mPendingParamSets.size());
+        ALOGV("bitstreamId=%d: %zu bytes of parameter sets prepended", bitstreamId,
+              mPendingParamSets.size());
+    }
+    memcpy(dst + mPendingParamSets.size(), data, size);
+    mPendingParamSets.clear();
+
+    ALOGV("QBUF (MMAP) to input queue, bitstreamId=%d, %zu bytes", bitstreamId, total);
+    inputBuffer->setTimeStamp({.tv_sec = bitstreamId});
+    inputBuffer->setPlaneDataOffset(0, 0);
+    inputBuffer->setPlaneBytesUsed(0, total);
+    if (!std::move(*inputBuffer).queueMMap()) {
+        ALOGE("%s(): Failed to QBUF to input queue, bitstreamId=%d", __func__, bitstreamId);
+        std::move(request.decodeCb).Run(VideoDecoder::DecodeStatus::kError);
+        onError();
+        return false;
+    }
+    mPendingDecodeCbs.insert(std::make_pair(bitstreamId, std::move(request.decodeCb)));
+    return true;
+}
