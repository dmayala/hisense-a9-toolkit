+// Venus: true if the buffer holds NAL units but no slice (only SPS/PPS/VPS/SEI/AUD...).
+bool isParameterSetsOnly(const uint8_t* data, size_t size, VideoCodec codec) {
+    size_t nals = 0;
+    if (codec == VideoCodec::H264) {
+        H264NalParser parser(data, size);
+        while (parser.locateNextNal()) {
+            if (parser.length() == 0) continue;
+            nals++;
+            const uint8_t t = parser.type();
+            if (t >= 1 && t <= 5) return false;
+        }
+    } else if (codec == VideoCodec::HEVC) {
+        HEVCNalParser parser(data, size);
+        while (parser.locateNextNal()) {
+            if (parser.length() == 0) continue;
+            nals++;
+            if (parser.type() <= 31) return false;
+        }
+    } else {
+        return false;
+    }
+    return nals > 0;
+}
