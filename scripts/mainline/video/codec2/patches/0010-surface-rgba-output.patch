 void DecodeComponent::onOutputFrameReady(std::unique_ptr<VideoFrame> frame) {
+    if (mComponentState.load() == ComponentState::ERROR) return;
+    if (!mSurfaceOutput) {
+        reportOutputFrame(std::move(frame), nullptr);
+        return;
+    }
+    if (!mSurfaceOutputPool) {
+        ALOGE("Surface pool unavailable; refusing YUV output");
+        reportError(C2_BAD_STATE);
+        return;
+    }
+    mSurfaceFrames.push(std::move(frame));
+    if (mSurfaceFrames.size() == 1) pumpSurfaceFrames(mSurfaceGeneration);
+}
+
+void DecodeComponent::pumpSurfaceFrames(uint64_t generation) {
+    // A delayed fetch retry must not publish a frame from before flush/stop.
+    if (generation != mSurfaceGeneration || !mSurfaceOutputPool ||
+        mComponentState.load() == ComponentState::ERROR) return;
+    while (!mSurfaceFrames.empty()) {
+        auto& frame = mSurfaceFrames.front();
+        const auto& rect = frame->getVisibleRect();
+        if (mWorksAtDecoder.find(frame->getBitstreamId()) == mWorksAtDecoder.end() ||
+            rect.left != 0 || rect.top != 0 || rect.isEmpty()) {
+            ALOGE("Invalid/stale A9 Surface frame; refusing output");
+            mSurfaceFrames = {};
+            reportError(C2_BAD_VALUE);
+            return;
+        }
+        std::shared_ptr<C2GraphicBlock> rgba;
+        // CPU writes + GL samples. VIDEO_DECODER is deliberately absent: this
+        // is the converted display buffer, never a Venus CAPTURE allocation.
+        const C2MemoryUsage usage(C2MemoryUsage::CPU_READ | C2MemoryUsage::CPU_WRITE |
+                static_cast<uint64_t>(BufferUsage::GPU_TEXTURE));
+        c2_status_t err = mSurfaceOutputPool->fetchGraphicBlock(
+                rect.width(), rect.height(), HAL_PIXEL_FORMAT_RGBA_8888, usage, &rgba);
+        if ((err == C2_BLOCKING || err == C2_TIMED_OUT) && ++mSurfaceRetries <= 125) {
+            mDecoderTaskRunner->PostDelayedTask(FROM_HERE,
+                    ::base::BindOnce(&DecodeComponent::pumpSurfaceFrames, mWeakThis, generation),
+                    ::base::TimeDelta::FromMilliseconds(16));
+            return;
+        }
+        mSurfaceRetries = 0;
+        if (err != C2_OK || !rgba || !surfaceRgbaCopy(frame->getGraphicBlock(), rgba)) {
+            ALOGE("A9 Surface RGBA allocation/conversion failed (%d); no buffer submitted", err);
+            mSurfaceFrames = {};
+            reportError(err == C2_OK ? C2_CORRUPTED : err);
+            return;
+        }
+        auto ready = std::move(frame);
+        mSurfaceFrames.pop();
+        reportOutputFrame(std::move(ready), std::move(rgba));
+    }
+    // The V4L2 drain callback can precede a delayed Surface dequeue retry.
+    // Do not report EOS/abandon works until every converted frame is reported.
+    if (mSurfaceDrainPending) {
+        mSurfaceDrainPending = false;
+        onDrainDone(VideoDecoder::DecodeStatus::kOk);
+    }
+}
