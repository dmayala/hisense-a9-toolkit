+// SPDX-License-Identifier: BSD-3-Clause
+// A9 POC: explicit NV12/YUV420 -> RGBA copy, never reinterpret YUV as RGB.
+#ifndef V4L2_CODEC2_SURFACE_RGBA_H
+#define V4L2_CODEC2_SURFACE_RGBA_H
+#include <C2Buffer.h>
+#include <libyuv/convert_argb.h>
+
+namespace android {
+// Keep layout validation separate so the actual conversion can be checked on
+// synthetic mapped planes without a GPU/Binder/SurfaceFlinger process.
+inline bool surfaceRgbaConvert(const C2PlanarLayout& src, const uint8_t* const* in,
+                               const C2PlanarLayout& dst, uint8_t* const* out,
+                               uint32_t width, uint32_t height) {
+    if (!width || !height || width > 4096 || height > 4096 || !in || !out ||
+        src.type != C2PlanarLayout::TYPE_YUV || src.numPlanes != 3 ||
+        !((dst.type == C2PlanarLayout::TYPE_RGB && dst.numPlanes == 3) ||
+          (dst.type == C2PlanarLayout::TYPE_RGBA && dst.numPlanes == 4))) return false;
+    const C2PlaneInfo::channel_t channels[] = { C2PlaneInfo::CHANNEL_Y,
+            C2PlaneInfo::CHANNEL_CB, C2PlaneInfo::CHANNEL_CR };
+    for (unsigned i = 0; i < 3; ++i) {
+        const auto& p = src.planes[i];
+        const unsigned sampling = i ? 2 : 1;
+        if (!in[i] || p.channel != channels[i] || p.allocatedDepth != 8 ||
+            p.bitDepth != 8 || p.rightShift || p.colSampling != sampling ||
+            p.rowSampling != sampling || p.colInc != (i ? src.planes[1].colInc : 1) ||
+            p.colInc < 1 || p.colInc > 2 ||
+            p.rowInc < int(((width + sampling - 1) / sampling - 1) * p.colInc + 1)) return false;
+    }
+    const C2PlaneInfo::channel_t rgb[] = { C2PlaneInfo::CHANNEL_R, C2PlaneInfo::CHANNEL_G,
+            C2PlaneInfo::CHANNEL_B, C2PlaneInfo::CHANNEL_A };
+    // A16 C2AllocatorGralloc describes RGBA_8888 as TYPE_RGB/3 planes
+    // (its alpha TODO); colInc=4 still reserves the alpha byte we fill to255.
+    for (unsigned i = 0; i < dst.numPlanes; ++i) {
+        const auto& p = dst.planes[i];
+        if (!out[i] || out[i] != out[0] + i || p.channel != rgb[i] ||
+            p.colInc != 4 || p.rowInc != dst.planes[0].rowInc ||
+            p.rowInc < int(width * 4) || p.colSampling != 1 || p.rowSampling != 1 ||
+            p.allocatedDepth != 8 || p.bitDepth != 8 || p.rightShift) return false;
+    }
+    // libyuv ABGR means RGBA bytes on little-endian Android. POC matches the
+    // accepted ByteBuffer probe's limited-range BT.601 conversion.
+    return libyuv::Android420ToABGR(in[0], src.planes[0].rowInc,
+            in[1], src.planes[1].rowInc, in[2], src.planes[2].rowInc,
+            src.planes[1].colInc, out[0], dst.planes[0].rowInc, width, height) == 0;
+}
+
+inline bool surfaceRgbaCopy(const C2ConstGraphicBlock& nv12,
+                            const std::shared_ptr<C2GraphicBlock>& rgba) {
+    // Mapped views are destroyed (and the write map flushed) before publication.
+    const C2GraphicView source = nv12.map().get();
+    C2GraphicView target = rgba->map().get();
+    if (source.error() != C2_OK || target.error() != C2_OK ||
+        source.crop().left || source.crop().top ||
+        target.width() < source.crop().width || target.height() < source.crop().height) return false;
+    return surfaceRgbaConvert(source.layout(), source.data(), target.layout(), target.data(),
+                              source.crop().width, source.crop().height);
+}
+} // namespace android
+#endif
