+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef A9_ENC_DIAG_H
+#define A9_ENC_DIAG_H
+/* Numeric state only: no DMA addresses, media bytes, pointers or identifiers. */
+static inline bool a9_enc_enabled(struct venus_inst *inst)
+{
+	return inst->session_type == VIDC_SESSION_TYPE_ENC && IS_AR50_LITE(inst->core);
+}
+static inline void a9_enc_trace(struct venus_inst *inst, const char *op,
+			       const char *phase, int ret)
+{
+	if (a9_enc_enabled(inst))
+		dev_info(inst->core->dev, "A9_VENUS_ENC op=%s phase=%s rc=%d state=%u codec=%#x\n",
+			 op, phase, ret, inst->state, inst->hfi_codec);
+}
+#endif
