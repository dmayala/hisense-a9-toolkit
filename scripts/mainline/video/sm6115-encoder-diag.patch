 int hfi_session_process_buf(struct venus_inst *inst, struct hfi_frame_data *fd)
 {
 	const struct hfi_ops *ops = inst->core->ops;
-
-	if (test_bit(0, &inst->core->sys_error))
-		return -EIO;
-
-	if (fd->buffer_type == HFI_BUFFER_INPUT)
-		return ops->session_etb(inst, fd);
-	else if (fd->buffer_type == HFI_BUFFER_OUTPUT ||
-		 fd->buffer_type == HFI_BUFFER_OUTPUT2)
-		return ops->session_ftb(inst, fd);
-
-	return -EINVAL;
+	bool input = fd->buffer_type == HFI_BUFFER_INPUT;
+	u32 seen = input ? inst->sequence_out : inst->sequence_cap;
+	bool trace = a9_enc_enabled(inst) && (seen < 2 || (fd->flags & HFI_BUFFERFLAG_EOS));
+	int ret;
+
+
+	if (test_bit(0, &inst->core->sys_error))
+		return -EIO;
+
+
+	if (trace) {
+		dev_info(inst->core->dev, "A9_VENUS_ENC op=buffer.begin type=%#x alloc=%u filled=%u offset=%u flags=%#x tag=%u\n",
+			 fd->buffer_type, fd->alloc_len, fd->filled_len, fd->offset, fd->flags, fd->clnt_data);
+	}
+	if (input)
+		ret = ops->session_etb(inst, fd);
+	else if (fd->buffer_type == HFI_BUFFER_OUTPUT || fd->buffer_type == HFI_BUFFER_OUTPUT2)
+		ret = ops->session_ftb(inst, fd);
+	else
+		ret = -EINVAL;
+	if (trace)
+		a9_enc_trace(inst, __func__, "buffer.end", ret);
+	return ret;
 }
 EXPORT_SYMBOL_GPL(hfi_session_process_buf);
 
