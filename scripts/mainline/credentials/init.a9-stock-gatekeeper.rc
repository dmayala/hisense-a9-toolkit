# The stock constructor waits for vendor.sys.listeners.registered from qseecomd.
# Match stock class ordering; the existing qseecomd/Keymaster path owns TA setup.
service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service-qti
    class early_hal
    user system
    group system
    seclabel u:r:hal_gatekeeper_default:s0
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
