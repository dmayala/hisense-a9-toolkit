; The normal encrypted fpdata store keeps its existing label and permissions.
(type a9_fp_dump_file)
(roletype object_r a9_fp_dump_file)
(typeattributeset file_type (a9_fp_dump_file))
(typeattributeset data_file_type (a9_fp_dump_file))
; Also deny HAL creation before init has precreated/restored the debug root.
(typetransition hal_fingerprint_default vendor_data_file_202504 dir "fsfp_dump" a9_fp_dump_file)
(allow vendor_init_202504 a9_fp_dump_file (dir (create open read write search getattr setattr relabelfrom relabelto add_name)))
(allow vendor_init_202504 a9_fp_dump_file (file (getattr relabelfrom relabelto)))
; Numeric sweep inventory: directory listing and inode metadata, no payload reads.
(allow a9ml_rootsh a9_fp_dump_file (dir (open read search getattr)))
(allow a9ml_rootsh a9_fp_dump_file (file (getattr)))
(allow a9ml_rootsh a9_fp_dump_file (lnk_file (getattr)))
; Assertions document the intended absence of write grants; effective-policy
; host queries enforce this too (the inherited compiler uses -N).
(neverallow hal_fingerprint_default a9_fp_dump_file (dir (create write add_name remove_name rmdir)))
(neverallow hal_fingerprint_default a9_fp_dump_file (file (create write append)))

(type a9_fp_privacy_prop)
(roletype object_r a9_fp_privacy_prop)
(typeattributeset property_type (a9_fp_privacy_prop))
(typeattributeset vendor_property_type (a9_fp_privacy_prop))
(typeattributeset vendor_internal_property_type (a9_fp_privacy_prop))
(allow init_202504 a9_fp_privacy_prop (property_service (set)))
(allow vendor_init_202504 a9_fp_privacy_prop (property_service (set)))
(allow hal_fingerprint_default a9_fp_privacy_prop (file (open read getattr map)))
