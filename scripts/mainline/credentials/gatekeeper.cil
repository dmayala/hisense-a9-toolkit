; Stock QTI gatekeeper uses KeymasterUtils and the existing keymaster64 TA.
; Existing platform policy supplies the gatekeeper HIDL/Binder server rules.
(allow hal_gatekeeper_default tee_device_202504 (chr_file (open read write getattr ioctl map)))
(allowx hal_gatekeeper_default tee_device_202504 (ioctl chr_file ((range 0x9700 0x972c))))
(allow hal_gatekeeper_default ion_device_202504 (chr_file (open read write getattr ioctl map)))
(allowx hal_gatekeeper_default ion_device_202504 (ioctl chr_file ((range 0x4900 0x490a))))
(allow hal_gatekeeper_default a9ml_tee_listener_prop (file (read open getattr map)))
(allow hal_gatekeeper_default tee_data_file_202504 (dir (search getattr)))
(allow hal_gatekeeper_default a9ml_firmware_file (dir (search read open getattr)))
(allow hal_gatekeeper_default a9ml_firmware_file (file (open read getattr map)))
(allow hal_gatekeeper_default vendor_file_202504 (dir (search getattr)))
(allow hal_gatekeeper_default vendor_file_202504 (file (read open getattr map execute)))
