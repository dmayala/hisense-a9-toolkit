# Physical persist is exposed only through the no-journal-replay read-only path.
# Init waits for this bounded worker before starting qseecomd and Keymaster.
service a9ml_persist_ro /system/bin/sh /vendor/bin/a9ml-wrapped-start.sh persist
    class core
    user root
    group root system
    seclabel u:r:a9ml_rootsh:s0
    disabled
    oneshot
    timeout_period 30
