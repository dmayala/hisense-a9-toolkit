; Preserve the factory filesystem's stock inode contexts without relabeling.
; Do not import the stock vendor_persist_type RW/create rule family.
(type vendor_persist_data_file)
(roletype object_r vendor_persist_data_file)
(typeattributeset file_type (vendor_persist_data_file))
; libdrmfs probes parent directories with opendir before opening a file.
(allow tee_202504 vendor_persist_data_file (dir (getattr search open read)))
(allow tee_202504 vendor_persist_data_file (file (getattr open read)))
; Inspect the empty unmounted mountpoint and set/query the block RO flag.
; Android Toybox opens this node O_RDONLY for both ioctls. No block write grant.
(allow a9ml_rootsh mnt_vendor_file_202504 (dir (getattr search open read mounton)))
(allowx a9ml_rootsh block_device_202504 (ioctl blk_file (0x125d 0x125e)))
