# Label the real E Ink DRM subtree, independent of card numbering. genfscon
# paths are prefixes, not globs; this prefix stays within the E Ink device.
genfscon sysfs /devices/platform/eink-display/drm u:object_r:vendor_sysfs_a9_eink:s0
