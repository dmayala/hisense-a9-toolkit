+	ret = connect(sock, (struct sockaddr *)sq, sizeof(*sq));
+	sent = ret < 0 ? -1 : send(sock, pkt, sizeof(pkt), 0);
+	close(sock);
+	if (sent != (ssize_t)sizeof(pkt))
+		a9_fault("error-reply-transport");
+	return 1;
+}
