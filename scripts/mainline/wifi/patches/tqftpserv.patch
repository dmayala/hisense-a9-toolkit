+static int a9_unknown_read(struct sockaddr_qrtr *sq, const char *path)
+{
+	unsigned i;
+	uint8_t pkt[4 + 15];
+	int sock, ret;
+	ssize_t sent;
+	if (!a9_plain_read_path(path))
+		return 0;
+	for (i = 0; i < a9_unknown_count; i++)
+		if (!strcmp(a9_unknown_paths[i], path))
+			break;
+	if (i == a9_unknown_count) {
+		if (a9_unknown_count >= A9_UNKNOWN_READ_MAX) { a9_fault("unknown-read-limit"); return 1; }
+		snprintf(a9_unknown_paths[a9_unknown_count++], sizeof(a9_unknown_paths[0]), "%s", path);
+		fprintf(stderr, "A9_WIFI_TQFTP_NOTE unknown-read path=%s from=%u:%u distinct=%u\n",
+			path, sq->sq_node, sq->sq_port, a9_unknown_count);
+		fflush(stderr);
+	}
+	pkt[0] = 0; pkt[1] = OP_ERROR; pkt[2] = 0; pkt[3] = TFTP_ERROR_ENOENT;
+	memcpy(pkt + 4, "file not found", 15);
+	sock = qrtr_open(0);
