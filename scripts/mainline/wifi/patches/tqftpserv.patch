+/* Both list types expire by monotonic progress and total lifetime, even if
+ * no more datagram ever arrives. The controller treats expiry as a fault. */
+static unsigned a9_expire_list(struct list_head *head, uint64_t now)
+{
+	struct tftp_client *c,*next; unsigned count=0;
+	list_for_each_entry_safe(c,next,head,node) {
+		if (now-c->progress_ms >= c->timeoutms || now-c->started_ms >= A9_SESSION_MS) {
+			client_close_and_free(c); count++;
+		}
+	}
+	return count;
+}
+static int a9_expire(uint64_t now)
+{
+	unsigned count=a9_expire_list(&readers,now)+a9_expire_list(&writers,now);
+	if (count) a9_fault("session-expired");
+	return count;
