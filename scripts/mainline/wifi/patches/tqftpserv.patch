+#define A9_UNKNOWN_READ_MAX 16
+static char a9_unknown_paths[A9_UNKNOWN_READ_MAX][128];
+static unsigned a9_unknown_count;
+static int a9_plain_read_path(const char *path)
+{
+	size_t n = strnlen(path, 128);
+	if (n == 0 || n >= 128 || (strncmp(path, "/readonly/", 10) && strncmp(path, "/readwrite/", 11)))
+		return 0;
