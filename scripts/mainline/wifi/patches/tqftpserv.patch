+#ifdef A9_TQFTP_SANDBOX
+/* A9 capability translation: no pathname lookup in the daemon. */
+#include <sys/stat.h>
+#include <sys/vfs.h>
+#include <linux/magic.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+#include "translate.h"
+
+#define A9_WLAN_FD 20
+#define A9_WLAN_BYTES 3814580
+#define A9_WLAN_PATH "/readonly/firmware/image/wlanmdsp.mbn"
+#define A9_RAM_BYTES (1024 * 1024)
+struct a9_mapping { const char *path; int fd; int writable; };
+static const struct a9_mapping a9_files[] = {
+	{ A9_WLAN_PATH, 20, 0 },
+	{ "/readwrite/mcfg.tmp", 21, 1 },
+	{ "/readwrite/server_check.txt", 22, 1 },
+};
+/* Read-only spellings upstream tqftpserv strips to the same firmware file
+ * (READONLY_VENDOR_MNT_PATH etc.). Each maps ONLY to the already-open
+ * read-only FD 20: no new open, no writable alias, exact bytes. */
+static const char *const a9_wlan_aliases[] = {
+	"/readonly/vendor/firmware_mnt/image/wlanmdsp.mbn",
+	"/readonly/vendor/firmware/wlanmdsp.mbn",
+	"/readonly/firmware/wlanmdsp.mbn",
+};
+static int a9_initialized;
+
+static const struct a9_mapping *a9_lookup(const char *path)
+{
+	for (unsigned i = 0; i < sizeof(a9_files) / sizeof(*a9_files); i++)
+		if (!strcmp(path, a9_files[i].path))
+			return &a9_files[i];
+	for (unsigned i = 0; i < sizeof(a9_wlan_aliases) / sizeof(*a9_wlan_aliases); i++)
+		if (!strcmp(path, a9_wlan_aliases[i]))
+			return &a9_files[0];
+	return NULL;
+}
+
+static int a9_check_file(const struct a9_mapping *m)
+{
+	struct stat st;
+	struct statfs fs;
+	int flags = fcntl(m->fd, F_GETFL);
+	if (flags < 0 || (flags & O_ACCMODE) != (m->writable ? O_RDWR : O_RDONLY) ||
+	    (flags & (O_PATH | O_APPEND)) || fstat(m->fd, &st) ||
+	    !S_ISREG(st.st_mode) || (m->writable ? st.st_nlink > 1 : st.st_nlink != 1) ||
+	    (m->writable && (fstatfs(m->fd, &fs) || fs.f_type != TMPFS_MAGIC)) ||
+	    (m->writable ? st.st_size < 0 || st.st_size > A9_RAM_BYTES :
+		st.st_size != A9_WLAN_BYTES)) {
+		errno = EACCES;
+		return -1;
+	}
+	return 0;
+}
+
+static int a9_check_roles(void)
+{
+	struct stat st[3];
+	for (unsigned i = 0; i < 3; i++) {
+		if (a9_check_file(&a9_files[i]) || fstat(a9_files[i].fd, &st[i]))
+			return -1;
+		for (unsigned j = 0; j < i; j++) {
+			if (st[i].st_dev == st[j].st_dev && st[i].st_ino == st[j].st_ino) {
+				errno = EACCES;
+				return -1;
+			}
+		}
+	}
+	return 0;
+}
+
+int a9_translate_init(void)
+{
+	a9_initialized = 0;
+	if (a9_check_roles())
+		return -1;
+	a9_initialized = 1;
+	return 0;
+}
+
+int sanitize_path(const char *path)
+{
+	/* Exact bytes only: no normalization, alias, root or compression fallback. */
+	if (!path || strnlen(path, 128) == 128)
+		return -1;
+	return a9_lookup(path) ? 0 : -1;
+}
+
+int translate_open(const char *path, int flags)
+{
+	const struct a9_mapping *m;
+	int fd;
+	if (!a9_initialized || sanitize_path(path) || a9_check_roles()) {
+		errno = EACCES;
+		return -1;
+	}
+	m = a9_lookup(path);
+	if (!m || (flags != O_RDONLY &&
+	    !(m->writable && flags == (O_WRONLY | O_CREAT))) || a9_check_file(m)) {
+		errno = EACCES;
+		return -1;
+	}
+	fd = dup(m->fd);
+	if (fd >= 0 && fcntl(fd, F_SETFD, FD_CLOEXEC) < 0) {
+		int saved = errno;
+		close(fd);
+		errno = saved;
+		return -1;
+	}
+	return fd;
+}
+
+ssize_t a9_translate_pwrite(int fd, const void *buf, size_t len, off_t off)
+{
+	struct stat st, admitted;
+	int flags = fcntl(fd, F_GETFL);
+	int match = 0;
+	if (!a9_initialized || a9_check_roles() || off < 0 || off > A9_RAM_BYTES ||
+	    len > A9_RAM_BYTES - (size_t)off || flags < 0 ||
+	    (flags & O_ACCMODE) != O_RDWR || (flags & (O_APPEND | O_PATH)) ||
+	    fstat(fd, &st)) {
+		errno = EACCES;
+		return -1;
+	}
+	for (unsigned i = 1; i < sizeof(a9_files) / sizeof(*a9_files); i++) {
+		if (!a9_check_file(&a9_files[i]) && !fstat(a9_files[i].fd, &admitted) &&
+		    st.st_dev == admitted.st_dev && st.st_ino == admitted.st_ino)
+			match = 1;
+	}
+	if (!match) {
+		errno = EACCES;
+		return -1;
+	}
+	size_t done = 0;
+	while (done < len) {
+		ssize_t n = pwrite(fd, (const char *)buf + done, len - done, off + done);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0) {
+			if (!n) errno = EIO;
+			return -1;
+		}
+		done += n;
+	}
+	return done;
+}
