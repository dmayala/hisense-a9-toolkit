+/* FD13 only: launcher verifies the exact rmtfs char-device identity via sysfs. */
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include "rmtfs.h"
+#include "a9-safe.h"
+
+struct rmtfs_mem { int fd; };
+struct rmtfs_mem *rmtfs_mem_open(void)
+{
+	struct stat st;
+	struct rmtfs_mem *m;
+	int flags = fcntl(A9_MEM_FD, F_GETFL);
+	if (fstat(A9_MEM_FD, &st) || !S_ISCHR(st.st_mode) || flags < 0 ||
+	    (flags & O_ACCMODE) != O_RDWR || (flags & O_APPEND)) { errno = EINVAL; return NULL; }
+	m = calloc(1, sizeof(*m));
+	if (m) m->fd = A9_MEM_FD;
+	return m;
+}
+int64_t rmtfs_mem_alloc(struct rmtfs_mem *m, size_t n)
+{
+	if (!m || !n || n > A9_MEM_SIZE) return -EINVAL;
+	return A9_MEM_BASE;
+}
+void rmtfs_mem_free(struct rmtfs_mem *m) { (void)m; }
+static int range(struct rmtfs_mem *m, unsigned long p, ssize_t n)
+{
+	if (!m || n < 0 || p < A9_MEM_BASE || p - A9_MEM_BASE > A9_MEM_SIZE ||
+	    (uint64_t)n > A9_MEM_SIZE - (p - A9_MEM_BASE)) return -EINVAL;
+	return 0;
+}
+ssize_t rmtfs_mem_read(struct rmtfs_mem *m, unsigned long p, void *b, ssize_t n)
+{
+	ssize_t r;
+	if (range(m, p, n)) return -EINVAL;
+	do { r = pread(m->fd, b, n, p - A9_MEM_BASE); } while (r < 0 && errno == EINTR);
+	return r == n ? r : -EIO;
+}
+ssize_t rmtfs_mem_write(struct rmtfs_mem *m, unsigned long p, const void *b, ssize_t n)
+{
+	ssize_t r;
+	if (range(m, p, n)) return -EINVAL;
+	do { r = pwrite(m->fd, b, n, p - A9_MEM_BASE); } while (r < 0 && errno == EINTR);
+	return r == n ? r : -EIO;
+}
+void rmtfs_mem_close(struct rmtfs_mem *m) { if (m) { close(m->fd); free(m); } }
