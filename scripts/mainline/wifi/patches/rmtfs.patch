+        long long ms = 0; struct timespec up;
+        if (!clock_gettime(CLOCK_BOOTTIME, &up)) ms = (long long)up.tv_sec * 1000 + up.tv_nsec / 1000000;
+        a9_ring[a9_ring_count % A9_RING] = (typeof(a9_ring[0])){.ms = ms, .node = sq->sq_node,
+            .port = sq->sq_port, .control = -1, .message = -1};
+        strcpy(a9_ring[a9_ring_count % A9_RING].vals, "-");
+        strcpy(a9_ring[a9_ring_count % A9_RING].result, "-");
+        a9_ring_count++;
+    }
+    if (result <= 0 || sq->sq_port == QRTR_PORT_CTRL) goto done;
+    size = (size_t)result < capacity ? (size_t)result : capacity;
+    if (size < 7) goto done;
+    /* Header preview only; message_decoded distinguishes successful decoding. */
+    a9_diag.message = a9_le16(data + 3); a9_diag.qmi_type = data[0];
+    a9_ring[(a9_ring_count - 1) % A9_RING].message = a9_diag.message;
+    size_t vused = 0;
+    off = 7;
+    while (off < size && count < 16) {
+        unsigned key, length;
+        if (size - off < 3) {
+            used += (size_t)snprintf(a9_diag.tlvs + used, sizeof(a9_diag.tlvs) - used,
+                                    "%sshort-header", count ? "," : "");
+            break;
+        }
+        key = data[off]; length = a9_le16(data + off + 1); off += 3;
+        /* Each of at most 16 entries is at most 16 characters. */
+        used += (size_t)snprintf(a9_diag.tlvs + used, sizeof(a9_diag.tlvs) - used,
+                                "%s%u:%u%s", count ? "," : "", key, length,
+                                length > size - off ? "!" : "");
+        count++;
+        if (length > size - off) break;
+        /* Scalar TLV values (caller id, size, direction, force) only. */
+        if (length >= 1 && length <= 4 && vused + 24 < sizeof(a9_diag.vals)) {
+            unsigned long v = 0; unsigned k;
+            for (k = 0; k < length; k++) v |= (unsigned long)data[off + k] << (8 * k);
+            vused += (size_t)snprintf(a9_diag.vals + vused, sizeof(a9_diag.vals) - vused,
+                                      "%s%u=%lu", vused ? "," : "", key, v);
+        }
+        off += length;
+    }
+    if (vused) {
+        snprintf(a9_ring[(a9_ring_count - 1) % A9_RING].vals, sizeof(a9_ring[0].vals), "%s", a9_diag.vals);
+    }
+    if (count == 16 && off < size)
+        snprintf(a9_diag.tlvs + used, sizeof(a9_diag.tlvs) - used, ",capped");
+done:
+    errno = saved_errno;
+}
+
+static void a9_ring_dump(void)
+{
+    unsigned first = a9_ring_count > A9_RING ? a9_ring_count - A9_RING : 0, i;
+    int saved_errno = errno;
+    for (i = first; i < a9_ring_count; i++) {
+        char ring[192]; ssize_t w;
+        int m = snprintf(ring, sizeof(ring),
+            "A9_WIFI_RMTFS_RING seq=%u at=%lld.%03lld node=%u port=%u control=%d message=%d vals=%s result=%s\n",
+            i, a9_ring[i % A9_RING].ms / 1000, a9_ring[i % A9_RING].ms % 1000,
+            a9_ring[i % A9_RING].node, a9_ring[i % A9_RING].port, a9_ring[i % A9_RING].control,
+            a9_ring[i % A9_RING].message, a9_ring[i % A9_RING].vals, a9_ring[i % A9_RING].result);
+        if (m > 0 && (size_t)m < sizeof(ring))
+            do { w = write(STDERR_FILENO, ring, (size_t)m); } while (w < 0 && errno == EINTR);
+    }
+    errno = saved_errno;
+}
+
+static int a9_negative(const char *reason, int result)
+{
+    struct timespec up;
+    char line[1024];
+    int n, saved_errno = errno;
+    if (a9_diag.logged) return result;
+    a9_diag.logged = 1;
+    a9_ring_result(reason);
+    if (clock_gettime(CLOCK_BOOTTIME, &up)) { up.tv_sec = -1; up.tv_nsec = 0; }
+    n = snprintf(line, sizeof(line),
+        "A9_WIFI_RMTFS_DIAG uptime=%lld.%03ld reason=%s rc=%d received=%d recv=%d recv_errno=%d "
+        "sockaddr_len=%u address_valid=%d family=%u node=%u port=%u control=%d "
+        "message=%d message_decoded=%d qmi_type=%d tlvs=%s vals=%s\n",
+        (long long)up.tv_sec, up.tv_nsec / 1000000, reason, result,
+        a9_diag.received, a9_diag.recv_result, a9_diag.recv_errno,
+        a9_diag.address_len, a9_diag.address_valid, a9_diag.family, a9_diag.node, a9_diag.port,
+        a9_diag.control, a9_diag.message, a9_diag.message_decoded, a9_diag.qmi_type,
+        a9_diag.received ? a9_diag.tlvs : "-", a9_diag.received ? a9_diag.vals : "-");
+    if (n > 0 && (size_t)n < sizeof(line)) {
+        ssize_t written;
+        /* One bounded pipe record; logging errors never change trial decisions. */
+        do { written = write(STDERR_FILENO, line, (size_t)n); } while (written < 0 && errno == EINTR);
+    }
+    a9_ring_dump();
+    errno = saved_errno;
+    return result;
+}
+
+/* Observe-only notes (never faults, never change a decision): bounded count,
+ * one pipe record each, metadata only. CLOCK_BOOTTIME shares the controller's
+ * /proc/uptime base. */
+static int a9_boot_ms(long long *ms)
+{
+    struct timespec up;
+    if (clock_gettime(CLOCK_BOOTTIME, &up)) return -1;
+    *ms = (long long)up.tv_sec * 1000 + up.tv_nsec / 1000000;
+    return 0;
+}
+static unsigned a9_note_count;
+static void a9_note(const char *text)
+{
+    char line[256];
+    long long ms = -1;
+    int n, saved_errno = errno;
+    if (a9_note_count >= 32) return;
+    a9_note_count++;
+    if (a9_boot_ms(&ms)) ms = -1;
+    n = snprintf(line, sizeof(line), "A9_WIFI_RMTFS_NOTE uptime=%lld.%03lld %s\n",
+                 ms / 1000, ms < 0 ? 0 : ms % 1000, text);
+    if (n > 0 && (size_t)n < sizeof(line)) {
+        ssize_t written;
+        do { written = write(STDERR_FILENO, line, (size_t)n); } while (written < 0 && errno == EINTR);
+    }
+    errno = saved_errno;
+}
