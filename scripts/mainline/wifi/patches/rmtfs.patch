+struct a9_sha { uint32_t h[8]; uint64_t bytes; unsigned used; unsigned char b[64]; };
+static uint32_t a9_rotr(uint32_t x, unsigned n) { return (x >> n) | (x << (32-n)); }
+static void a9_sha_block(struct a9_sha *s, const unsigned char *p)
