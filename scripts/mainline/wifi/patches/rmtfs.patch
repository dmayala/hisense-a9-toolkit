+/* Strict wire checks before libqrtr's generic QMI decoder sees untrusted bytes. */
+#ifndef A9_WIRE_H
+#define A9_WIRE_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include "a9-safe.h"
+static uint16_t a9_le16(const unsigned char *p) { return p[0] | ((uint16_t)p[1] << 8); }
+static uint32_t a9_le32(const unsigned char *p)
+{
+	return p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+static const char *a9_wire_reason(const void *data, size_t size)
+{
+	const unsigned char *p = data, *v;
+	size_t off = 7, n, i;
+	unsigned msg, key, seen = 0, required;
+	uint64_t total = 0;
+	if (!p || size < 7) return "wire-short-header";
+	if (p[0] != 0) return "wire-type";
+	if (a9_le16(p + 5) != size - 7) return "wire-length";
+	msg = a9_le16(p + 3);
+	switch (msg) {
+	case 1: case 2: case 5: required = 2; break;
+	case 3: required = 30; break;
+	case 4: required = 6; break;
+	default: return "wire-message";
+	}
+	while (off < size) {
+		if (size - off < 3) return "wire-tlv-header";
+		key = p[off]; n = a9_le16(p + off + 1); off += 3;
+		if (n > size - off) return "wire-tlv-length";
+		if (key < 1 || key > 4 || !(required & (1u << key))) return "wire-tlv-type";
+		if (seen & (1u << key)) return "wire-tlv-duplicate";
+		seen |= 1u << key; v = p + off;
+		if (msg == 1) {
+			if (!n || n >= 256) return "wire-open-length";
+			if (memchr(v, 0, n)) return "wire-open-nul";
+		} else if (msg == 3 && key == 3) {
+			if (!n || !v[0] || n != 1 + (size_t)v[0] * 12) return "wire-vector-length";
+			for (i = 0; i < v[0]; i++) {
+				const unsigned char *e = v + 1 + 12 * i;
+				uint64_t sector = a9_le32(e), phys = a9_le32(e + 4), count = a9_le32(e + 8);
+				if (!count || sector > A9_IMAGE_SIZE / 512 || count > A9_IMAGE_SIZE / 512 - sector ||
+				    phys < A9_MEM_BASE || phys - A9_MEM_BASE > A9_MEM_SIZE ||
+				    count * 512 > A9_MEM_SIZE - (phys - A9_MEM_BASE)) return "wire-vector-range";
+				total += count;
+				if (total > A9_IMAGE_SIZE / 512) return "wire-vector-total";
+			}
+		} else if (msg == 3 && (key == 2 || key == 4)) {
+			if (n != 1 || v[0] > 1) return "wire-boolean";
+		} else {
+			if (n != 4) return "wire-scalar-length";
+			if (msg == 4 && key == 2 && (!a9_le32(v) || a9_le32(v) > A9_MEM_SIZE)) return "wire-alloc-size";
+		}
+		off += n;
+	}
+	return seen == required ? NULL : "wire-tlv-missing";
+}
+static inline int a9_wire_valid(const void *data, size_t size)
+{
+	return a9_wire_reason(data, size) == NULL;
+}
