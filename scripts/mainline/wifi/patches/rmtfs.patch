+/* RAM-only A9 backend. This file never opens any filesystem path. */
+#include <sys/stat.h>
+#include <sys/statfs.h>
+#include <sys/types.h>
+#include <linux/magic.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <unistd.h>
+#include "rmtfs.h"
+#include "a9-safe.h"
+
+#define MAX_CALLERS 10
+struct rmtfd { unsigned id, node, port; int image; bool active; };
+static struct rmtfd handles[MAX_CALLERS];
+static bool initialized;
+static const int image_fds[] = {10, 11, 12, A9_FSC_FD};
+static const uint64_t image_sizes[] = {A9_IMAGE_SIZE, A9_IMAGE_SIZE, A9_IMAGE_SIZE, A9_FSC_SIZE};
+static const char *const paths[] = {
+	"/boot/modem_fs1", "/boot/modem_fs2", "/boot/modem_fsg", "/boot/modem_fsc"
+};
+
+int storage_init(const char *root, bool ro, bool partitions)
+{
+	struct stat st[4];
+	struct statfs fs;
+	int i, j, flags;
+	initialized = false;
+	memset(handles, 0, sizeof(handles));
+	if (root || ro || partitions) { errno = EINVAL; return -1; }
+	for (i = 0; i < 4; i++) {
+		int fd = image_fds[i];
+		if (fstat(fd, &st[i]) || fstatfs(fd, &fs)) return -1;
+		flags = fcntl(fd, F_GETFL);
+		if (!S_ISREG(st[i].st_mode) || st[i].st_size != image_sizes[i] ||
+		    fs.f_type != TMPFS_MAGIC || flags < 0 ||
+		    (flags & O_ACCMODE) != O_RDWR || (flags & O_APPEND)) {
+			errno = EINVAL; return -1;
+		}
+		for (j = 0; j < i; j++)
+			if (st[j].st_dev == st[i].st_dev && st[j].st_ino == st[i].st_ino) {
+				errno = EINVAL; return -1;
+			}
+	}
+	for (i = 0; i < MAX_CALLERS; i++) handles[i].id = i;
+	initialized = true;
+	return 0;
+}
+
+struct rmtfd *storage_open_peer(unsigned node, unsigned port, const char *path, const char *suffix)
+{
+	int image, i;
+	if (!initialized || !path || (suffix && suffix[0])) return NULL;
+	/* Caller must pass a bounded, terminated string (wire validator enforces it). */
+	if (strnlen(path, 256) >= 256) return NULL;
+	for (image = 0; image < 4; image++) if (!strcmp(path, paths[image])) break;
+	if (image == 4) return NULL;
+	for (i = 0; i < MAX_CALLERS; i++)
+		if (handles[i].active && handles[i].node == node && handles[i].port == port && handles[i].image == image)
+			return &handles[i];
+	for (i = 0; i < MAX_CALLERS; i++) if (!handles[i].active) {
+		handles[i].active = true; handles[i].node = node; handles[i].port = port; handles[i].image = image;
+		return &handles[i];
+	}
+	return NULL;
+}
+
+static bool valid(const struct rmtfd *h)
+{
+	int i;
+	if (!initialized) return false;
+	for (i = 0; i < MAX_CALLERS; i++)
+		if (h == &handles[i]) return h->active && h->image >= 0 && h->image < 4;
+	return false;
+}
+
+void storage_close(struct rmtfd *h) { if (valid(h)) h->active = false; }
+struct rmtfd *storage_get_peer(unsigned node, unsigned port, int id)
+{
+	if (!initialized || id < 0 || id >= MAX_CALLERS || !handles[id].active ||
+	    (handles[id].node != node || handles[id].port != port)) return NULL;
+	return &handles[id];
+}
+int storage_get_caller_id(const struct rmtfd *h) { return valid(h) ? (int)h->id : -1; }
+int storage_get_error(const struct rmtfd *h) { return valid(h) ? 0 : EINVAL; }
+void storage_exit(void) { initialized = false; memset(handles, 0, sizeof(handles)); }
+
+int storage_validate_range(const struct rmtfd *h, size_t n, off_t offset)
+{
+	if (!valid(h) || offset < 0 || (uint64_t)offset > image_sizes[h->image] ||
+	    n > image_sizes[h->image] - (uint64_t)offset) { errno = EINVAL; return -1; }
+	return 0;
+}
+
+ssize_t storage_pread(const struct rmtfd *h, void *buf, size_t n, off_t off)
+{
+	ssize_t ret;
+	if (storage_validate_range(h, n, off)) return -1;
+	do { ret = pread(image_fds[h->image], buf, n, off); } while (ret < 0 && errno == EINTR);
+	/* Never hide short reads or an invalid/externally resized descriptor. */
+	if (ret >= 0 && (size_t)ret != n) { errno = EIO; return -1; }
+	return ret;
+}
+ssize_t storage_pwrite(struct rmtfd *h, const void *buf, size_t n, off_t off)
+{
+	ssize_t ret;
+	if (storage_validate_range(h, n, off)) return -1;
+	do { ret = pwrite(image_fds[h->image], buf, n, off); } while (ret < 0 && errno == EINTR);
+	if (ret >= 0 && (size_t)ret != n) { errno = EIO; return -1; }
+	return ret;
+}
+int storage_sync(struct rmtfd *h)
+{
+	if (!valid(h)) { errno = EINVAL; return -1; }
+	return fdatasync(image_fds[h->image]);
+}
