+static int a9_decode_domain(struct servreg_loc_get_domain_list_req *req,
+                           unsigned *txn, const struct qrtr_packet *pkt)
+{
+    const unsigned char *p=pkt->data;
+    size_t at=7; unsigned seen=0;
+    if (!p || pkt->data_len<7 || p[0]!=0 ||
+        (unsigned)(p[3]|p[4]<<8)!=SERVREG_LOC_GET_DOMAIN_LIST ||
+        (size_t)(p[5]|p[6]<<8)!=pkt->data_len-7) return -EINVAL;
+    *txn=p[1]|p[2]<<8;
+    while(at<pkt->data_len) {
+        if(pkt->data_len-at<3)return -EINVAL;
+        unsigned t=p[at], n=p[at+1]|p[at+2]<<8; at+=3;
+        if(n>pkt->data_len-at)return -EINVAL;
+        if(t==1) {
+            if((seen&1)||!n||n>=sizeof(req->name)||memchr(p+at,0,n))return -EINVAL;
+            memcpy(req->name,p+at,n);req->name[n]=0;req->name_len=n;seen|=1;
+        } else if(t==16) {
+            if((seen&2)||n!=4)return -EINVAL;
+            req->offset_valid=true;
+            req->offset=(uint32_t)p[at]|(uint32_t)p[at+1]<<8|(uint32_t)p[at+2]<<16|(uint32_t)p[at+3]<<24;
+            seen|=2;
+        } else return -EINVAL;
+        at+=n;
+    }
+    return seen&1 ? 0 : -EINVAL;
+}
