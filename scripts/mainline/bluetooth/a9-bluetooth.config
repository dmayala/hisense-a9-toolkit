# Opt-in only: merge AFTER a9.config + a9-android.config with A9_BLUETOOTH=1.
# Modules keep BT off until the gated Android startup deliberately loads them.
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_RFKILL=y
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_QCA=m
# Android's userspace stack owns these protocols through HCI_CHANNEL_USER.
# CONFIG_BT_RFCOMM is not set
# CONFIG_BT_BNEP is not set
# CONFIG_BT_HIDP is not set
# CONFIG_BT_6LOWPAN is not set
# CONFIG_BT_DEBUGFS is not set
# CONFIG_BT_SELFTEST is not set
# CONFIG_BT_HCIBTUSB is not set
# CONFIG_BT_HCIVHCI is not set
# CONFIG_BT_HCIUART_BCM is not set
# CONFIG_BT_HCIUART_INTEL is not set
# CONFIG_BT_HCIUART_RTL is not set
# CONFIG_BT_HCIUART_LL is not set
# CONFIG_BT_HCIUART_ATH3K is not set
# CONFIG_BT_HCIUART_BCSP is not set
# CONFIG_BT_HCIUART_3WIRE is not set
# CONFIG_BT_HCIUART_AML is not set
# CONFIG_BT_HCIUART_MRVL is not set
